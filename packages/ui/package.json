{
  "name": "@teamup/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Tokens et composants partagés entre la vitrine et l'app.",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    "./styles.css": "./src/styles/index.css",
    "./react": "./src/react/index.ts",
    "./astro/*": "./src/astro/*",
    "./fonts-tamil.css": "./src/styles/fonts-tamil.css",
    "./site-motion.css": "./src/styles/site-motion.css"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/noto-sans-tamil": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@teamup/brand": "workspace:*"
  },
  "peerDependencies": {
    "astro": "^7.0.0",
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "astro": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "typescript": "5.9.3"
  }
}
