# Adresse de l'app de jeu (lien « Espace animateur », page Rejoindre). À défaut : https://app.teamup.fr
PUBLIC_APP_URL=
# Copier en .env (jamais versionné). Sans clé, les e-mails de devis s'affichent dans la console.
RESEND_API_KEY=
# Adresse qui reçoit les demandes de devis.
DEVIS_DESTINATAIRE=
# Expéditeur sur un domaine vérifié chez Resend, ex. Team Up! <devis@teamup.fr>
DEVIS_EXPEDITEUR=
