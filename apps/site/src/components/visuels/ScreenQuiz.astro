---
import ScreenFrame from './ScreenFrame.astro';

type Props = { class?: string };
const { class: className } = Astro.props;

const answers = [
  { key: 'A', label: '6' },
  { key: 'B', label: '8' },
  { key: 'C', label: '10' },
  { key: 'D', label: '12' },
];
---

<ScreenFrame
  label="Quiz · question 2 / 4"
  caption="Illustration : l'écran de la salle affiche une question de quiz et ses quatre réponses, disposées comme les quatre zones tracées au sol."
  class={className}
>
  <span slot="meta" class="quiz__timer">
    00:24
  </span>
  <p class="quiz__question">Combien de pattes a une araignée ?</p>
  <div class="quiz__grid">
    {answers.map((answer) => (
      <div class="quiz__answer">
        <span class="quiz__key">{answer.key}</span>
        <span class="quiz__label">{answer.label}</span>
      </div>
    ))}
  </div>
</ScreenFrame>

<style>
  .quiz__timer {
    font-family: var(--tu-font-numeric);
    font-size: var(--tu-screen-type-xl);
    font-weight: 700;
    line-height: 1;
    color: var(--tu-primary);
  }

  .quiz__question {
    font-family: var(--tu-font-display);
    font-size: var(--tu-screen-type-lg);
    font-weight: 600;
    line-height: 1.2;
  }

  .quiz__grid {
    flex: 1;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--tu-space-3);
  }

  .quiz__answer {
    display: flex;
    align-items: center;
    gap: var(--tu-space-3);
    min-height: var(--tu-space-14);
    padding: var(--tu-space-2) var(--tu-space-4);
    border: var(--tu-border-width) solid var(--tu-border);
    border-radius: var(--tu-radius-md);
    background: var(--tu-surface);
  }

  .quiz__key {
    font-family: var(--tu-font-display);
    font-size: var(--tu-screen-type-lg);
    font-weight: 700;
    color: var(--tu-primary);
  }

  .quiz__label {
    font-size: var(--tu-screen-type-md);
  }
</style>
