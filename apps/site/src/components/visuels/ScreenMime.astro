---
import ScreenFrame from './ScreenFrame.astro';

type Props = { class?: string };
const { class: className } = Astro.props;
---

<ScreenFrame
  label="Écran de la salle · Mime"
  meta="Équipe 4"
  caption="Illustration : l'écran révèle le mot « Parapluie » sur fond vert, l'équipe 4 l'a trouvé et marque 100 points."
  class={className}
>
  <div class="mime">
    <span class="mime__verdict">Trouvé !</span>
    <span class="mime__word">Parapluie</span>
    <span class="mime__score">+100 pour l'équipe 4</span>
  </div>
</ScreenFrame>

<style>
  .mime {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--tu-space-2);
    padding: var(--tu-space-8) var(--tu-space-6);
    border-radius: var(--tu-radius-md);
    /* Le vert vif du thème stage, pas sa déclinaison sombre : 8,16:1 contre 3,85:1,
             et une révélation qui se voit du fond de la salle. */
    background: var(--tu-primary);
    color: var(--tu-on-primary);
    text-align: center;
  }

  .mime__verdict {
    font-family: var(--tu-font-display);
    font-size: var(--tu-size-lg);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .mime__word {
    font-family: var(--tu-font-display);
    font-size: var(--tu-size-3xl);
    font-weight: 700;
    line-height: var(--tu-leading-tight);
  }

  .mime__score {
    font-size: var(--tu-size-sm);
  }
</style>
