---
import ScreenFrame from './ScreenFrame.astro';

type Props = { class?: string };
const { class: className } = Astro.props;
---

<ScreenFrame
  label="Écran de la salle · Mime"
  meta="Équipe 4"
  metaPill="amber"
  caption="Illustration : l'écran révèle le mot « Parapluie » sur fond vert, l'équipe 4 l'a trouvé et marque 100 points."
  class={className}
>
  <div class="mime">
    <span class="mime__verdict">Trouvé !</span>
    <span class="mime__word">Parapluie</span>
    <span class="mime__score">+100 pour l'équipe 4</span>
  </div>
</ScreenFrame>

<style>
  .mime {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--tu-space-3);
    padding: var(--tu-space-6);
    border-radius: 1.125rem;
    /* Le vert vif du thème stage, pas sa déclinaison sombre de la maquette : 8,16:1
               contre 3,85:1, et une révélation qui se voit du fond de la salle. */
    background: var(--tu-primary);
    color: var(--tu-on-primary);
    text-align: center;
  }

  .mime__verdict {
    font-family: var(--tu-font-display);
    font-size: var(--tu-size-lg);
    font-weight: 600;
  }

  .mime__word {
    font-family: var(--tu-font-display);
    font-size: var(--tu-screen-type-xxl);
    font-weight: 700;
    line-height: 1;
  }

  .mime__score {
    font-size: var(--tu-size-base);
  }
</style>
