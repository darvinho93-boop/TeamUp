---
/**
 * Le cadre « téléphone d'un invité ». Même principe que ScreenFrame : illustration
 * masquée aux lecteurs d'écran, légende explicite.
 *
 * Dessiné à la taille des maquettes desktop ; en mobile, il est réduit d'un bloc
 * (--tu-visual-phone-zoom), comme les maquettes mobiles le font.
 */
type Props = {
  /** Barre du haut : prénom, rôle… tel qu'il apparaît dans l'app. */
  label: string;
  meta?: string | undefined;
  caption: string;
  class?: string | undefined;
};

const { label, meta, caption, class: className } = Astro.props;
---

<figure class:list={['phone-figure', className]}>
  <div class="phone" aria-hidden="true">
    <div class="phone__bar">
      <span>{label}</span>
      {meta && <span>{meta}</span>}
    </div>
    <div class="phone__body">
      <slot />
    </div>
  </div>
  <figcaption class="tu-visually-hidden">{caption}</figcaption>
</figure>

<style>
  .phone-figure {
    margin: 0;
    min-width: 0;
    zoom: var(--tu-visual-phone-zoom);
  }

  .phone {
    display: flex;
    flex-direction: column;
    gap: var(--tu-space-4);
    width: var(--tu-visual-phone-width);
    aspect-ratio: 236 / 468;
    padding: var(--tu-space-9) var(--tu-space-4) var(--tu-space-5);
    border: var(--tu-device-bezel) solid var(--tu-navy-900);
    border-radius: var(--tu-radius-device);
    background: var(--tu-bg);
    box-shadow: var(--tu-shadow-lift);
    overflow: hidden;
  }

  .phone__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--tu-space-3);
    font-size: var(--tu-size-xs);
    color: var(--tu-text-muted);
  }

  .phone__body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--tu-space-4);
  }
</style>
