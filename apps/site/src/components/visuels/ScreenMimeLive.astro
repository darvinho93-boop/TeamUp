---
import ScreenFrame from './ScreenFrame.astro';

type Props = { class?: string };
const { class: className } = Astro.props;

const scores = [
  { label: 'É1', value: '420', teamClass: 'tu-team--1' },
  { label: 'É2', value: '385', teamClass: 'tu-team--2' },
  { label: 'É3', value: '310', teamClass: 'tu-team--3' },
  { label: 'É4', value: '290', teamClass: 'tu-team--4' },
];
---

<ScreenFrame
  label="Mime · Équipe 2"
  caption="Illustration : pendant un passage de Mime, l'écran affiche le chrono et les scores des quatre équipes."
  class={className}
>
  <span class="live__timer">01:52</span>
  <div class="live__scores">
    {scores.map((score) => (
      <span class={`live__score ${score.teamClass}`}>
        {score.label}
        <span class="live__value"> · {score.value}</span>
      </span>
    ))}
  </div>
</ScreenFrame>

<style>
  .live__timer {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--tu-font-numeric);
    font-size: var(--tu-screen-type-live);
    font-weight: 700;
    line-height: 1;
    color: var(--tu-primary);
  }

  .live__scores {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--tu-space-2);
  }

  .live__score {
    padding: var(--tu-space-1) var(--tu-space-3);
    border-radius: var(--tu-radius-pill);
    background: var(--tu-team-color);
    color: var(--tu-team-on);
    font-size: 0.6875rem;
    font-weight: 600;
  }

  /* L'équipe navy se confondrait avec le fond marine : sa pastille passe au bleu vif. */
  .live__score.tu-team--1 {
    --tu-team-color: var(--tu-navy-500);
    --tu-team-on: var(--tu-text);
  }

  @media (max-width: 60rem) {
    .live__value {
      display: none;
    }
  }
</style>
