---
import PhoneFrame from './PhoneFrame.astro';

type Props = { class?: string };
const { class: className } = Astro.props;

/** Le tamoul doit être rendu en Noto Sans Tamil : `lang` déclenche la bonne pile. */
const languages = [
  { label: 'Français', lang: 'fr', selected: true },
  { label: 'தமிழ்', lang: 'ta', selected: false },
  { label: 'English', lang: 'en', selected: false },
];
---

<PhoneFrame
  label="Choisis ta langue"
  caption="Illustration : en rejoignant la partie, chaque invité choisit sa langue entre le français, le tamoul et l'anglais."
  class={className}
>
  <ul class="lang__list">
    {languages.map((language) => (
      <li
        class:list={['lang__item', language.selected && 'lang__item--selected']}
        lang={language.lang}
      >
        {language.label}
      </li>
    ))}
  </ul>
  <span class="lang__button">Continuer</span>
</PhoneFrame>

<style>
  .lang__list {
    display: flex;
    flex-direction: column;
    gap: var(--tu-space-3);
  }

  .lang__item {
    display: flex;
    align-items: center;
    min-height: var(--tu-tap-min);
    padding-inline: var(--tu-space-4);
    border: var(--tu-border-width) solid var(--tu-border);
    border-radius: var(--tu-radius-md);
    background: var(--tu-surface);
    font-family: var(--tu-font-display);
    font-weight: 600;
  }

  .lang__item--selected {
    border-color: var(--tu-primary);
    background: var(--tu-navy-50);
  }

  .lang__item:lang(ta) {
    font-family: var(--tu-font-tamil);
  }

  .lang__button {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: var(--tu-tap-min);
    border-radius: var(--tu-radius-pill);
    background: var(--tu-primary);
    color: var(--tu-on-primary);
    font-family: var(--tu-font-display);
    font-weight: 600;
  }
</style>
