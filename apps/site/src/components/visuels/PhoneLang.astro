---
import PhoneFrame from './PhoneFrame.astro';

type Props = { class?: string };
const { class: className } = Astro.props;

/** La vitrine ne met en avant aucune langue de niche : l'app, elle, en propose davantage. */
const languages = [
  { label: 'Français', lang: 'fr', selected: true },
  { label: 'English', lang: 'en', selected: false },
];
---

<PhoneFrame
  size="wide"
  caption="Illustration : en rejoignant la partie, chaque invité choisit sa langue, ici le français ou l'anglais."
  class={className}
>
  <p class="lang__title">Choisis ta langue</p>
  <ul class="lang__list">
    {languages.map((language) => (
      <li
        class:list={['lang__item', language.selected && 'lang__item--selected']}
        lang={language.lang}
      >
        {language.label}
      </li>
    ))}
  </ul>
  <span class="lang__button">Continuer</span>
</PhoneFrame>

<style>
  .lang__title {
    margin-bottom: var(--tu-space-2);
    font-family: var(--tu-font-display);
    font-size: 1.375rem;
    font-weight: 700;
    line-height: 1.2;
  }

  .lang__list {
    display: flex;
    flex-direction: column;
    gap: var(--tu-space-3);
  }

  .lang__item {
    display: flex;
    align-items: center;
    min-height: var(--tu-btn-cta-height);
    padding-inline: 1.125rem;
    border: var(--tu-btn-border-width) solid var(--tu-border);
    border-radius: var(--tu-radius-md);
    background: var(--tu-surface);
    font-family: var(--tu-font-display);
    font-size: var(--tu-type-body-lg);
    font-weight: 600;
  }

  .lang__item--selected {
    border-color: var(--tu-primary);
  }

  .lang__button {
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: auto;
    min-height: var(--tu-tap-min);
    border-radius: var(--tu-radius-pill);
    background: var(--tu-primary);
    color: var(--tu-on-primary);
    font-family: var(--tu-font-display);
    font-weight: 600;
  }
</style>
