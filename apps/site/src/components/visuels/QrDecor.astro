---
/**
 * Motif de QR repris tel quel de la maquette d'accueil (grille 21 x 21), dans son
 * ordre de tracé d'origine : les carrés clairs des repères se superposent aux sombres.
 * C'est une illustration : il n'encode rien et ne se scanne pas. Le vrai QR est
 * généré par l'écran commun, dans l'app.
 */
type Props = {
  class?: string;
};

const { class: className } = Astro.props;
---

