---
/**
 * Le cadre « Écran de la salle ». Illustration du produit, pas une capture réelle :
 * son contenu est masqué aux lecteurs d'écran, une légende dit ce qu'on y voit.
 * La vitrine n'a aucune photo d'événement — ces visuels sont ce qui montre le jeu.
 */
type Props = {
  label: string;
  /** Mention à droite du libellé. Le slot `meta` la remplace (chrono, pastille…). */
  meta?: string | undefined;
  /** La mention devient une pastille de couleur (équipe qui joue, adjugé…). */
  metaPill?: 'sage' | 'coral' | 'amber' | 'navy' | undefined;
  caption: string;
  /** Le bloc marine sans ombre, posé à plat dans une carte (portes de l'accueil). */
  flat?: boolean;
  class?: string | undefined;
};

const { label, meta, metaPill, caption, flat = false, class: className } = Astro.props;
const hasMetaSlot = Astro.slots.has('meta');
---

<figure class:list={['screen-figure', className]}>
  <div class:list={['screen', flat && 'screen--flat']} data-theme="stage" aria-hidden="true">
    <div class="screen__bar">
      <span class="screen__label">{label}</span>
      {hasMetaSlot ? (
        <slot name="meta" />
      ) : (
        meta && (
          <span class:list={['screen__meta', metaPill && `screen__pill screen__pill--${metaPill}`]}>
            {meta}
          </span>
        )
      )}
    </div>
    <div class="screen__body">
      <slot />
    </div>
  </div>
  <figcaption class="tu-visually-hidden">{caption}</figcaption>
</figure>

<style>
  .screen-figure {
    display: flex;
    flex-direction: column;
    margin: 0;
    min-width: 0;
  }

  .screen {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--tu-screen-gap);
    padding: var(--tu-screen-pad);
    border-radius: var(--tu-screen-radius);
    background: var(--tu-bg);
    color: var(--tu-text);
    box-shadow: var(--tu-shadow-lift);
  }

  .screen--flat {
    border-radius: 0;
    box-shadow: none;
  }

  .screen__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--tu-space-4);
    font-size: var(--tu-type-caption);
    color: var(--tu-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .screen__meta {
    color: var(--tu-primary);
    font-weight: 600;
  }

  .screen__pill {
    flex: none;
    padding: var(--tu-space-1) var(--tu-space-3);
    border-radius: var(--tu-radius-pill);
    font-size: var(--tu-size-xs);
    text-transform: none;
    letter-spacing: normal;
    color: var(--tu-navy-900);
  }

  .screen__pill--sage {
    background: var(--tu-sage-500);
  }

  .screen__pill--coral {
    background: var(--tu-team-2);
  }

  .screen__pill--amber {
    background: var(--tu-team-4);
  }

  .screen__pill--navy {
    background: var(--tu-navy-500);
    color: var(--tu-text);
  }

  .screen__body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--tu-screen-gap);
  }
</style>
