---
/**
 * Le cadre « Écran de la salle ». Illustration du produit, pas une capture réelle :
 * son contenu est masqué aux lecteurs d'écran, une légende dit ce qu'on y voit.
 * La vitrine n'a aucune photo d'événement — ces visuels sont ce qui montre le jeu.
 */
type Props = {
  label: string;
  meta?: string | undefined;
  caption: string;
  class?: string | undefined;
};

const { label, meta, caption, class: className } = Astro.props;
---

<figure class:list={['screen-figure', className]}>
  <div class="screen" data-theme="stage" aria-hidden="true">
    <div class="screen__bar">
      <span class="screen__label">{label}</span>
      {meta && <span class="screen__meta">{meta}</span>}
    </div>
    <div class="screen__body">
      <slot />
    </div>
  </div>
  <figcaption class="tu-visually-hidden">{caption}</figcaption>
</figure>

<style>
  .screen-figure {
    margin: 0;
    min-width: 0;
  }

  .screen {
    display: flex;
    flex-direction: column;
    border-radius: var(--tu-radius-lg);
    background: var(--tu-bg);
    color: var(--tu-text);
    box-shadow: var(--tu-shadow-lift);
    overflow: hidden;
  }

  .screen__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--tu-space-4);
    padding: var(--tu-space-3) var(--tu-space-4);
    background: var(--tu-surface);
    border-bottom: var(--tu-border-width) solid var(--tu-border);
    font-size: var(--tu-size-xs);
    color: var(--tu-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .screen__meta {
    color: var(--tu-primary);
    font-weight: 600;
  }

  .screen__body {
    display: flex;
    flex-direction: column;
    gap: var(--tu-space-4);
    padding: var(--tu-space-6);
  }
</style>
