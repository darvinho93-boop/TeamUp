---
import PhoneFrame from './PhoneFrame.astro';
import Icon from '../Icon.astro';

type Props = { class?: string };
const { class: className } = Astro.props;
---

<PhoneFrame
  label="Mime · Équipe 3"
  meta="FR"
  caption="Illustration : seul le premier joueur de la file reçoit le mot à mimer, masqué derrière un appui long."
  size="sm"
  class={className}
>
  <p class="secret__brief">Toi seul vois ce mot. Mime-le à Kavin.</p>
  <div class="secret__mask" data-theme="stage">
    <Icon name="eye" size="lg" />
    <span class="secret__hold">Maintiens pour voir le mot</span>
  </div>
</PhoneFrame>

<style>
  .secret__brief {
    font-family: var(--tu-font-display);
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.25;
  }

  .secret__mask {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--tu-space-3);
    padding: var(--tu-space-3);
    border-radius: 1.125rem;
    background: var(--tu-bg);
    color: var(--tu-primary);
    text-align: center;
  }

  .secret__hold {
    font-size: var(--tu-type-caption);
    color: var(--tu-text-muted);
  }
</style>
