---
import ScreenFrame from './ScreenFrame.astro';

type Props = { class?: string };
const { class: className } = Astro.props;

const teams = [
  {
    name: 'Équipe 1',
    teamClass: 'tu-team--1',
    players: ['Léa', 'Anbu', 'Thomas', 'Meena', 'Karim'],
  },
  {
    name: 'Équipe 2',
    teamClass: 'tu-team--2',
    players: ['Priya', 'Hugo', 'Nila', 'Julie', 'Arjun'],
  },
  {
    name: 'Équipe 3',
    teamClass: 'tu-team--3',
    players: ['Chloé', 'Kavin', 'Sarah', 'Ravi', 'Paul'],
  },
  {
    name: 'Équipe 4',
    teamClass: 'tu-team--4',
    players: ['Divya', 'Lucas', 'Inès', 'Vijay', 'Emma'],
  },
];
---

<ScreenFrame
  label="Écran de la salle · Les équipes"
  meta="36 joueurs"
  caption="Illustration : l'écran de la salle affiche la composition des quatre équipes, chacune mélangeant des prénoms de familles et de cercles différents."
  class={className}
>
  <div class="teams">
    {teams.map((team) => (
      <div class="teams__card">
        <span class={`teams__name ${team.teamClass}`}>{team.name}</span>
        {team.players.map((player, index) => (
          <span class:list={['teams__player', index >= 3 && 'teams__player--extra']}>{player}</span>
        ))}
        <span class="teams__more teams__more--desktop">+ 4</span>
        <span class="teams__more teams__more--mobile">+ 6</span>
      </div>
    ))}
  </div>
</ScreenFrame>

<style>
  .teams {
    flex: 1;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--tu-space-3);
  }

  .teams__card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--tu-space-2);
    padding: var(--tu-space-3);
    border: var(--tu-border-width) solid var(--tu-border);
    border-radius: var(--tu-radius-md);
    background: var(--tu-surface);
    font-size: var(--tu-size-sm);
    line-height: 1.3;
  }

  .teams__name {
    padding: var(--tu-space-1) var(--tu-space-3);
    border-radius: var(--tu-radius-pill);
    background: var(--tu-team-color);
    color: var(--tu-team-on);
    font-size: var(--tu-size-xs);
    font-weight: 600;
  }

  /* L'équipe navy se confondrait avec le fond marine : sa pastille passe au bleu vif. */
  .teams__name.tu-team--1 {
    --tu-team-color: var(--tu-navy-500);
    --tu-team-on: var(--tu-text);
  }

  .teams__more {
    color: var(--tu-text-muted);
  }

  .teams__more--mobile {
    display: none;
  }

  /* Mobile : deux colonnes, trois prénoms par équipe, comme la maquette. */
  @media (max-width: 60rem) {
    .teams {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--tu-space-2);
    }

    .teams__card {
      padding: var(--tu-space-3);
    }

    .teams__player--extra {
      display: none;
    }

    .teams__name {
      align-self: stretch;
    }

    .teams__more--desktop {
      display: none;
    }

    .teams__more--mobile {
      display: inline;
    }
  }
</style>
