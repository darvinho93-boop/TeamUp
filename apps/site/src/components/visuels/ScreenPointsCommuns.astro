---
import ScreenFrame from './ScreenFrame.astro';

type Props = {
  /** `jeu` : le chrono tourne. `consigne` : le point commun est montré à la salle. */
  variant?: 'jeu' | 'consigne';
  class?: string;
};

const { variant = 'jeu', class: className } = Astro.props;

/** En mobile, seul le multiplicateur reste, comme dans la maquette. */
const tiers =
  variant === 'consigne'
    ? [
        { prefix: 'Palier 1 · 60 s · ', factor: '×3' },
        { prefix: 'Palier 2 · 35 s · ', factor: '×2' },
        { prefix: 'Palier 3 · 35 s · ', factor: '×1' },
      ]
    : [
        { prefix: 'Palier 1 · ', factor: '×3' },
        { prefix: 'Palier 2 · ', factor: '×2' },
        { prefix: 'Palier 3 · ', factor: '×1' },
      ];
---

<ScreenFrame
  label="Écran de la salle · Points communs"
  meta={variant === 'consigne' ? 'Équipe 1 : yeux fermés' : 'Équipe 2 joue'}
  metaPill={variant === 'consigne' ? 'navy' : 'coral'}
  caption={
    variant === 'consigne'
      ? "Illustration : l'écran montre le point commun à la salle pendant que l'équipe qui joue garde les yeux fermés."
      : 'Illustration : le chrono de Points communs affiche 48 secondes et les trois paliers de score.'
  }
  class={className}
>
  {variant === 'consigne' ? (
    <div class="pc__reveal">
      <span class="pc__hint">Le point commun, visible par la salle seulement</span>
      <span class="pc__secret">Les personnes retraitées</span>
    </div>
  ) : (
    <div class="pc__play">
      <span class="pc__timer">00:48</span>
      <span class="pc__call">Les bonnes personnes, levez-vous !</span>
    </div>
  )}
  <div class="pc__tiers">
    {tiers.map((tier) => (
      <span class="pc__tier">
        <span class="pc__tier-prefix">{tier.prefix}</span>
        {tier.factor}
      </span>
    ))}
  </div>
</ScreenFrame>

<style>
  .pc__reveal,
  .pc__play {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--tu-space-4);
    text-align: center;
  }

  .pc__hint {
    font-size: var(--tu-screen-type-sm);
    color: var(--tu-text-muted);
  }

  .pc__secret {
    font-family: var(--tu-font-display);
    font-size: var(--tu-screen-type-title);
    font-weight: 700;
    line-height: var(--tu-leading-tight);
  }

  .pc__timer {
    font-family: var(--tu-font-numeric);
    font-size: var(--tu-screen-type-giant);
    font-weight: 700;
    line-height: 1;
    color: var(--tu-primary);
  }

  .pc__call {
    font-family: var(--tu-font-display);
    font-size: var(--tu-screen-type-lg);
    font-weight: 600;
  }

  .pc__tiers {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--tu-space-2);
  }

  .pc__tier {
    padding: var(--tu-space-1) var(--tu-space-3);
    border: var(--tu-border-width) solid var(--tu-border);
    border-radius: var(--tu-radius-pill);
    background: var(--tu-surface);
    font-size: var(--tu-size-xs);
    color: var(--tu-text-muted);
  }

  .pc__tier:first-child {
    border-color: transparent;
    background: var(--tu-primary);
    color: var(--tu-on-primary);
    font-weight: 600;
  }

  @media (max-width: 60rem) {
    .pc__tier-prefix {
      display: none;
    }
  }
</style>
