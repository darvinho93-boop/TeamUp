---
import ScreenFrame from './ScreenFrame.astro';

type Props = {
  /** `jeu` : le chrono tourne. `consigne` : le point commun est montré à la salle. */
  variant?: 'jeu' | 'consigne';
  class?: string;
};

const { variant = 'jeu', class: className } = Astro.props;

const tiers =
  variant === 'consigne'
    ? ['Palier 1 · 60 s · ×3', 'Palier 2 · 35 s · ×2', 'Palier 3 · 35 s · ×1']
    : ['Palier 1 · ×3', 'Palier 2 · ×2', 'Palier 3 · ×1'];
---

<ScreenFrame
  label="Écran de la salle · Points communs"
  meta={variant === 'consigne' ? 'Équipe 1 : yeux fermés' : 'Équipe 2 joue'}
  caption={
    variant === 'consigne'
      ? "Illustration : l'écran montre le point commun à la salle pendant que l'équipe qui joue garde les yeux fermés."
      : 'Illustration : le chrono de Points communs affiche 48 secondes et les trois paliers de score.'
  }
  class={className}
>
  {variant === 'consigne' ? (
    <div class="pc__reveal">
      <span class="pc__hint">Le point commun, visible par la salle seulement</span>
      <span class="pc__secret">Les personnes retraitées</span>
    </div>
  ) : (
    <div class="pc__play">
      <span class="pc__timer">00:48</span>
      <span class="pc__call">Les bonnes personnes, levez-vous !</span>
    </div>
  )}
  <div class="pc__tiers">
    {tiers.map((tier) => (
      <span class="pc__tier">{tier}</span>
    ))}
  </div>
</ScreenFrame>

<style>
  .pc__reveal,
  .pc__play {
    display: flex;
    flex-direction: column;
    gap: var(--tu-space-2);
    padding: var(--tu-space-6);
    border-radius: var(--tu-radius-md);
    background: var(--tu-surface);
    text-align: center;
  }

  .pc__hint {
    font-size: var(--tu-size-xs);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--tu-text-muted);
  }

  .pc__secret {
    font-family: var(--tu-font-display);
    font-size: var(--tu-size-2xl);
    font-weight: 700;
  }

  .pc__timer {
    font-family: var(--tu-font-numeric);
    font-size: var(--tu-size-4xl);
    font-weight: 700;
    line-height: var(--tu-leading-tight);
    color: var(--tu-primary);
  }

  .pc__call {
    font-family: var(--tu-font-display);
    font-size: var(--tu-size-lg);
  }

  .pc__tiers {
    display: flex;
    flex-wrap: wrap;
    gap: var(--tu-space-2);
  }

  .pc__tier {
    padding: var(--tu-space-2) var(--tu-space-3);
    border-radius: var(--tu-radius-pill);
    background: var(--tu-surface-muted);
    font-size: var(--tu-size-xs);
    color: var(--tu-text-muted);
  }
</style>
