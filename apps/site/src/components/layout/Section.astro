---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'section'> & {
  /** Surtitre en petites capitales, au-dessus du titre. */
  eyebrow?: string;
  title?: string;
  lead?: string;
  /** `dark` : bloc marine arrondi, comme « Comment ça marche » sur l'accueil. */
  tone?: 'default' | 'dark';
  headingLevel?: 'h2' | 'h3';
};

const {
  eyebrow,
  title,
  lead,
  tone = 'default',
  headingLevel = 'h2',
  class: className,
  ...rest
} = Astro.props;

const Heading = headingLevel;
const hasHeader = Boolean(eyebrow ?? title ?? lead);
const hasAction = Astro.slots.has('action');
const dark = tone === 'dark';
---

<section class:list={['section', className]} {...rest}>
  <div class="tu-container">
    <div
      class:list={['section__inner', dark && 'tu-panel tu-panel--dark section__inner--dark']}
      data-theme={dark ? 'stage' : undefined}
    >
      {hasHeader && (
        <div class="section__head">
          <header class="section__header">
            {eyebrow && <p class="tu-eyebrow">{eyebrow}</p>}
            {title && <Heading class="tu-title">{title}</Heading>}
            {lead && <p class="tu-body-lg section__lead">{lead}</p>}
          </header>
          {hasAction && (
            <div class="section__action">
              <slot name="action" />
            </div>
          )}
        </div>
      )}
      <slot />
      {hasAction && (
        <div class="section__action section__action--below">
          <slot name="action" />
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .section {
    padding-bottom: var(--tu-section-space);
  }

  .section__inner {
    display: flex;
    flex-direction: column;
    gap: var(--tu-space-12);
  }

  .section__inner--dark {
    gap: var(--tu-space-14);
    padding: var(--tu-space-20);
  }

  .section__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--tu-space-8);
  }

  .section__header {
    display: flex;
    flex-direction: column;
    gap: var(--tu-space-3);
    max-width: 60rem;
  }

  .section__lead {
    margin-top: var(--tu-space-2);
  }

  .section__action {
    flex: none;
  }

  .section__action--below {
    display: none;
  }

  @media (max-width: 60rem) {
    .section__inner {
      gap: var(--tu-space-6);
    }

    .section__inner--dark {
      gap: var(--tu-space-8);
      padding: var(--tu-space-9) var(--tu-space-6);
    }

    .section__header {
      gap: var(--tu-space-2);
    }

    /* En mobile, le lien de section passe sous le contenu, comme dans les maquettes. */
    .section__head .section__action {
      display: none;
    }

    .section__action--below {
      display: block;
    }
  }
</style>
