---
export type Step = {
  title: string;
  body?: string;
};

type Props = {
  steps: Step[];
  /** `row` : quatre étapes de front en desktop. `stack` : toujours empilées. */
  layout?: 'row' | 'stack';
  headingLevel?: 'h3' | 'h4';
};

const { steps, layout = 'row', headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
---

<ol class:list={['steps', `steps--${layout}`]}>
  {steps.map((step, index) => (
    <li class="steps__item">
      <span class="steps__number" aria-hidden="true">
        {index + 1}
      </span>
      <div class="steps__body">
        <Heading class="steps__title">{step.title}</Heading>
        {step.body && <p class="steps__text">{step.body}</p>}
      </div>
    </li>
  ))}
</ol>

<style>
  .steps {
    display: grid;
    gap: var(--tu-space-6);
  }

  .steps--row {
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
  }

  .steps__item {
    display: flex;
    gap: var(--tu-space-4);
    align-items: flex-start;
  }

  .steps__number {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--tu-space-8);
    height: var(--tu-space-8);
    border-radius: var(--tu-radius-pill);
    background: var(--tu-navy-50);
    color: var(--tu-primary);
    font-family: var(--tu-font-display);
    font-weight: 700;
  }

  .steps__body {
    display: flex;
    flex-direction: column;
    gap: var(--tu-space-2);
  }

  .steps__title {
    font-size: var(--tu-size-lg);
  }

  .steps__text {
    color: var(--tu-text-muted);
  }

  @media (max-width: 60rem) {
    .steps--row {
      grid-template-columns: minmax(0, 1fr);
    }

    .steps__title {
      font-size: var(--tu-size-base);
    }
  }
</style>
