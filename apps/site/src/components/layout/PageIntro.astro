---
type Props = {
  eyebrow?: string;
  title: string;
  lead?: string;
  /** Taille du titre : l'accueil, les pages intérieures, les formulaires, les pages légales. */
  size?: 'display' | 'page' | 'page-sm' | 'page-xs';
  /** Titre et chapeau sur une seule colonne large, sans visuel (Les jeux, Comment ça marche). */
  wide?: boolean;
};

const { eyebrow, title, lead, size = 'page', wide = false } = Astro.props;
const hasVisual = Astro.slots.has('visual');
---

<section class:list={['intro', hasVisual && 'intro--split', wide && 'intro--wide']}>
  <div class="tu-container intro__inner">
    <div class="intro__text">
      {eyebrow && <p class="tu-eyebrow">{eyebrow}</p>}
      <h1 class:list={['intro__title', `intro__title--${size}`]}>{title}</h1>
      {lead && <p class="tu-lead intro__lead">{lead}</p>}
      {Astro.slots.has('actions') && (
        <div class="intro__actions">
          <slot name="actions" />
        </div>
      )}
      <slot name="footnote" />
    </div>
    {hasVisual && (
      <div class="intro__visual">
        <slot name="visual" />
      </div>
    )}
  </div>
</section>

<style>
  .intro {
    padding-block: var(--tu-intro-space-top) var(--tu-section-space);
  }

  /* Au chargement, le texte puis le visuel entrent en cascade. */
  @media (prefers-reduced-motion: no-preference) {
    .intro__text > :global(*),
    .intro__visual {
      animation: tu-entree var(--tu-dur-reveal) var(--tu-ease) both;
      animation-delay: calc(var(--intro-rang, 0) * var(--tu-dur-cascade));
    }

    .intro__text > :global(:nth-child(2)) {
      --intro-rang: 1;
    }

    .intro__text > :global(:nth-child(3)) {
      --intro-rang: 2;
    }

    .intro__text > :global(:nth-child(4)) {
      --intro-rang: 3;
    }

    .intro__text > :global(:nth-child(n + 5)) {
      --intro-rang: 4;
    }

    .intro__visual {
      --intro-rang: 3;
    }
  }

  .intro__inner {
    display: grid;
    gap: var(--tu-space-16);
    align-items: center;
  }

  .intro--split .intro__inner {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  }

  .intro__text {
    display: flex;
    flex-direction: column;
    gap: var(--tu-space-6);
  }

  .intro__title {
    line-height: 1.08;
  }

  .intro__title--display {
    font-size: var(--tu-type-display);
  }

  .intro__title--page {
    font-size: var(--tu-type-page);
    max-width: 22ch;
  }

  .intro__title--page-sm {
    font-size: var(--tu-type-page-sm);
    max-width: 22ch;
  }

  .intro__title--page-xs {
    font-size: var(--tu-type-page-xs);
  }

  .intro__lead {
    max-width: 38rem;
  }

  .intro--wide .intro__title {
    max-width: 56.25rem;
  }

  .intro--wide .intro__lead {
    max-width: 47.5rem;
  }

  .intro__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--tu-space-4);
  }

  .intro__visual {
    min-width: 0;
  }

  @media (max-width: 60rem) {
    /* Téléphone : même premier regard que sur ordinateur, le titre puis l'image. */
    .intro--split .intro__inner {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: var(--tu-space-5);
    }

    /* Le bloc de texte s'efface : ses éléments se rangent autour du visuel, sans toucher au balisage. */
    .intro--split .intro__text {
      display: contents;
    }

    .intro--split .intro__text > :global(*) {
      order: 2;
    }

    .intro--split .intro__text > :global(.tu-eyebrow),
    .intro--split .intro__title {
      order: 0;
    }

    .intro--split .intro__visual {
      order: 1;
    }

    .intro__text {
      gap: var(--tu-space-5);
    }

    .intro__title {
      line-height: 1.1;
      max-width: none;
    }

    .intro__actions {
      gap: var(--tu-space-3);
    }

    /* Côte à côte quand ils tiennent sur la ligne, pleine largeur chacun sinon. */
    .intro__actions > :global(.tu-btn) {
      flex: 1 1 auto;
      padding-inline: var(--tu-space-4);
    }
  }
</style>
