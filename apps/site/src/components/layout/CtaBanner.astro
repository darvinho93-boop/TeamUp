---
import Button from '@teamup/ui/astro/Button.astro';

type Props = {
  title: string;
  /** Le délai de réponse est un contenu à fournir : il reste en placeholder. */
  note?: string;
  label?: string;
};

const {
  title,
  note = 'Devis gratuit, réponse sous [DÉLAI].',
  label = 'Demander un devis',
} = Astro.props;
---

<section class="cta">
  <div class="tu-container">
    <div class="cta__inner">
      <div class="cta__text">
        <h2 class="cta__title">{title}</h2>
        <p class="tu-body-lg cta__note">{note}</p>
      </div>
      <Button href="/devis" variant="accent" size="cta">
        {label}
      </Button>
    </div>
  </div>
</section>

<style>
  .cta {
    padding-bottom: var(--tu-section-space);
  }

  .cta__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--tu-space-12);
    padding: var(--tu-space-18) var(--tu-space-20);
    border-radius: var(--tu-radius-lg);
    background: var(--tu-cta-bg, var(--tu-sage-50));
  }

  .cta__text {
    display: flex;
    flex-direction: column;
    gap: var(--tu-space-3);
  }

  .cta__title {
    font-size: 2.5rem;
    line-height: 1.1;
  }

  .cta__inner > :global(.tu-btn) {
    flex: none;
    min-height: var(--tu-space-16);
    padding-inline: var(--tu-space-9);
    font-size: 1.125rem;
  }

  @media (max-width: 60rem) {
    .cta__inner {
      flex-direction: column;
      align-items: stretch;
      gap: var(--tu-space-5);
      padding: var(--tu-space-9) var(--tu-space-6);
    }

    .cta__title {
      font-size: 1.75rem;
    }

    .cta__inner > :global(.tu-btn) {
      min-height: var(--tu-tap-min);
      font-size: var(--tu-type-body-lg);
    }
  }
</style>
