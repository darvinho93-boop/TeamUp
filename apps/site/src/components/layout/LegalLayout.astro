---
import Base from '../../layouts/Base.astro';

type Props = {
  title: string;
  description: string;
  heading: string;
};

const { title, description, heading } = Astro.props;

const pages = [
  { href: '/mentions-legales', label: 'Mentions légales' },
  { href: '/confidentialite', label: 'Politique de confidentialité' },
  { href: '/cgv', label: 'CGV' },
  { href: '/cookies', label: 'Cookies' },
];

const current = Astro.url.pathname.replace(/\/$/, '');
---

<Base title={title} description={description} actionBar={false}>
  <div class="tu-container legal">
    <nav class="legal__nav" aria-label="Pages légales">
      {pages.map((page) => (
        <a
          class="legal__tab"
          href={page.href}
          aria-current={current === page.href ? 'page' : undefined}
        >
          {page.label}
        </a>
      ))}
    </nav>

    <article class="legal__article">
      <header class="legal__header">
        <h1 class="legal__title">{heading}</h1>
        <p class="legal__updated">Dernière mise à jour : [DATE]</p>
      </header>
      <slot />
    </article>
  </div>
</Base>

<style>
  .legal {
    display: grid;
    grid-template-columns: 17.5rem minmax(0, 1fr);
    gap: var(--tu-space-20);
    align-items: start;
    padding-block: var(--tu-space-18) var(--tu-section-space);
  }

  .legal__nav {
    display: flex;
    flex-direction: column;
    gap: var(--tu-space-1);
    padding: var(--tu-space-3);
    border: var(--tu-border-width) solid var(--tu-border);
    border-radius: var(--tu-space-5);
    background: var(--tu-surface);
  }

  .legal__tab {
    display: flex;
    align-items: center;
    min-height: var(--tu-space-12);
    padding-inline: var(--tu-space-4);
    border-radius: var(--tu-radius-sm);
    text-decoration: none;
  }

  .legal__tab:hover {
    background: var(--tu-surface-muted);
  }

  .legal__tab[aria-current='page'] {
    background: var(--tu-navy-50);
    font-weight: 600;
  }

  .legal__article {
    display: flex;
    flex-direction: column;
    gap: var(--tu-space-10);
    max-width: 47.5rem;
  }

  .legal__header {
    display: flex;
    flex-direction: column;
    gap: var(--tu-space-3);
  }

  .legal__title {
    font-size: var(--tu-type-page-xs);
    line-height: 1.1;
  }

  .legal__updated {
    font-size: var(--tu-btn-sm-font);
    color: var(--tu-text-muted);
  }

  /* Styles du contenu injecté par chaque page légale. */
  .legal__article :global(section) {
    display: flex;
    flex-direction: column;
    gap: var(--tu-space-3);
  }

  .legal__article :global(h2) {
    font-size: var(--tu-size-xl);
  }

  .legal__article :global(p),
  .legal__article :global(ul) {
    font-size: var(--tu-type-body-lg);
    line-height: 1.7;
  }

  .legal__article :global(ul) {
    display: flex;
    flex-direction: column;
    gap: var(--tu-space-2);
    padding-inline-start: var(--tu-space-6);
    list-style: disc;
  }

  @media (max-width: 60rem) {
    .legal {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--tu-space-8);
      padding-block: var(--tu-intro-space-top) var(--tu-section-space);
    }

    .legal__article {
      gap: var(--tu-space-8);
    }

    .legal__article :global(h2) {
      font-size: var(--tu-size-lg);
    }
  }
</style>
