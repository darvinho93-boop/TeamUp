---
import Icon from '../Icon.astro';

type IconName = 'check' | 'screen' | 'mic' | 'floor' | 'wifi';

export type IconListItem = {
  icon: IconName;
  label: string;
};

type Props = {
  title: string;
  items: IconListItem[];
};

const { title, items } = Astro.props;
---

<div class="icon-list">
  <h2 class="icon-list__title">{title}</h2>
  <ul class="icon-list__items">
    {items.map((item) => (
      <li class="icon-list__item">
        <Icon name={item.icon} size="sm" class="icon-list__icon" />
        <span>{item.label}</span>
      </li>
    ))}
  </ul>
</div>

<style>
  .icon-list {
    display: flex;
    flex-direction: column;
    gap: var(--tu-space-5);
  }

  .icon-list__title {
    font-size: 1.875rem;
  }

  .icon-list__items {
    display: flex;
    flex-direction: column;
    gap: var(--tu-space-3);
    font-size: var(--tu-type-body-lg);
    line-height: 1.5;
  }

  .icon-list__item {
    display: flex;
    align-items: flex-start;
    gap: var(--tu-space-3);
  }

  .icon-list__item :global(.icon-list__icon) {
    margin-top: 0.2em;
    color: var(--tu-success-text);
  }

  @media (max-width: 60rem) {
    .icon-list {
      gap: var(--tu-space-4);
    }

    .icon-list__title {
      font-size: 1.375rem;
    }
  }
</style>
