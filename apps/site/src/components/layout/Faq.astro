---
import Icon from '../Icon.astro';

export type FaqItem = {
  question: string;
  /** Absent = réponse à fournir : la maquette ne la rédige pas, on n'invente pas. */
  answer?: string;
};

type Props = {
  items: FaqItem[];
};

const { items } = Astro.props;
---

<div class="faq">
  {items.map((item, index) => (
    <details class="faq__item" open={index === 0}>
      <summary class="faq__question">
        <h3 class="faq__title">{item.question}</h3>
        <Icon name="chevron" size="sm" class="faq__chevron" />
      </summary>
      <div class="faq__answer">
        <p>{item.answer ?? '[RÉPONSE À FOURNIR]'}</p>
      </div>
    </details>
  ))}
</div>

<style>
  /* <details> : ouverture au clavier et lecture d'écran gérées par le navigateur,
     donc aucun script et aucun piège de focus à écrire. La première question est
     ouverte, comme dans les maquettes. */
  .faq {
    display: flex;
    flex-direction: column;
    border-bottom: var(--tu-border-width) solid var(--tu-border);
  }

  .faq__item {
    border-top: var(--tu-border-width) solid var(--tu-border);
  }

  .faq__question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--tu-space-4);
    min-height: var(--tu-tap-min);
    padding-block: var(--tu-space-5);
    cursor: pointer;
    list-style: none;
  }

  .faq__question::-webkit-details-marker {
    display: none;
  }

  .faq__title {
    font-size: var(--tu-size-lg);
    font-weight: 600;
    letter-spacing: normal;
  }

  .faq__question :global(.faq__chevron) {
    transition: transform var(--tu-dur-base) var(--tu-ease);
  }

  .faq__item[open] :global(.faq__chevron) {
    transform: rotate(180deg);
  }

  .faq__answer {
    padding-bottom: var(--tu-space-6);
    font-size: var(--tu-type-body-lg);
    color: var(--tu-text-muted);
    max-width: 62ch;
  }

  @media (max-width: 60rem) {
    .faq__question {
      padding-block: var(--tu-space-4);
    }

    .faq__title {
      font-size: var(--tu-size-base);
    }

    .faq__answer {
      margin-top: calc(-1 * var(--tu-space-2));
      padding-bottom: var(--tu-space-4);
      font-size: var(--tu-btn-sm-font);
    }
  }
</style>
