---
/**
 * Quelques paragraphes qui racontent (refonte éditoriale du 2026-11-18) : l'accueil, les pages
 * Particuliers et Entreprises. Un paragraphe peut porter la phrase forte du bloc, en gras.
 */
export type Paragraphe = string | { texte: string; fort: true };

type Props = {
  paragraphes: Paragraphe[];
};

const { paragraphes } = Astro.props;
---

<div class="recit" data-tu-apparait>
  {paragraphes.map((paragraphe) =>
    typeof paragraphe === 'string' ? (
      <p class="tu-body-lg recit__p">{paragraphe}</p>
    ) : (
      <p class="tu-body-lg recit__p recit__p--fort">{paragraphe.texte}</p>
    ),
  )}
</div>

<style>
  .recit {
    display: flex;
    flex-direction: column;
    gap: var(--tu-space-4);
    max-width: 47.5rem;
  }

  .recit__p {
    line-height: var(--tu-leading-normal);
    color: var(--tu-text-muted);
  }

  .recit__p--fort {
    font-weight: 600;
    color: var(--tu-text);
  }
</style>
