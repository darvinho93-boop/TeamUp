---
type Props = {
  id: string;
  number: string;
  title: string;
  lead: string;
  steps: string[];
  facts: { label: string; value: string }[];
  /** `visual-first` inverse l'ordre en desktop, pour alterner d'un jeu à l'autre. */
  reversed?: boolean;
};

const { id, number, title, lead, steps, facts, reversed = false } = Astro.props;
---

<section class:list={['game', reversed && 'game--reversed']} id={id}>
  <div class="tu-container game__inner">
    <div class="game__text">
      <span class="game__number" aria-hidden="true">
        {number}
      </span>
      <h2 class="game__title">{title}</h2>
      <p class="game__lead">{lead}</p>
      <ol class="game__steps">
        {steps.map((step, index) => (
          <li class="game__step">
            <span class="game__step-number" aria-hidden="true">
              {index + 1}
            </span>
            <span>{step}</span>
          </li>
        ))}
      </ol>
      <dl class="game__facts">
        {facts.map((fact) => (
          <div class="game__fact">
            <dt class="game__fact-label">{fact.label}</dt>
            <dd class="game__fact-value">{fact.value}</dd>
          </div>
        ))}
      </dl>
    </div>
    <div class="game__visual">
      <slot />
    </div>
  </div>
</section>

<style>
  .game {
    padding-bottom: var(--tu-section-space);
    scroll-margin-top: var(--tu-header-height);
  }

  .game__inner {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: center;
    gap: var(--tu-space-20);
  }

  .game--reversed .game__visual {
    order: -1;
  }

  .game__visual {
    display: flex;
    flex-direction: column;
    min-height: var(--tu-game-visual-height);
  }

  .game__visual > :global(*) {
    flex: 1;
  }

  .game__text {
    display: flex;
    flex-direction: column;
    gap: var(--tu-space-6);
  }

  .game__number {
    font-family: var(--tu-font-display);
    font-weight: 700;
    color: var(--tu-success-text);
  }

  .game__title {
    font-size: 2.5rem;
    line-height: 1.1;
  }

  .game__lead {
    font-size: 1.1875rem;
    color: var(--tu-text-muted);
  }

  .game__steps {
    display: flex;
    flex-direction: column;
    gap: var(--tu-space-3);
    font-size: var(--tu-type-body-lg);
    line-height: 1.5;
  }

  .game__step {
    display: flex;
    gap: var(--tu-space-3);
    align-items: flex-start;
  }

  .game__step > span:last-child {
    padding-top: var(--tu-space-1);
  }

  .game__step-number {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--tu-space-8);
    height: var(--tu-space-8);
    border-radius: var(--tu-radius-pill);
    background: var(--tu-sage-50);
    color: var(--tu-success-text);
    font-family: var(--tu-font-display);
    font-size: var(--tu-btn-sm-font);
    font-weight: 700;
  }

  .game__facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--tu-space-6);
    padding-top: var(--tu-space-5);
    border-top: var(--tu-border-width) solid var(--tu-border);
  }

  .game__fact {
    display: flex;
    flex-direction: column;
    gap: var(--tu-space-1);
  }

  .game__fact-label {
    font-size: var(--tu-size-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--tu-text-muted);
  }

  .game__fact-value {
    margin: 0;
    font-size: var(--tu-btn-sm-font);
    font-weight: 600;
  }

  @media (max-width: 60rem) {
    .game__inner {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--tu-space-6);
    }

    /* Sur mobile, le visuel passe toujours en premier : il explique le jeu. */
    .game__visual,
    .game--reversed .game__visual {
      order: -1;
    }

    .game__text {
      gap: var(--tu-space-4);
    }

    .game__title {
      font-size: 1.75rem;
    }

    .game__lead {
      font-size: var(--tu-size-base);
    }

    .game__steps {
      font-size: var(--tu-btn-sm-font);
    }

    /* Les repères passent en lignes : libellé à gauche, valeur à droite. */
    .game__facts {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--tu-space-1);
      padding-top: var(--tu-space-4);
    }

    .game__fact {
      flex-direction: row;
      justify-content: space-between;
      gap: var(--tu-space-4);
    }

    .game__fact-label {
      font-size: var(--tu-size-sm);
      font-weight: 400;
      text-transform: none;
      letter-spacing: normal;
    }

    .game__fact-value {
      font-size: var(--tu-size-sm);
      text-align: end;
    }
  }
</style>
