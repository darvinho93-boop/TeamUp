---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/layout/PageIntro.astro';
import CtaBanner from '../components/layout/CtaBanner.astro';
import GameDetail from '../components/jeux/GameDetail.astro';
import ScreenPointsCommuns from '../components/visuels/ScreenPointsCommuns.astro';
import ScreenQuiz from '../components/visuels/ScreenQuiz.astro';
import ScreenSurenchere from '../components/visuels/ScreenSurenchere.astro';
import ScreenMime from '../components/visuels/ScreenMime.astro';
import ScreenPhoto from '../components/visuels/ScreenPhoto.astro';
import { duels, games } from '../data/jeux';

/** L'accroche de chaque jeu est celle de l'accueil : une seule source. */
const accroche = (id: string) => games.find((game) => game.id === id)?.body ?? '';
---

<Base
  title="Les cinq jeux — Team Up!"
  description="Points communs, Quiz, Surenchère, Mime, Photo challenge : cinq jeux qui se jouent debout, ensemble, et s'expliquent en une phrase."
>
  <PageIntro
    wide
    eyebrow="Les jeux"
    title="Cinq jeux pensés pour la salle, pas pour l'écran."
    lead="Chaque jeu s'explique en une phrase et se joue debout, ensemble. Avant chaque jeu, une courte animation sur le grand écran en montre les règles : personne n'est perdu."
  >
    <nav slot="footnote" class="toc" aria-label="Aller à un jeu">
      {games.map((game) => (
        <a class="toc__link" href={`#${game.id}`}>
          {game.title}
        </a>
      ))}
    </nav>
  </PageIntro>

  <GameDetail
    id="points-communs"
    number="01"
    title="Points communs"
    lead={accroche('points-communs')}
    steps={[
      "L'équipe ferme les yeux ; le point commun s'affiche pour toute la salle.",
      "Les invités concernés se lèvent : à l'équipe de deviner ce qui les rassemble, chrono lancé.",
      'Plus elle trouve vite, plus elle marque. Si elle sèche, un indice vient à son secours.',
    ]}
    facts={[
      { label: 'Durée', value: 'Un peu plus de 2 minutes par équipe' },
      { label: 'Qui joue', value: 'Une équipe, la salle participe' },
      { label: 'Téléphone', value: 'Non' },
    ]}
    reversed
  >
    <ScreenPointsCommuns variant="consigne" />
  </GameDetail>

  <GameDetail
    id="quiz"
    number="02"
    title="Quiz"
    lead={accroche('quiz')}
    steps={[
      "La question s'affiche sur le grand écran, avec quatre réponses.",
      'Chacun file dans le coin de la salle qui correspond à la sienne, marqué au sol.',
      'Les bonnes réponses restent en jeu. Chaque joueur encore debout à la fin rapporte des points à son équipe.',
    ]}
    facts={[
      { label: 'Durée', value: 'Une trentaine de secondes par question' },
      { label: 'Qui joue', value: 'Tout le monde' },
      { label: 'Téléphone', value: 'Seulement si la salle manque de place' },
    ]}
  >
    <ScreenQuiz label="Écran de la salle · Quiz" />
  </GameDetail>

  <GameDetail
    id="surenchere"
    number="03"
    title="Surenchère"
    lead={accroche('surenchere')}
    steps={[
      "Les thèmes sont annoncés à l'avance : chaque équipe choisit son champion.",
      "Les champions s'avancent, le sujet précis n'est dévoilé qu'au dernier moment.",
      'Chacun surenchérit à voix haute. Le plus audacieux doit tenir parole, chrono en main, devant toute la salle.',
    ]}
    facts={[
      { label: 'Durée', value: 'Environ 2 minutes par thème' },
      { label: 'Qui joue', value: 'Un champion par équipe' },
      { label: 'Téléphone', value: 'Non' },
    ]}
    reversed
  >
    <ScreenSurenchere />
  </GameDetail>

  <GameDetail
    id="mime"
    number="04"
    title="Mime"
    lead={accroche('mime')}
    steps={[
      'Seul le premier joueur de la file découvre le mot.',
      'Il le mime au suivant, qui le chuchote au suivant, et ainsi de suite.',
      "Le dernier annonce sa réponse, puis l'écran révèle le mot : vert s'il est trouvé, rouge sinon.",
    ]}
    facts={[
      { label: 'Durée', value: 'Environ 2 minutes et demie par équipe' },
      { label: 'Qui joue', value: 'Une équipe, en file' },
      { label: 'Téléphone', value: 'Non' },
    ]}
  >
    <ScreenMime />
  </GameDetail>

  <GameDetail
    id="photo"
    number="05"
    title="Photo challenge"
    lead={accroche('photo')}
    steps={[
      'Les thèmes sont annoncés en début de soirée.',
      'Entre deux jeux, au bar ou dehors, chaque équipe met en scène ses photos ; le capitaine les envoie.',
      'En final, les photos sont dévoilées thème par thème, et les héros de la fête désignent leur préférée.',
    ]}
    facts={[
      { label: 'Durée', value: 'Toute la soirée, puis 5 minutes de final' },
      { label: 'Qui joue', value: 'Une équipe entière' },
      { label: 'Téléphone', value: 'Celui du capitaine' },
    ]}
    reversed
  >
    <ScreenPhoto />
  </GameDetail>

  <section class="duels-section">
    <div class="tu-container">
      <div class="tu-panel duels">
        <div class="duels__intro">
          <p class="tu-eyebrow tu-eyebrow--navy">En option</p>
          <h2 class="duels__title">Les duels en un contre un</h2>
          <p class="duels__lead">Pour relancer l'ambiance lors des soirées les plus longues.</p>
        </div>
        {duels.map((duel) => (
          <article class="duel">
            <h3 class="duel__title">{duel.title}</h3>
            <p class="duel__body">{duel.body}</p>
            <p class="duel__duration">{duel.duration}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <CtaBanner title="On compose votre programme ensemble." />
</Base>

<style>
  .toc {
    display: flex;
    flex-wrap: wrap;
    gap: var(--tu-space-3);
  }

  .toc__link {
    display: inline-flex;
    align-items: center;
    min-height: var(--tu-space-12);
    padding-inline: var(--tu-space-5);
    border: var(--tu-btn-border-width) solid var(--tu-border);
    border-radius: var(--tu-radius-pill);
    background: var(--tu-surface);
    font-family: var(--tu-font-display);
    font-size: var(--tu-btn-sm-font);
    font-weight: 600;
    text-decoration: none;
  }

  .toc__link:hover {
    border-color: var(--tu-primary);
  }

  .duels-section {
    padding-bottom: var(--tu-section-space);
  }

  .duels {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--tu-space-12);
    align-items: start;
    padding: var(--tu-space-14) var(--tu-space-16);
  }

  .duels__intro,
  .duel {
    display: flex;
    flex-direction: column;
    gap: var(--tu-space-3);
  }

  .duels__title {
    font-size: var(--tu-size-2xl);
  }

  .duels__lead,
  .duel__body {
    color: var(--tu-text-muted);
  }

  .duel__title {
    font-size: 1.3125rem;
  }

  .duel__duration {
    font-size: var(--tu-size-sm);
    font-weight: 600;
  }

  @media (max-width: 60rem) {
    .toc__link {
      padding-inline: var(--tu-space-4);
    }

    .duels {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
      padding: var(--tu-space-6) 1.375rem;
    }

    .duels__intro {
      padding-bottom: var(--tu-space-5);
    }

    .duels__title {
      font-size: var(--tu-size-xl);
    }

    .duel {
      gap: var(--tu-space-2);
      padding-block: var(--tu-space-5);
      border-top: var(--tu-border-width) solid var(--tu-border);
    }

    .duel:last-child {
      padding-bottom: 0;
    }

    .duel__title {
      font-size: var(--tu-size-lg);
    }
  }
</style>
