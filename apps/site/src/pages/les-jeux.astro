---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/layout/PageIntro.astro';
import CtaBanner from '../components/layout/CtaBanner.astro';
import GameDetail from '../components/jeux/GameDetail.astro';
import VideoEcran from '../components/visuels/VideoEcran.astro';
import { duels, games } from '../data/jeux';

/** L'accroche de chaque jeu vient des données des jeux : une seule source. */
const accroche = (id: string) => games.find((game) => game.id === id)?.body ?? '';

/** Une courte boucle par jeu (`video/src/site/BoucleJeu.tsx`), dans le décor de celle de l'accueil. */
const video = (fichier: string) => ({
  src: `/videos/jeux/${fichier}.mp4`,
  affiche: `/videos/jeux/${fichier}.jpg`,
});
---

<Base
  title="Sept jeux d'animation de soirée pour toute la salle — Team Up!"
  description="Points communs, Quiz, Surenchère, Mime, Photo challenge, Blind test, Portrait mystère : sept jeux qui se jouent ensemble et s'expliquent en une phrase."
>
  <PageIntro
    wide
    eyebrow="L'expérience Team Up!"
    title="Sept jeux. Une expérience à vivre ensemble."
    lead={[
      "Retrouvez l'énergie, le suspense et les surprises des jeux télévisés à travers sept expériences conçues pour faire participer vos invités.",
      "Des défis où l'on réfléchit, où l'on ose, où l'on se découvre. Et surtout, où l'on joue en équipe.",
      "Chaque jeu est présenté par l'animateur et s'intègre dans un programme composé pour votre événement.",
    ]}
  >
    <nav slot="footnote" class="toc" aria-label="Aller à un jeu">
      {games.map((game) => (
        <a class="toc__link" href={`#${game.id}`}>
          {game.title}
        </a>
      ))}
    </nav>
  </PageIntro>

  <GameDetail
    id="points-communs"
    number="01"
    title="Points communs"
    accroche={accroche('points-communs')}
    lead="Un jeu d'observation qui révèle parfois des points communs inattendus."
    steps={[
      'Une équipe ferme les yeux pendant que le reste de la salle découvre un point commun.',
      "Les personnes concernées se manifestent. À l'équipe de deviner ce qui les relie, avant la fin du chronomètre.",
      'Plus elle trouve vite, plus elle marque. Si elle sèche, un indice vient à son secours.',
    ]}
    reversed
  >
    <VideoEcran
      {...video('points-communs')}
      caption="Vidéo : sur un plateau de jeu télé, des invités se lèvent devant une équipe qui cherche ce qui les rassemble."
    />
  </GameDetail>

  <GameDetail
    id="quiz"
    number="02"
    title="Quiz"
    accroche={accroche('quiz')}
    lead="Un quiz qui se vit collectivement, bien au-delà de l'écran."
    steps={[
      "Les questions s'affichent sur grand écran et les participants prennent position pour défendre leur réponse.",
      'Culture, intuition ou simple coup de chance : les choix provoquent des réactions, des échanges et quelques surprises.',
      'Les bonnes réponses restent en jeu : chaque joueur encore en lice à la fin rapporte des points à son équipe.',
    ]}
  >
    <VideoEcran
      {...video('quiz')}
      caption="Vidéo : sur un plateau de jeu télé, quatre coins A, B, C et D ; les invités du bon coin lèvent les bras."
    />
  </GameDetail>

  <GameDetail
    id="surenchere"
    number="03"
    title="Surenchère"
    accroche={accroche('surenchere')}
    lead="Un jeu où l'audace se confronte au chronomètre."
    steps={[
      "Les champions de chaque équipe se défient autour d'un thème. Les propositions s'enchaînent, les enchères montent…",
      'Mais annoncer une performance ne suffit pas. Encore faut-il la réaliser !',
      'Le plus audacieux doit tenir parole, chrono en main, devant toute la salle.',
    ]}
    reversed
  >
    <VideoEcran
      {...video('surenchere')}
      caption="Vidéo : sur un plateau de jeu télé, deux champions font monter l'enchère, jusqu'à « Adjugé ! »."
    />
  </GameDetail>

  <GameDetail
    id="mime"
    number="04"
    title="Mime"
    accroche={accroche('mime')}
    lead="Un mot à transmettre, une chaîne de participants et une communication qui réserve quelques surprises. Un moment de créativité et de complicité à partager."
    steps={[
      'Seul le premier joueur de la file découvre le mot.',
      'Il le mime au suivant, qui le chuchote au suivant, et ainsi de suite.',
      "Au fil des interprétations, le message évolue. Jusqu'à la révélation finale sur grand écran.",
    ]}
  >
    <VideoEcran
      {...video('mime')}
      caption="Vidéo : sur un plateau de jeu télé, trois invités en file se passent un mime."
    />
  </GameDetail>

  <GameDetail
    id="photo"
    number="05"
    title="Photo challenge"
    accroche={accroche('photo')}
    lead="Des instants de spontanéité qui deviennent de véritables souvenirs."
    steps={[
      'Les thèmes sont annoncés en début de soirée.',
      "Tout au long de l'événement, les équipes relèvent des défis photographiques et imaginent ensemble leurs mises en scène ; le capitaine envoie les photos.",
      'Lors du final, leurs créations sont révélées sur grand écran, et les héros de la fête désignent leur préférée.',
    ]}
    reversed
  >
    <VideoEcran
      {...video('photo-challenge')}
      caption="Vidéo : sur un plateau de jeu télé, une équipe prend la pose pour sa photo."
    />
  </GameDetail>

  <GameDetail
    id="blind-test"
    number="06"
    title="Blind test"
    accroche={accroche('blind-test')}
    lead="Un grand classique revisité dans l'esprit des jeux télévisés."
    steps={[
      'Les premières notes retentissent. Les équipes écoutent, hésitent et se concertent.',
      'Le capitaine le plus rapide déclenche son buzzer pour tenter de donner le bon titre.',
      'Bonne réponse : 100 points. Sinon, son équipe passe son tour sur ce titre et la musique repart pour les autres.',
    ]}
    nouveau
  >
    <VideoEcran
      {...video('blind-test')}
      caption="Vidéo : sur un plateau de jeu télé, trois capitaines écoutent la musique ; l'un tape son buzzer le premier et marque 100 points."
    />
  </GameDetail>

  <GameDetail
    id="portrait-mystere"
    number="07"
    title="Portrait mystère"
    accroche={accroche('portrait-mystere')}
    lead="Un jeu de déduction où chaque décision compte."
    steps={[
      'Face à une grille de vingt-cinq personnalités, les équipes confrontent leurs intuitions pour retrouver la bonne.',
      "Chaque indice fait avancer l'enquête. Mais attention aux pièges !",
      "Trouvé au premier indice : 100 points, puis 60, puis 30. L'équipe qui vote la carte noire est éliminée !",
    ]}
    reversed
    nouveau
  >
    <VideoEcran
      {...video('portrait-mystere')}
      caption="Vidéo : sur un plateau de jeu télé, une équipe se concerte devant une grille de vingt-cinq noms, puis trouve la bonne carte."
    />
  </GameDetail>

  <section class="duels-section">
    <div class="tu-container">
      <div class="tu-panel duels">
        <div class="duels__intro">
          <p class="tu-eyebrow tu-eyebrow--navy">En complément</p>
          <h2 class="duels__title">Les duels</h2>
          <p class="duels__lead">
            Quelques secondes pour faire basculer l'ambiance. Pour ponctuer certaines animations,
            les duels opposent deux participants autour de défis courts et dynamiques.
          </p>
        </div>
        {duels.map((duel) => (
          <article class="duel">
            <h3 class="duel__title">{duel.title}</h3>
            <p class="duel__body">{duel.body}</p>
            <p class="duel__duration">{duel.duration}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <CtaBanner
    title="À chaque événement, sa sélection de jeux."
    note="Nous choisissons ensemble les activités les plus adaptées à votre public, à votre lieu et au temps disponible. Les modalités peuvent être ajustées pour tenir compte des possibilités de déplacement et de participation de vos invités."
    label="Composer mon expérience Team Up!"
  />
</Base>

<style>
  .toc {
    display: flex;
    flex-wrap: wrap;
    gap: var(--tu-space-3);
  }

  /* La vidéo d'un jeu garde ses proportions : elle ne s'étire pas à la hauteur réservée aux écrans. */
  :global(.game__visual > .video-ecran) {
    flex: none;
  }

  .toc__link {
    display: inline-flex;
    align-items: center;
    min-height: var(--tu-space-12);
    padding-inline: var(--tu-space-5);
    border: var(--tu-btn-border-width) solid var(--tu-border);
    border-radius: var(--tu-radius-pill);
    background: var(--tu-surface);
    font-family: var(--tu-font-display);
    font-size: var(--tu-btn-sm-font);
    font-weight: 600;
    text-decoration: none;
  }

  .toc__link:hover {
    border-color: var(--tu-primary);
  }

  .duels-section {
    padding-bottom: var(--tu-section-space);
  }

  .duels {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--tu-space-12);
    align-items: start;
    padding: var(--tu-space-14) var(--tu-space-16);
  }

  .duels__intro,
  .duel {
    display: flex;
    flex-direction: column;
    gap: var(--tu-space-3);
  }

  .duels__title {
    font-size: var(--tu-size-2xl);
  }

  .duels__lead,
  .duel__body {
    color: var(--tu-text-muted);
  }

  .duel__title {
    font-size: 1.3125rem;
  }

  .duel__duration {
    font-size: var(--tu-size-sm);
    font-weight: 600;
  }

  @media (max-width: 60rem) {
    .toc__link {
      padding-inline: var(--tu-space-4);
    }

    .duels {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
      padding: var(--tu-space-6) 1.375rem;
    }

    .duels__intro {
      padding-bottom: var(--tu-space-5);
    }

    .duels__title {
      font-size: var(--tu-size-xl);
    }

    .duel {
      gap: var(--tu-space-2);
      padding-block: var(--tu-space-5);
      border-top: var(--tu-border-width) solid var(--tu-border);
    }

    .duel:last-child {
      padding-bottom: 0;
    }

    .duel__title {
      font-size: var(--tu-size-lg);
    }
  }
</style>
