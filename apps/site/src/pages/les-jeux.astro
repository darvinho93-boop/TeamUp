---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/layout/PageIntro.astro';
import Section from '../components/layout/Section.astro';
import CtaBanner from '../components/layout/CtaBanner.astro';
import GameDetail from '../components/jeux/GameDetail.astro';
import ScreenPointsCommuns from '../components/visuels/ScreenPointsCommuns.astro';
import ScreenQuiz from '../components/visuels/ScreenQuiz.astro';
import ScreenSurenchere from '../components/visuels/ScreenSurenchere.astro';
import ScreenMime from '../components/visuels/ScreenMime.astro';
import ScreenPhoto from '../components/visuels/ScreenPhoto.astro';
import { duels, games } from '../data/jeux';
---

<Base
  title="Les cinq jeux — Team Up!"
  description="Points communs, Quiz, Surenchère, Mime, Photo challenge : cinq jeux qui se jouent debout, dans la salle, et s'expliquent en une phrase."
>
  <PageIntro
    eyebrow="Les jeux"
    title="Cinq jeux pensés pour la salle, pas pour l'écran."
    lead="Chaque jeu s'explique en une phrase et se joue debout. Le téléphone ne sert qu'à porter un secret ou à envoyer une photo."
    centered
  >
    <nav slot="footnote" class="toc" aria-label="Aller à un jeu">
      {games.map((game) => (
        <a class="toc__link" href={`#${game.id}`}>
          {game.title}
        </a>
      ))}
    </nav>
  </PageIntro>

  <GameDetail
    id="points-communs"
    number="01"
    title="Points communs"
    lead="Une équipe dos à l'écran doit deviner ce qui rassemble les invités qui se lèvent."
    steps={[
      "L'équipe ferme les yeux ; l'écran montre le point commun à toute la salle.",
      "Les personnes concernées se lèvent, l'équipe devine, chrono lancé.",
      'Trois paliers, un indice de plus à chaque palier.',
    ]}
    facts={[
      { label: 'Durée', value: '2 min 10 par équipe' },
      { label: 'Qui joue', value: 'Une équipe, la salle participe' },
      { label: 'Téléphone', value: 'Non' },
    ]}
    reversed
  >
    <ScreenPointsCommuns variant="consigne" />
  </GameDetail>

  <GameDetail
    id="quiz"
    number="02"
    title="Quiz"
    lead="Quatre zones au sol, une question. Mauvaise zone : on sort du jeu."
    steps={[
      "La question s'affiche dans quatre quadrants A, B, C, D.",
      'Chacun va se placer dans la zone de sa réponse, marquée au sol.',
      'Les mauvaises zones sortent. Chaque survivant rapporte 100 points à son équipe.',
    ]}
    facts={[
      { label: 'Durée', value: '≈ 30 s par question' },
      { label: 'Qui joue', value: 'Tout le monde' },
      { label: 'Téléphone', value: 'Seulement si la salle est trop petite' },
    ]}
  >
    <ScreenQuiz />
  </GameDetail>

  <GameDetail
    id="surenchere"
    number="03"
    title="Surenchère"
    lead="Les champions surenchérissent à voix haute sur un sujet dévoilé au dernier moment."
    steps={[
      "Les thèmes sont affichés d'avance ; chaque équipe choisit son champion.",
      "Les champions s'avancent, le sujet précis est dévoilé.",
      'On surenchérit à voix haute. Le plus offrant doit tenir sa promesse, chrono en main.',
    ]}
    facts={[
      { label: 'Durée', value: '≈ 2 min par thème' },
      { label: 'Qui joue', value: 'Un champion par équipe' },
      { label: 'Téléphone', value: 'Non' },
    ]}
    reversed
  >
    <ScreenSurenchere />
  </GameDetail>

  <GameDetail
    id="mime"
    number="04"
    title="Mime"
    lead="Le mot traverse l'équipe en alternant mime et chuchotement. Il arrive rarement intact."
    steps={[
      'Seul le premier joueur voit le mot.',
      'Il le mime au suivant, qui le chuchote au suivant, et ainsi de suite.',
      "Le dernier l'annonce ; l'écran révèle le mot, vert si trouvé, rouge sinon.",
    ]}
    facts={[
      { label: 'Durée', value: '2 min 30 par équipe' },
      { label: 'Qui joue', value: 'Une équipe, en file' },
      { label: 'Téléphone', value: 'Non' },
    ]}
  >
    <ScreenMime />
  </GameDetail>

  <GameDetail
    id="photo"
    number="05"
    title="Photo challenge"
    lead="Toute la soirée, chaque équipe met en scène des thèmes. Diffusion en clôture."
    steps={[
      'Les thèmes sont annoncés au début de la soirée.',
      'Le capitaine envoie une photo par thème, quand il veut, entre les jeux.',
      'En fin de soirée, on diffuse thème par thème et les héros de la fête désignent la gagnante.',
    ]}
    facts={[
      { label: 'Durée', value: 'Toute la soirée + 5 min de diffusion' },
      { label: 'Qui joue', value: 'Une équipe entière' },
      { label: 'Téléphone', value: 'Celui du capitaine' },
    ]}
    reversed
  >
    <ScreenPhoto />
  </GameDetail>

  <Section
    eyebrow="En option"
    title="Les duels en un contre un"
    lead="Pour relancer la salle sur les créneaux de 60 minutes."
    tone="muted"
  >
    <div class="duels">
      {duels.map((duel) => (
        <article class="duel">
          <h3 class="duel__title">{duel.title}</h3>
          <p class="duel__body">{duel.body}</p>
          <p class="duel__duration">{duel.duration}</p>
        </article>
      ))}
    </div>
  </Section>

  <CtaBanner title="On compose votre programme ensemble." />
</Base>

<style>
  .toc {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--tu-space-2);
  }

  .toc__link {
    display: inline-flex;
    align-items: center;
    padding: var(--tu-space-2) var(--tu-space-4);
    border-radius: var(--tu-radius-pill);
    border: var(--tu-border-width) solid var(--tu-border);
    background: var(--tu-surface);
    font-family: var(--tu-font-display);
    font-size: var(--tu-size-sm);
    font-weight: 600;
    text-decoration: none;
  }

  .toc__link:hover {
    border-color: var(--tu-primary);
  }

  .duels {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr));
    gap: var(--tu-space-4);
  }

  .duel {
    display: flex;
    flex-direction: column;
    gap: var(--tu-space-2);
    padding: var(--tu-space-6);
    border-radius: var(--tu-radius-lg);
    background: var(--tu-surface);
    border: var(--tu-border-width) solid var(--tu-border);
  }

  .duel__title {
    font-size: var(--tu-size-lg);
  }

  .duel__body {
    color: var(--tu-text-muted);
  }

  .duel__duration {
    font-family: var(--tu-font-numeric);
    font-size: var(--tu-size-sm);
    font-weight: 600;
  }
</style>
