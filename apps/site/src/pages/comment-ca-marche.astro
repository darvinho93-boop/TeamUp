---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/layout/PageIntro.astro';
import Section from '../components/layout/Section.astro';
import StepList from '../components/layout/StepList.astro';
import CtaBanner from '../components/layout/CtaBanner.astro';
import Equipment from '../components/layout/Equipment.astro';
import Icon from '../components/Icon.astro';
import ScreenMimeLive from '../components/visuels/ScreenMimeLive.astro';
import PhonePeek from '../components/visuels/PhonePeek.astro';
import RegiePanel from '../components/visuels/RegiePanel.astro';

const avant = [
  {
    title: 'Demande de devis',
    body: "Deux minutes pour nous décrire votre événement : date, lieu, nombre d'invités, groupes à mélanger.",
  },
  {
    title: 'Un premier échange',
    body: "Nous faisons connaissance et fixons ensemble le format, les langues de vos invités et l'ambiance que vous souhaitez.",
  },
  {
    title: 'Préparation',
    body: 'Nous définissons les groupes à mélanger, calons le programme sur votre soirée et choisissons les contenus avec vous.',
  },
  {
    title: 'Le jour J',
    body: "L'animateur arrive [DÉLAI] avant vos invités : il branche l'écran, teste le son et le réseau. Quand la salle se remplit, tout fonctionne déjà.",
  },
];

const deroule = [
  'Les invités rejoignent la partie',
  'Les équipes se découvrent',
  "Les jeux s'enchaînent",
  'Le final en photos',
  'Le podium',
];

const durees = [
  { teams: '4 équipes', jeu: '≈ 36 min', creneau: '40 min', programme: 'Les cinq jeux au complet' },
  {
    teams: '5 équipes',
    jeu: '≈ 42 min',
    creneau: '40 min',
    programme: "Les cinq jeux, allégés d'un thème ou d'une question",
  },
  { teams: '6 équipes', jeu: '≈ 47 min', creneau: '1 h', programme: 'Les cinq jeux au complet' },
  { teams: '8 équipes', jeu: '≈ 58 min', creneau: '1 h', programme: 'Les cinq jeux au complet' },
];
---

<Base
  title="Comment ça marche — Team Up!"
  description="Un seul interlocuteur, une soirée préparée avec vous, un animateur qui arrive en avance et teste tout. Le jour J, il ne vous reste qu'à accueillir."
>
  <PageIntro
    wide
    eyebrow="Comment ça marche"
    title="Le jour J, il ne vous reste qu'à accueillir."
    lead="Un seul interlocuteur, de votre demande au podium. Nous préparons la soirée avec vous ; le jour venu, l'animateur arrive en avance, teste tout, puis fait vibrer la salle. Vos invités, eux, n'ont rien à installer."
  />

  <Section eyebrow="Avant la soirée" title="Quatre étapes, un seul interlocuteur.">
    <StepList steps={avant} variant="cards" />
  </Section>

  <Section
    eyebrow="Pendant la soirée"
    title="Un animateur, un grand écran, et les téléphones dans les poches."
  >
    <div class="surfaces">
      <article class="surface">
        <RegiePanel class="surface__visual" />
        <h3 class="surface__title">L'animateur</h3>
        <p class="surface__body">
          Il tient la salle au micro, donne le rythme et pilote chaque jeu. Jusqu'à 150 invités, et
          personne sur le côté.
        </p>
      </article>

      <article class="surface">
        <ScreenMimeLive class="surface__visual" />
        <h3 class="surface__title">L'écran de la salle</h3>
        <p class="surface__body">
          Projeté en grand : règles animées, chronos, scores et révélations. C'est lui que toute la
          salle regarde.
        </p>
      </article>

      <article class="surface">
        <PhonePeek class="surface__visual" />
        <h3 class="surface__title">Le téléphone des invités</h3>
        <p class="surface__body">
          Un scan du QR code et l'invité rejoint la partie, dans sa langue. Ensuite, le téléphone
          reste presque toujours dans la poche.
        </p>
      </article>
    </div>
  </Section>

  <Section eyebrow="Le déroulé" title="Du QR code au podium." tone="dark">
    <ol class="flow">
      {deroule.map((step, index) => (
        <li class="flow__step">
          <span class="flow__head" aria-hidden="true">
            {index > 0 && <Icon name="arrow" size="sm" class="flow__arrow" />}
            <span class="flow__number">{index + 1}</span>
          </span>
          <span class="flow__label">{step}</span>
        </li>
      ))}
    </ol>
    <p class="flow__note">
      Les photos se prennent tout au long de la soirée, entre deux jeux. L'animateur annonce les
      scores après chaque jeu, pour garder le suspense jusqu'au podium.
    </p>
  </Section>

  <Section
    eyebrow="Combien de temps ?"
    title="Tout dépend du nombre d'équipes."
    lead="Deux jeux se jouent une équipe après l'autre : plus il y a d'équipes, plus la partie dure. Une équipe compte environ [TAILLE D'ÉQUIPE] personnes."
    layout="aside"
  >
    <div class="tu-panel durees">
      <table class="durees__table">
        <thead>
          <tr>
            <th scope="col">Équipes</th>
            <th scope="col">Temps de jeu</th>
            <th scope="col">Durée prévue</th>
            <th scope="col">Programme</th>
          </tr>
        </thead>
        <tbody>
          {durees.map((row) => (
            <tr>
              <th scope="row" class="durees__teams">
                {row.teams}
              </th>
              <td class="durees__jeu">
                <span class="durees__prefix">jeu </span>
                {row.jeu}
              </td>
              <td class="durees__creneau">{row.creneau}</td>
              <td class="durees__programme">{row.programme}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </Section>

  <section class="equipment-section">
    <div class="tu-container">
      <Equipment />
      <p class="equipment__note">
        Un doute sur votre salle ? Nous le vérifions avec vous pendant la préparation.
      </p>
    </div>
  </section>

  <CtaBanner title="Première étape : nous décrire votre événement." />
</Base>

<style>
  .surfaces {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--tu-space-8);
    align-items: start;
  }

  .surface {
    display: flex;
    flex-direction: column;
    gap: var(--tu-space-4);
  }

  .surface :global(.surface__visual) {
    height: 16.25rem;
    margin-bottom: var(--tu-space-1);
  }

  /* Posé à plat dans la grille : ni ombre, ni grand rayon. */
  .surface :global(.surface__visual .screen) {
    box-shadow: none;
  }

  .surface__title {
    font-size: 1.375rem;
  }

  .surface__body {
    color: var(--tu-text-muted);
  }

  .flow {
    display: flex;
    gap: var(--tu-space-5);
  }

  .flow__step {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--tu-space-3);
  }

  .flow__head {
    display: flex;
    align-items: center;
    gap: var(--tu-space-3);
  }

  /* La flèche se place dans la gouttière, avant le chiffre, comme dans la maquette. */
  .flow__head :global(.flow__arrow) {
    margin-left: calc(-1 * (var(--tu-space-4) + var(--tu-space-3)));
    color: var(--tu-text-muted);
  }

  .flow__number {
    font-family: var(--tu-font-display);
    font-size: 2.5rem;
    font-weight: 700;
    line-height: 1;
    color: var(--tu-primary);
  }

  .flow__label {
    font-family: var(--tu-font-display);
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .flow__note {
    max-width: 47.5rem;
    color: var(--tu-text-muted);
  }

  .durees {
    overflow: hidden;
  }

  .durees__table {
    width: 100%;
    border-collapse: collapse;
    text-align: start;
  }

  .durees__table th,
  .durees__table td {
    padding: 1.125rem var(--tu-space-5);
    text-align: start;
    font-size: var(--tu-type-body-lg);
  }

  .durees__table thead tr {
    background: var(--tu-surface-muted);
  }

  .durees__table thead th {
    padding-block: var(--tu-space-4);
    font-size: var(--tu-type-caption);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--tu-text-muted);
  }

  .durees__table tbody tr {
    border-top: var(--tu-border-width) solid var(--tu-border);
  }

  .durees__teams {
    font-family: var(--tu-font-display);
    font-size: var(--tu-size-lg);
    font-weight: 700;
  }

  .durees__prefix {
    display: none;
  }

  .durees__creneau {
    font-weight: 600;
  }

  .durees__table .durees__programme {
    font-size: var(--tu-size-base);
    color: var(--tu-text-muted);
  }

  .equipment-section {
    padding-bottom: var(--tu-section-space);
  }

  .equipment__note {
    margin-top: var(--tu-space-5);
    color: var(--tu-text-muted);
  }

  @media (max-width: 60rem) {
    .surfaces {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--tu-space-8);
    }

    .surface {
      gap: var(--tu-space-3);
    }

    .surface :global(.surface__visual) {
      height: auto;
      min-height: 12.5rem;
    }

    .surface :global(.surface__visual.peek-figure) {
      min-height: 0;
    }

    .surface__title {
      font-size: var(--tu-size-lg);
    }

    .flow {
      flex-direction: column;
      gap: var(--tu-space-4);
    }

    .flow__step {
      flex-direction: row;
      align-items: center;
      gap: var(--tu-space-4);
    }

    .flow__head :global(.flow__arrow) {
      display: none;
    }

    .flow__number {
      flex: none;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: var(--tu-space-8);
      height: var(--tu-space-8);
      border-radius: var(--tu-radius-pill);
      background: var(--tu-surface);
      font-size: var(--tu-size-sm);
    }

    .flow__label {
      font-family: var(--tu-font-body);
      font-size: var(--tu-size-base);
      font-weight: 500;
    }

    /* Sous 60 rem, chaque ligne devient une fiche : équipes à gauche, créneau à droite. */
    .durees__table thead {
      display: none;
    }

    .durees__table,
    .durees__table tbody {
      display: block;
    }

    .durees__table tbody tr {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas:
        'teams creneau'
        'programme jeu';
      column-gap: var(--tu-space-4);
      padding: var(--tu-space-4) 1.125rem;
    }

    .durees__table th,
    .durees__table td {
      padding: 0;
    }

    .durees__teams {
      grid-area: teams;
      font-size: 1.125rem;
    }

    .durees__creneau {
      grid-area: creneau;
      text-align: end;
    }

    .durees__table .durees__jeu {
      grid-area: jeu;
      font-size: var(--tu-type-caption);
      color: var(--tu-text-muted);
      text-align: end;
    }

    .durees__prefix {
      display: inline;
    }

    .durees__table .durees__programme {
      grid-area: programme;
      font-size: var(--tu-type-caption);
    }
  }
</style>
