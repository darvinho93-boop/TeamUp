---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/layout/PageIntro.astro';
import Section from '../components/layout/Section.astro';
import StepList from '../components/layout/StepList.astro';
import Recit from '../components/layout/Recit.astro';
import CtaBanner from '../components/layout/CtaBanner.astro';
import Equipment from '../components/layout/Equipment.astro';
import Icon from '../components/Icon.astro';
import ScreenMimeLive from '../components/visuels/ScreenMimeLive.astro';
import PhonePeek from '../components/visuels/PhonePeek.astro';
import RegiePanel from '../components/visuels/RegiePanel.astro';

const avant = [
  {
    title: 'Vous nous présentez votre projet',
    body: 'Une date, un lieu, un nombre de participants et quelques informations sur le public que vous réunissez.',
  },
  {
    title: 'Nous imaginons votre expérience',
    body: "Nous échangeons sur l'ambiance souhaitée, les groupes à mélanger, les langues parlées et les éventuels besoins d'adaptation.",
  },
  {
    title: 'Nous construisons votre programme',
    body: 'Sélection des jeux, contenus personnalisés, constitution des équipes et organisation du déroulement : les détails sont préparés avec vous.',
  },
  {
    title: "Nous préparons l'installation",
    body: "Le jour J, l'animateur arrive en avance pour mettre en place le matériel de jeu et vérifier les équipements nécessaires.",
  },
];

const deroule = [
  'Les participants rejoignent la partie.',
  'Les équipes se découvrent.',
  "L'animateur lance les différents jeux.",
  'Les photos et les moments forts sont révélés.',
  "Le podium final vient clôturer l'expérience.",
];

const durees = [
  { teams: '4 équipes', jeu: '≈ 36 min', creneau: '40 min', programme: 'Cinq jeux au complet' },
  {
    teams: '5 équipes',
    jeu: '≈ 42 min',
    creneau: '40 min',
    programme: "Cinq jeux, allégés d'un thème ou d'une question",
  },
  { teams: '6 équipes', jeu: '≈ 47 min', creneau: '1 h', programme: 'Cinq jeux au complet' },
  { teams: '8 équipes', jeu: '≈ 58 min', creneau: '1 h', programme: 'Cinq jeux au complet' },
];
---

<Base
  title="Comment se déroule une animation de soirée — Team Up!"
  description="Une expérience préparée avec vous, de la préparation au podium final : un animateur, un grand écran, et vos invités au cœur du jeu."
>
  <PageIntro
    wide
    eyebrow="Une expérience préparée avec vous"
    title="Laissez-vous porter par l'événement. Nous donnons vie au jeu."
    lead={[
      "Team Up! associe la convivialité d'un jeu collectif à la simplicité d'une animation accompagnée.",
      "De la préparation au podium final, nous coordonnons l'expérience pour que vous puissiez vous consacrer à l'essentiel : vos invités.",
    ]}
  />

  <Section eyebrow="Avant l'événement" title="Une préparation en quatre étapes.">
    <StepList steps={avant} variant="cards" />
  </Section>

  <Section eyebrow="Pendant l'événement" title="Place à l'expérience.">
    <div class="surfaces tu-rail">
      <article class="surface" data-tu-apparait>
        <RegiePanel class="surface__visual" />
        <h3 class="surface__title">Un animateur pour orchestrer la partie</h3>
        <p class="surface__body">
          Il accueille les participants, explique les règles, lance les défis et donne le rythme,
          jusqu'à la révélation des résultats.
        </p>
      </article>

      <article class="surface" data-tu-apparait>
        <ScreenMimeLive class="surface__visual" />
        <h3 class="surface__title">Un grand écran au cœur de l'expérience</h3>
        <p class="surface__body">
          Questions, chronomètres, scores et surprises apparaissent en direct, pour que chacun
          puisse suivre la progression du jeu.
        </p>
      </article>

      <article class="surface" data-tu-apparait>
        <PhonePeek class="surface__visual" />
        <h3 class="surface__title">Un téléphone utilisé avec simplicité</h3>
        <p class="surface__body">
          Les participants rejoignent la partie grâce à un QR code, sans application ni compte à
          créer. Selon les jeux, le téléphone peut également servir à recevoir une consigne,
          utiliser un buzzer ou transmettre une photo.
        </p>
        <p class="surface__body">
          L'essentiel de l'expérience se vit entre les participants, dans la salle.
        </p>
      </article>
    </div>
  </Section>

  <Section eyebrow="Le déroulé" title="Du premier défi au podium final." tone="dark">
    <ol class="flow tu-rail">
      {deroule.map((step, index) => (
        <li class="flow__step" data-tu-apparait>
          <span class="flow__head" aria-hidden="true">
            {index > 0 && <Icon name="arrow" size="sm" class="flow__arrow" />}
            <span class="flow__number">{index + 1}</span>
          </span>
          <span class="flow__label">{step}</span>
        </li>
      ))}
    </ol>
  </Section>

  <Section
    eyebrow="Combien de temps ?"
    title="Un format qui s'intègre à votre événement."
    layout="aside"
  >
    <div class="durees-bloc">
      <Recit
        paragraphes={[
          "La partie principale dure généralement entre 40 minutes et une heure, selon le nombre d'équipes et le programme retenu.",
          "Certains défis, comme le Photo challenge, peuvent se dérouler entre les manches, tout au long de l'événement.",
          "Le programme et les modalités de participation sont définis avec vous en amont pour s'adapter au lieu, au public et au rythme souhaité.",
        ]}
      />
      <div class="tu-panel durees" data-tu-apparait>
        <table class="durees__table">
          <thead>
            <tr>
              <th scope="col">Équipes</th>
              <th scope="col">Temps de jeu</th>
              <th scope="col">Durée prévue</th>
              <th scope="col">Programme</th>
            </tr>
          </thead>
          <tbody>
            {durees.map((row) => (
              <tr>
                <th scope="row" class="durees__teams">
                  {row.teams}
                </th>
                <td class="durees__jeu">
                  <span class="durees__prefix">jeu </span>
                  {row.jeu}
                </td>
                <td class="durees__creneau">{row.creneau}</td>
                <td class="durees__programme">{row.programme}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </Section>

  <section class="equipment-section">
    <div class="tu-container">
      <Equipment />
      <p class="equipment__note">
        Nous vérifions ensemble les besoins techniques avant l'événement.
      </p>
    </div>
  </section>

  <CtaBanner
    title="Votre événement mérite une expérience qui lui ressemble."
    note="Imaginons ensemble le programme le plus adapté à vos participants et à l'ambiance que vous souhaitez créer."
    label="Parlons de votre projet"
  />
</Base>

<style>
  .surfaces {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--tu-space-8);
    align-items: start;
  }

  /* Relative : la légende cachée d'un visuel (position absolue) reste dans la rangée qui défile,
     sinon elle élargissait la page sur téléphone. */
  .surface {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--tu-space-4);
  }

  .surface :global(.surface__visual) {
    height: 16.25rem;
    margin-bottom: var(--tu-space-1);
  }

  /* Posé à plat dans la grille : ni ombre, ni grand rayon. */
  .surface :global(.surface__visual .screen) {
    box-shadow: none;
  }

  .surface__title {
    font-size: 1.375rem;
  }

  .surface__body {
    color: var(--tu-text-muted);
  }

  .flow {
    display: flex;
    gap: var(--tu-space-5);
  }

  .flow__step {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--tu-space-3);
  }

  .flow__head {
    display: flex;
    align-items: center;
    gap: var(--tu-space-3);
  }

  /* La flèche se place dans la gouttière, avant le chiffre, comme dans la maquette. */
  .flow__head :global(.flow__arrow) {
    margin-left: calc(-1 * (var(--tu-space-4) + var(--tu-space-3)));
    color: var(--tu-text-muted);
  }

  .flow__number {
    font-family: var(--tu-font-display);
    font-size: 2.5rem;
    font-weight: 700;
    line-height: 1;
    color: var(--tu-primary);
  }

  .flow__label {
    font-family: var(--tu-font-display);
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.3;
  }

  /* Le texte et le tableau dans la même colonne, à droite du titre. */
  .durees-bloc {
    display: flex;
    flex-direction: column;
    gap: var(--tu-space-6);
    min-width: 0;
  }

  .durees {
    overflow: hidden;
  }

  .durees__table {
    width: 100%;
    border-collapse: collapse;
    text-align: start;
  }

  .durees__table th,
  .durees__table td {
    padding: 1.125rem var(--tu-space-5);
    text-align: start;
    font-size: var(--tu-type-body-lg);
  }

  .durees__table thead tr {
    background: var(--tu-surface-muted);
  }

  .durees__table thead th {
    padding-block: var(--tu-space-4);
    font-size: var(--tu-type-caption);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--tu-text-muted);
  }

  .durees__table tbody tr {
    border-top: var(--tu-border-width) solid var(--tu-border);
  }

  .durees__teams {
    font-family: var(--tu-font-display);
    font-size: var(--tu-size-lg);
    font-weight: 700;
  }

  .durees__prefix {
    display: none;
  }

  .durees__creneau {
    font-weight: 600;
  }

  .durees__table .durees__programme {
    font-size: var(--tu-size-base);
    color: var(--tu-text-muted);
  }

  .equipment-section {
    padding-bottom: var(--tu-section-space);
  }

  .equipment__note {
    margin-top: var(--tu-space-5);
    color: var(--tu-text-muted);
  }

  @media (max-width: 60rem) {
    /* Téléphone : les trois vignettes gardent leur hauteur commune et glissent en rangée (.tu-rail). */
    .surface {
      gap: var(--tu-space-3);
    }

    .surface__title {
      font-size: var(--tu-size-lg);
    }

    /* Les grands chiffres et leurs flèches, comme sur ordinateur : deux étapes et demie à l'écran. */
    .flow {
      --tu-rail-item: var(--tu-rail-item-court);
      --tu-rail-gap: var(--tu-space-5);
      --tu-rail-bord: var(--tu-space-6);
    }

    .flow__label {
      font-size: var(--tu-size-base);
    }

    /* Sous 60 rem, chaque ligne devient une fiche : équipes à gauche, créneau à droite. */
    .durees__table thead {
      display: none;
    }

    .durees__table,
    .durees__table tbody {
      display: block;
    }

    .durees__table tbody tr {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas:
        'teams creneau'
        'programme jeu';
      column-gap: var(--tu-space-4);
      padding: var(--tu-space-4) 1.125rem;
    }

    .durees__table th,
    .durees__table td {
      padding: 0;
    }

    .durees__teams {
      grid-area: teams;
      font-size: 1.125rem;
    }

    .durees__creneau {
      grid-area: creneau;
      text-align: end;
    }

    .durees__table .durees__jeu {
      grid-area: jeu;
      font-size: var(--tu-size-xs);
      color: var(--tu-text-muted);
      text-align: end;
    }

    .durees__prefix {
      display: inline;
    }

    .durees__table .durees__programme {
      grid-area: programme;
      font-size: var(--tu-size-xs);
    }
  }
</style>
