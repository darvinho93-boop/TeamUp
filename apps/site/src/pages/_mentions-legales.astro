---
import LegalLayout from '../components/layout/LegalLayout.astro';

/* Page masquée le 2026-10-10 (le tiret bas la sort du site) : à renommer en mentions-legales.astro
   et à relier au pied de page et au gabarit légal quand les informations de la société seront là. */
---

<LegalLayout
  title="Mentions légales — Team Up!"
  description="Éditeur, hébergement et propriété intellectuelle du site Team Up!"
  heading="Mentions légales"
  miseAJour="[DATE]"
>
  <section>
    <h2>Éditeur du site</h2>
    <p>
      [RAISON SOCIALE], [FORME JURIDIQUE] au capital de [MONTANT]
      <br />
      SIRET : [NUMÉRO] · RCS : [VILLE]
      <br />
      Siège social : [ADRESSE]
      <br />
      Directeur de la publication : [NOM]
      <br />
      Contact : [EMAIL] · [TÉLÉPHONE]
    </p>
  </section>

  <section>
    <h2>Hébergement</h2>
    <p>
      [HÉBERGEUR]
      <br />
      [ADRESSE DE L'HÉBERGEUR]
    </p>
  </section>

  <section>
    <h2>Propriété intellectuelle</h2>
    <p>[TEXTE À RÉDIGER : marque Team Up!, logo, contenus et jeux.]</p>
  </section>

  <section>
    <h2>Données personnelles</h2>
    <p>
      Le traitement des données collectées par le formulaire de devis et pendant les parties est
      décrit dans la <a href="/confidentialite">politique de confidentialité</a>.
    </p>
  </section>
</LegalLayout>
