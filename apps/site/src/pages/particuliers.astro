---
import Base from '../layouts/Base.astro';
import Button from '@teamup/ui/astro/Button.astro';
import PageIntro from '../components/layout/PageIntro.astro';
import Section from '../components/layout/Section.astro';
import StepList from '../components/layout/StepList.astro';
import CtaBanner from '../components/layout/CtaBanner.astro';
import Faq from '../components/layout/Faq.astro';
import type { FaqItem } from '../components/layout/Faq.astro';
import ScreenTeams from '../components/visuels/ScreenTeams.astro';
import PhoneSecret from '../components/visuels/PhoneSecret.astro';
import PhonePhoto from '../components/visuels/PhonePhoto.astro';
import PhoneLang from '../components/visuels/PhoneLang.astro';
import Stage from '../components/visuels/Stage.astro';
import Timeline from '../components/jeux/Timeline.astro';
import type { TimelineItem } from '../components/jeux/Timeline.astro';

const occasions = [
  {
    title: 'Anniversaire',
    body: "Amis d'enfance, collègues, famille : les cercles de la personne fêtée se rencontrent enfin.",
  },
  {
    title: 'Mariage',
    body: "Les deux familles et les deux bandes d'amis dans les mêmes équipes, entre le dîner et la piste.",
  },
  {
    title: 'Anniversaire de mariage',
    body: "Plusieurs générations autour du couple, avec des jeux qui s'expliquent en une phrase.",
  },
  {
    title: 'Fête de famille',
    body: 'Cousins éloignés, nouvelles pièces rapportées, petits et grands : chacun repart en connaissant les autres.',
  },
];

const raisons = [
  {
    title: "Des équipes composées à l'avance",
    body: 'On répartit ensemble les invités pour que chaque équipe mélange vos groupes : familles, amis, collègues.',
  },
  {
    title: 'Tout le monde debout, personne sur son écran',
    body: "Le téléphone ne sert qu'à recevoir un secret ou envoyer une photo. Le jeu se passe dans la salle.",
  },
  {
    title: 'Les héros de la fête au centre',
    body: 'Ce sont eux qui désignent les photos gagnantes en fin de soirée, devant tout le monde.',
  },
];

const programme: TimelineItem[] = [
  { label: 'Points communs', duration: '8 min 40', seconds: 520, tone: 'navy' },
  { label: 'Quiz', duration: '2 min', seconds: 120, tone: 'sage' },
  { label: 'Surenchère', duration: '6 min', seconds: 360, tone: 'amber' },
  { label: 'Mime', duration: '10 min', seconds: 600, tone: 'mint' },
  { label: 'Diffusion photo', duration: '5 min', seconds: 300, tone: 'stone' },
  { label: 'Transitions', duration: '≈ 4 min', seconds: 220, tone: 'muted' },
];

/* Seule la première réponse est rédigée dans la maquette. Les autres sont à fournir. */
const faq: FaqItem[] = [
  {
    question: "Pour combien d'invités ?",
    answer: "De [MIN] à [MAX] invités. Le nombre d'équipes et la durée s'ajustent en conséquence.",
  },
  { question: "Combien de temps dure l'animation ?" },
  { question: 'Mes invités doivent-ils installer une application ?' },
  { question: 'De quoi avez-vous besoin sur place ?' },
  { question: 'Quelles langues sont disponibles ?' },
  { question: 'Combien ça coûte ?' },
];
---

<Base
  title="Anniversaire, mariage, fête de famille — Team Up!"
  description="Une fête où tout le monde finit par se parler : un animateur Team Up! mélange vos tablées en équipes et fait jouer toute la salle."
>
  <PageIntro
    eyebrow="Particuliers"
    title="Une fête où tout le monde finit par se parler."
    lead="Anniversaire, mariage, fête de famille : on transforme des tablées qui s'observent en équipes qui jouent ensemble. Vous, vous profitez de vos invités."
  >
    <Fragment slot="actions">
      <Button href="/devis" variant="accent" size="cta">
        Demander un devis
      </Button>
      <Button href="#programme" variant="outline" size="cta">
        Voir un exemple de soirée
      </Button>
    </Fragment>
    <Stage slot="visual" class="hero-stage">
      <ScreenTeams slot="screen" />
      <PhoneSecret slot="phone" class="desktop-only" />
    </Stage>
  </PageIntro>

  <Section eyebrow="Les occasions" title="Dès que plusieurs cercles se retrouvent.">
    <div class="occasions">
      {occasions.map((occasion) => (
        <article class="tu-panel occasion">
          <h3 class="occasion__title">{occasion.title}</h3>
          <p class="occasion__body">{occasion.body}</p>
        </article>
      ))}
    </div>
  </Section>

  <section class="why-section">
    <div class="tu-container why">
      <div class="why__visual desktop-only">
        <PhonePhoto />
      </div>
      <div class="why__text">
        <div class="why__header">
          <p class="tu-eyebrow">Pourquoi ça marche</p>
          <h2 class="tu-title">Le mélange ne se fait pas tout seul. On l'organise.</h2>
        </div>
        <StepList steps={raisons} variant="plain" />
      </div>
    </div>
  </section>

  <Section
    id="programme"
    eyebrow="Exemple de soirée"
    title="40 minutes, 4 équipes, 5 jeux."
    tone="dark"
  >
    <Timeline items={programme} />
    <p class="programme__note">
      Les photos se prennent tout au long de la soirée, entre les jeux. Le programme s'adapte au
      nombre d'invités : au-delà de cinq équipes, on prévoit un créneau de 60 minutes.
    </p>
  </Section>

  <section class="multi-section">
    <div class="tu-container multi">
      <div class="multi__text">
        <p class="tu-eyebrow">Multilingue</p>
        <h2 class="tu-title">Chacun joue dans sa langue.</h2>
        <p class="multi__body">
          Les familles ne parlent pas toutes la même langue ? Chaque invité choisit la sienne en
          rejoignant la partie. Les jeux reposent sur le geste et le mouvement, pas sur les mots.
        </p>
      </div>
      <div class="multi__visual">
        <PhoneLang />
      </div>
    </div>
  </section>

  <Section eyebrow="Questions fréquentes" title="Avant de vous lancer." layout="aside">
    <Faq items={faq} />
  </Section>

  <CtaBanner title="Racontez-nous votre fête." />
</Base>

<style>
  .occasions {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--tu-space-5);
  }

  .occasion {
    display: flex;
    flex-direction: column;
    gap: var(--tu-space-3);
    padding: var(--tu-space-8);
  }

  .occasion__title {
    font-size: 1.375rem;
  }

  .occasion__body {
    color: var(--tu-text-muted);
  }

  .why-section,
  .multi-section {
    padding-bottom: var(--tu-section-space);
  }

  .why,
  .multi {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--tu-space-20);
    align-items: center;
  }

  .why__visual,
  .multi__visual {
    display: flex;
    justify-content: center;
  }

  .why__text,
  .multi__text {
    display: flex;
    flex-direction: column;
    gap: var(--tu-space-9);
  }

  .why__header {
    display: flex;
    flex-direction: column;
    gap: var(--tu-space-3);
  }

  .multi__text {
    gap: var(--tu-space-5);
  }

  .multi__body {
    font-size: 1.125rem;
    color: var(--tu-text-muted);
  }

  .programme__note {
    max-width: 47.5rem;
    color: var(--tu-text-muted);
  }

  @media (max-width: 75rem) {
    .occasions {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 60rem) {
    /* Mobile : l'écran des équipes seul, sans téléphone ; pas de téléphone non plus
                           à côté de « Pourquoi ça marche ». */
    .desktop-only,
    :global(.stage.hero-stage .desktop-only) {
      display: none;
    }

    :global(.stage.hero-stage) {
      min-height: 0;
    }

    :global(.stage.hero-stage .stage__screen) {
      position: static;
      width: 100%;
    }

    .occasions {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--tu-space-3);
    }

    .occasion {
      gap: var(--tu-space-2);
      padding: var(--tu-space-6) 1.375rem;
    }

    .occasion__title {
      font-size: var(--tu-size-lg);
    }

    .why,
    .multi {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--tu-space-6);
    }

    .why__text {
      gap: var(--tu-space-5);
    }

    .multi__body {
      font-size: var(--tu-size-base);
    }
  }
</style>
