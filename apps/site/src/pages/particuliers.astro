---
import Base from '../layouts/Base.astro';
import Button from '@teamup/ui/astro/Button.astro';
import PageIntro from '../components/layout/PageIntro.astro';
import Section from '../components/layout/Section.astro';
import StepList from '../components/layout/StepList.astro';
import Recit from '../components/layout/Recit.astro';
import CtaBanner from '../components/layout/CtaBanner.astro';
import Faq from '../components/layout/Faq.astro';
import type { FaqItem } from '../components/layout/Faq.astro';
import ScreenTeams from '../components/visuels/ScreenTeams.astro';
import PhoneSecret from '../components/visuels/PhoneSecret.astro';
import PhonePhoto from '../components/visuels/PhonePhoto.astro';
import PhoneLang from '../components/visuels/PhoneLang.astro';
import Stage from '../components/visuels/Stage.astro';
import Timeline from '../components/jeux/Timeline.astro';
import type { TimelineItem } from '../components/jeux/Timeline.astro';

const occasions = [
  {
    title: 'Mariages',
    sousTitre: 'Deux histoires qui se rejoignent.',
    body: "Vos familles et vos amis se retrouvent pour célébrer votre union. Team Up! leur offre une occasion originale de faire connaissance, de jouer ensemble et de partager les premiers souvenirs d'une nouvelle histoire commune.",
  },
  {
    title: 'Anniversaires',
    sousTitre: "Tous vos univers réunis autour d'un même jeu.",
    body: "Amis d'enfance, famille, collègues, proches de différentes générations : réunissez ceux qui comptent pour vous et regardez les affinités se créer au fil des défis.",
  },
  {
    title: 'Anniversaires de mariage',
    sousTitre: 'Des générations, des souvenirs et de nouvelles complicités.',
    body: "Une belle occasion de réunir vos proches autour d'une expérience qui traverse les âges, entre clins d'œil, découvertes et émotions partagées.",
  },
  {
    title: 'Fêtes de famille',
    sousTitre: 'Le plaisir de se retrouver. La surprise de se redécouvrir.',
    body: "Cousins, parents, nouveaux venus et amis de la famille deviennent les partenaires d'une aventure commune, le temps d'une partie.",
  },
];

const raisons = [
  {
    title: 'Des équipes qui mélangent les invités',
    body: "En réunissant des personnes de différents cercles, Team Up! crée des occasions de se parler que l'on n'aurait peut-être pas saisies naturellement.",
  },
  {
    title: 'Une place pour chaque personnalité',
    body: "Les jeux font appel à des qualités variées : intuition, observation, mémoire, imagination ou esprit d'équipe. Les modalités de participation peuvent être adaptées pour que chacun prenne part à l'expérience à son rythme.",
  },
  {
    title: 'Des moments de complicité spontanés',
    body: "On se concerte, on s'encourage, on se surprend. Et parfois, une simple réponse devient le début d'une conversation.",
  },
  {
    title: 'Une fête dont vous profitez pleinement',
    body: "Nous préparons le programme avec vous et assurons l'animation le jour J, pour que vous puissiez vivre l'événement aux côtés de vos invités.",
  },
];

const programme: TimelineItem[] = [
  { label: 'Points communs', seconds: 520, tone: 'navy' },
  { label: 'Quiz', seconds: 120, tone: 'sage' },
  { label: 'Surenchère', seconds: 360, tone: 'amber' },
  { label: 'Mime', seconds: 600, tone: 'mint' },
  { label: 'Final photo', seconds: 300, tone: 'stone' },
  { label: 'Podium', seconds: 220, tone: 'muted' },
];

/* Réponses tirées de la spec v3 ; les chiffres commerciaux restent entre crochets. */
const faq: FaqItem[] = [
  {
    question: "Pour combien d'invités ?",
    answer:
      "Jusqu'à 150 invités. Le nombre d'équipes et le programme s'adaptent à votre liste, et toute la salle joue en même temps.",
  },
  {
    question: 'Où intervenez-vous ?',
    answer:
      'Partout en France. Le déplacement est chiffré dans le devis, selon le lieu de votre événement.',
  },
  {
    question: "Qu'ai-je à faire le jour J ?",
    answer:
      "Accueillir vos invités. L'animateur arrive en avance, installe et teste l'écran, le son et le réseau, puis tient la salle du début à la fin.",
  },
  {
    question: "Combien de temps dure l'animation ?",
    answer:
      "Environ 40 minutes de jeu jusqu'à cinq équipes, une heure au-delà. Les photos, elles, se prennent tout au long de la soirée, entre deux jeux.",
  },
  {
    question: 'Mes invités doivent-ils installer une application ?',
    answer:
      "Non. Ils scannent le QR code affiché sur le grand écran, choisissent leur langue et entrent leur prénom : c'est tout. Ni application, ni compte, ni adresse e-mail.",
  },
  {
    question: 'De quoi avez-vous besoin sur place ?',
    answer:
      "D'un vidéoprojecteur ou d'un grand écran, d'une sono avec micro, d'un peu d'espace au sol et d'une connexion Wi-Fi ou 4G. Nous apportons tout le reste : l'animation, les jeux et les accessoires.",
  },
  {
    question: 'Et si le réseau tombe pendant la soirée ?',
    answer:
      "L'animation continue : la plupart des jeux se jouent dans la salle, sans les téléphones. Les photos en attente partent d'elles-mêmes dès le retour du réseau.",
  },
  {
    question: 'Quelles langues sont disponibles ?',
    answer:
      'Celles de vos invités. Indiquez-les dans votre demande : nous traduisons les contenus de la soirée et les relisons avec vous. Chaque invité choisit ensuite la sienne sur son téléphone.',
  },
];
---

<Base
  title="Anniversaire, mariage, fête de famille — Team Up!"
  description="Mariages, anniversaires, fêtes de famille : une expérience inspirée des jeux télévisés, à partager avec vos invités, jusqu'à 150, partout en France."
>
  <PageIntro
    eyebrow="Mariages · Anniversaires · Fêtes de famille"
    title="Les plus beaux événements sont ceux qui nous rapprochent."
    lead={[
      "Une famille, des amis, plusieurs générations, des invités qui se connaissent depuis toujours… et d'autres qui se rencontrent pour la première fois.",
      "Avec Team Up!, offrez-leur bien plus qu'une animation : une expérience inspirée des jeux télévisés, à partager ensemble.",
      'Les équipes se mélangent, les échanges naissent et la fête prend une nouvelle dimension.',
    ]}
  >
    <Fragment slot="actions">
      <Button href="/devis?type=particulier" variant="accent" size="cta">
        Imaginer mon événement
      </Button>
      <Button href="#programme" variant="outline" size="cta">
        Découvrir le déroulement
      </Button>
    </Fragment>
    <Stage slot="visual" class="hero-stage">
      <ScreenTeams slot="screen" />
      <PhoneSecret slot="phone" />
    </Stage>
  </PageIntro>

  <Section eyebrow="Les occasions" title="Chaque occasion mérite un moment à partager.">
    <div class="occasions tu-rail">
      {occasions.map((occasion) => (
        <article class="tu-panel occasion" data-tu-apparait>
          <h3 class="occasion__title">{occasion.title}</h3>
          <p class="occasion__sous-titre">{occasion.sousTitre}</p>
          <p class="occasion__body">{occasion.body}</p>
        </article>
      ))}
    </div>
  </Section>

  <section class="why-section">
    <div class="tu-container why">
      <div class="why__visual">
        <PhonePhoto />
      </div>
      <div class="why__text">
        <div class="why__header">
          <p class="tu-eyebrow">Pourquoi ça marche</p>
          <h2 class="tu-title">Parce que les rencontres ne se décrètent pas. Elles se vivent.</h2>
        </div>
        <StepList steps={raisons} variant="plain" />
      </div>
    </div>
  </section>

  <Section
    id="programme"
    eyebrow="Exemple de soirée"
    title="Et si votre fête prenait des airs de jeu télévisé ?"
    tone="dark"
  >
    <Recit
      paragraphes={[
        "Les équipes sont formées. L'animateur présente le premier défi. Sur le grand écran, le chronomètre démarre.",
        "Les réponses se succèdent, les équipes se concertent, les points s'accumulent et les surprises ponctuent la partie.",
      ]}
    />
    <Timeline items={programme} />
    <Recit
      paragraphes={[
        "Entre les manches, les invités poursuivent leur Photo challenge. Leurs créations sont dévoilées lors d'un final collectif, avant le podium.",
        {
          texte:
            "Ici, les candidats, ce sont vos invités. Et le plus beau résultat, c'est ce qu'ils auront partagé.",
          fort: true,
        },
      ]}
    />
    <Button slot="action" href="/les-jeux" variant="outline" size="cta">
      Découvrir les sept jeux
    </Button>
  </Section>

  <section class="multi-section">
    <div class="tu-container multi">
      <div class="multi__text">
        <p class="tu-eyebrow">Sur mesure</p>
        <h2 class="tu-title">Une expérience pensée pour vos invités.</h2>
        <p class="multi__body">
          Chaque événement est différent. Nous adaptons le programme à sa durée, à la composition de
          vos invités, aux langues parlées et, si nécessaire, aux possibilités de déplacement ou de
          participation de chacun.
        </p>
        <p class="multi__body">
          Pas besoin d'être expert en quiz, particulièrement extraverti ou à l'aise devant un public
          : l'important est de prendre plaisir à jouer ensemble.
        </p>
      </div>
      <div class="multi__visual">
        <PhoneLang />
      </div>
    </div>
  </section>

  <Section eyebrow="Questions fréquentes" title="Avant de vous lancer." layout="aside">
    <Faq items={faq} />
  </Section>

  <CtaBanner
    title="Offrez à vos invités un souvenir commun."
    note="Parlons de votre événement et imaginons une expérience qui vous ressemble, avec ce supplément de convivialité qui fait toute la différence."
    label="Demander mon devis gratuit"
    href="/devis?type=particulier"
  />
</Base>

<style>
  .occasions {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--tu-space-5);
  }

  .occasion {
    display: flex;
    flex-direction: column;
    gap: var(--tu-space-3);
    padding: var(--tu-space-8);
  }

  .occasion__title {
    font-size: 1.375rem;
  }

  .occasion__sous-titre {
    font-weight: 600;
  }

  .occasion__body {
    color: var(--tu-text-muted);
  }

  .why-section,
  .multi-section {
    padding-bottom: var(--tu-section-space);
  }

  .why,
  .multi {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--tu-space-20);
    align-items: center;
  }

  .why__visual,
  .multi__visual {
    display: flex;
    justify-content: center;
  }

  .why__text,
  .multi__text {
    display: flex;
    flex-direction: column;
    gap: var(--tu-space-9);
  }

  .why__header {
    display: flex;
    flex-direction: column;
    gap: var(--tu-space-3);
  }

  .multi__text {
    gap: var(--tu-space-5);
  }

  .multi__body {
    font-size: 1.125rem;
    color: var(--tu-text-muted);
  }

  @media (max-width: 75rem) {
    .occasions {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 60rem) {
    /* Téléphone : mêmes visuels que sur ordinateur ; les occasions glissent en rangée (.tu-rail). */
    .occasion {
      gap: var(--tu-space-2);
      padding: var(--tu-space-6) 1.375rem;
    }

    .occasion__title {
      font-size: var(--tu-size-lg);
    }

    .why,
    .multi {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--tu-space-6);
    }

    /* Le titre, puis le téléphone, puis les raisons : le bloc de texte s'efface pour les ranger. */
    .why__text {
      display: contents;
    }

    .why__visual {
      order: 1;
    }

    .why :global(.steps) {
      order: 2;
    }

    .multi__body {
      font-size: var(--tu-size-base);
    }
  }
</style>
