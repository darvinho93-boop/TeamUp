---
import Base from '../layouts/Base.astro';
import Button from '@teamup/ui/astro/Button.astro';
import PageIntro from '../components/layout/PageIntro.astro';
import Section from '../components/layout/Section.astro';
import StepList from '../components/layout/StepList.astro';
import CtaBanner from '../components/layout/CtaBanner.astro';
import Faq from '../components/layout/Faq.astro';
import type { FaqItem } from '../components/layout/Faq.astro';
import ScreenTeams from '../components/visuels/ScreenTeams.astro';
import PhoneSecret from '../components/visuels/PhoneSecret.astro';
import PhonePhoto from '../components/visuels/PhonePhoto.astro';
import PhoneLang from '../components/visuels/PhoneLang.astro';
import Stage from '../components/visuels/Stage.astro';
import Timeline from '../components/jeux/Timeline.astro';
import type { TimelineItem } from '../components/jeux/Timeline.astro';

const occasions = [
  {
    title: 'Anniversaire',
    body: "Amis d'enfance, collègues, famille : tous les cercles de la personne fêtée se rencontrent enfin, et jouent ensemble.",
  },
  {
    title: 'Mariage',
    body: "Les deux familles et les deux bandes d'amis dans les mêmes équipes, entre le dîner et l'ouverture du bal.",
  },
  {
    title: 'Anniversaire de mariage',
    body: 'Plusieurs générations réunies autour du couple, avec des jeux que chacun comprend en une phrase.',
  },
  {
    title: 'Fête de famille',
    body: 'Cousins éloignés, nouvelles pièces rapportées, petits et grands : chacun repart en connaissant les autres.',
  },
];

const raisons = [
  {
    title: "Des équipes mélangées d'office",
    body: "En arrivant, chaque invité indique de quel côté il vient : famille, amis, collègues. Il rejoint l'équipe où les siens sont les moins nombreux.",
  },
  {
    title: 'Tout le monde debout, personne sur son écran',
    body: 'Le téléphone sert à rejoindre la partie, recevoir un secret ou envoyer une photo. Tout le reste se joue dans la salle, ensemble.',
  },
  {
    title: 'Les héros de la fête au centre',
    body: 'Ce sont eux qui désignent les plus belles photos de la soirée, devant tous leurs invités.',
  },
];

const programme: TimelineItem[] = [
  { label: 'Points communs', seconds: 520, tone: 'navy' },
  { label: 'Quiz', seconds: 120, tone: 'sage' },
  { label: 'Surenchère', seconds: 360, tone: 'amber' },
  { label: 'Mime', seconds: 600, tone: 'mint' },
  { label: 'Final photo', seconds: 300, tone: 'stone' },
  { label: 'Podium', seconds: 220, tone: 'muted' },
];

/* Réponses tirées de la spec v3 ; les chiffres commerciaux restent entre crochets. */
const faq: FaqItem[] = [
  {
    question: "Pour combien d'invités ?",
    answer:
      "De [MIN] à [MAX] invités. Le nombre d'équipes et le programme s'adaptent à votre liste.",
  },
  {
    question: "Combien de temps dure l'animation ?",
    answer:
      "Environ 40 minutes de jeu jusqu'à cinq équipes, une heure au-delà. Les photos, elles, se prennent tout au long de la soirée, entre deux jeux.",
  },
  {
    question: 'Mes invités doivent-ils installer une application ?',
    answer:
      "Non. Ils scannent le QR code affiché sur le grand écran, choisissent leur langue et entrent leur prénom : c'est tout. Ni application, ni compte, ni adresse e-mail.",
  },
  {
    question: 'De quoi avez-vous besoin sur place ?',
    answer:
      "D'un vidéoprojecteur ou d'un grand écran, d'une sono avec micro, d'un peu d'espace au sol et d'une connexion Wi-Fi ou 4G. Nous apportons tout le reste : l'animation, les jeux et les accessoires.",
  },
  {
    question: 'Quelles langues sont disponibles ?',
    answer:
      'Celles de vos invités. Indiquez-les dans votre demande : nous traduisons les contenus de la soirée et les relisons avec vous. Chaque invité choisit ensuite la sienne sur son téléphone.',
  },
  {
    question: 'Combien ça coûte ?',
    answer:
      "À partir de [PRIX] €. Le tarif dépend du nombre d'invités, de la durée et du lieu de la soirée. Le devis est gratuit et sans engagement.",
  },
];
---

<Base
  title="Anniversaire, mariage, fête de famille — Team Up!"
  description="Mariage, anniversaire, fête de famille : un animateur Team Up! mélange vos invités en équipes et fait de votre soirée un souvenir partagé."
>
  <PageIntro
    eyebrow="Particuliers"
    title="Une fête où tout le monde finit par se parler."
    lead="Mariage, anniversaire, fête de famille : nous transformons des tablées qui s'observent en équipes qui rient ensemble. Vous, vous profitez de vos invités."
  >
    <p slot="footnote" class="intro-note">
      Devis gratuit et sans engagement · à partir de [PRIX] €
    </p>
    <Fragment slot="actions">
      <Button href="/devis?type=particulier" variant="accent" size="cta">
        Demander un devis
      </Button>
      <Button href="#programme" variant="outline" size="cta">
        Voir un exemple de soirée
      </Button>
    </Fragment>
    <Stage slot="visual" class="hero-stage">
      <ScreenTeams slot="screen" />
      <PhoneSecret slot="phone" class="desktop-only" />
    </Stage>
  </PageIntro>

  <Section eyebrow="Les occasions" title="Dès que plusieurs cercles se retrouvent.">
    <div class="occasions">
      {occasions.map((occasion) => (
        <article class="tu-panel occasion">
          <h3 class="occasion__title">{occasion.title}</h3>
          <p class="occasion__body">{occasion.body}</p>
        </article>
      ))}
    </div>
  </Section>

  <section class="why-section">
    <div class="tu-container why">
      <div class="why__visual desktop-only">
        <PhonePhoto />
      </div>
      <div class="why__text">
        <div class="why__header">
          <p class="tu-eyebrow">Pourquoi ça marche</p>
          <h2 class="tu-title">Le mélange ne se fait pas tout seul. On l'organise.</h2>
        </div>
        <StepList steps={raisons} variant="plain" />
      </div>
    </div>
  </section>

  <Section
    id="programme"
    eyebrow="Exemple de soirée"
    title="Cinq jeux, un final en photos."
    tone="dark"
  >
    <Timeline items={programme} />
    <p class="programme__note">
      Les photos se prennent tout au long de la soirée, entre deux jeux, puis sont dévoilées en
      grand avant le podium. Le programme s'ajuste au nombre de vos invités.
    </p>
  </Section>

  <section class="multi-section">
    <div class="tu-container multi">
      <div class="multi__text">
        <p class="tu-eyebrow">Multilingue</p>
        <h2 class="tu-title">Chacun joue dans sa langue.</h2>
        <p class="multi__body">
          Vos invités ne parlent pas tous la même langue ? Chacun choisit la sienne en rejoignant la
          partie, et les contenus sont traduits pour votre soirée, relus avec vous. Les jeux, eux,
          reposent sur le geste et le mouvement plus que sur les mots.
        </p>
      </div>
      <div class="multi__visual">
        <PhoneLang />
      </div>
    </div>
  </section>

  <Section eyebrow="Questions fréquentes" title="Avant de vous lancer." layout="aside">
    <Faq items={faq} />
  </Section>

  <CtaBanner title="Racontez-nous votre fête." href="/devis?type=particulier" />
</Base>

<style>
  .intro-note {
    font-size: var(--tu-size-sm);
    color: var(--tu-text-muted);
  }

  .occasions {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--tu-space-5);
  }

  .occasion {
    display: flex;
    flex-direction: column;
    gap: var(--tu-space-3);
    padding: var(--tu-space-8);
  }

  .occasion__title {
    font-size: 1.375rem;
  }

  .occasion__body {
    color: var(--tu-text-muted);
  }

  .why-section,
  .multi-section {
    padding-bottom: var(--tu-section-space);
  }

  .why,
  .multi {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--tu-space-20);
    align-items: center;
  }

  .why__visual,
  .multi__visual {
    display: flex;
    justify-content: center;
  }

  .why__text,
  .multi__text {
    display: flex;
    flex-direction: column;
    gap: var(--tu-space-9);
  }

  .why__header {
    display: flex;
    flex-direction: column;
    gap: var(--tu-space-3);
  }

  .multi__text {
    gap: var(--tu-space-5);
  }

  .multi__body {
    font-size: 1.125rem;
    color: var(--tu-text-muted);
  }

  .programme__note {
    max-width: 47.5rem;
    color: var(--tu-text-muted);
  }

  @media (max-width: 75rem) {
    .occasions {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 60rem) {
    /* Mobile : écran des équipes seul, et pas de téléphone à côté de « Pourquoi ça marche ». */
    .desktop-only,
    :global(.stage.hero-stage .desktop-only) {
      display: none;
    }

    :global(.stage.hero-stage) {
      min-height: 0;
    }

    :global(.stage.hero-stage .stage__screen) {
      position: static;
      width: 100%;
    }

    .occasions {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--tu-space-3);
    }

    .occasion {
      gap: var(--tu-space-2);
      padding: var(--tu-space-6) 1.375rem;
    }

    .occasion__title {
      font-size: var(--tu-size-lg);
    }

    .why,
    .multi {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--tu-space-6);
    }

    .why__text {
      gap: var(--tu-space-5);
    }

    .multi__body {
      font-size: var(--tu-size-base);
    }
  }
</style>
