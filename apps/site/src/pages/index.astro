---
import Base from '../layouts/Base.astro';
import Button from '@teamup/ui/astro/Button.astro';
import PageIntro from '../components/layout/PageIntro.astro';
import Section from '../components/layout/Section.astro';
import CtaBanner from '../components/layout/CtaBanner.astro';
import Icon from '../components/Icon.astro';
import Stage from '../components/visuels/Stage.astro';
import ScreenQuiz from '../components/visuels/ScreenQuiz.astro';
import PhoneWaiting from '../components/visuels/PhoneWaiting.astro';

const apports = [
  {
    axe: "L'émotion",
    title: 'Une émotion qui se partage',
    body: "Des inconnus qui rient ensemble, plusieurs générations dans la même équipe, des photos que l'on garde. Vos invités repartent avec une soirée en commun, et vous avec la fierté de les avoir réunis.",
  },
  {
    axe: 'La sérénité',
    title: 'Tout est prêt avant vos invités',
    body: "Un seul interlocuteur, du premier échange au podium. Tout se prépare avec vous avant la soirée ; le jour venu, l'animateur arrive en avance, installe et teste. Il ne vous reste qu'à accueillir.",
  },
  {
    axe: 'Le nombre',
    title: "Toute la salle, jusqu'à 150 invités",
    body: "Personne ne reste à sa table. Les équipes se forment dès l'arrivée, et tout le monde joue en même temps, debout, dans la salle. L'animateur tient le rythme du début à la fin.",
  },
];

const portes = [
  {
    icon: 'mime',
    tone: 'sage',
    title: 'Les jeux',
    body: 'Cinq jeux où toute la salle se lève, se mélange et rit, quelle que soit la langue de chacun.',
    liens: [{ href: '/les-jeux', label: 'Voir les jeux' }],
  },
  {
    icon: 'screen',
    tone: 'amber',
    title: 'Comment ça marche',
    body: "De votre demande au podium : ce que nous préparons avec vous, et tout ce dont vous n'aurez pas à vous occuper.",
    liens: [{ href: '/comment-ca-marche', label: 'Voir le déroulé' }],
  },
  {
    icon: 'checkCircle',
    tone: 'stone',
    title: 'Offres et devis',
    body: 'Une proposition sur mesure, pour une fête de famille comme pour un séminaire. Devis gratuit, sans engagement.',
    liens: [
      { href: '/particuliers', label: 'Offre particuliers' },
      { href: '/entreprises', label: 'Offre entreprises' },
    ],
  },
  {
    icon: 'users',
    tone: 'navy',
    title: 'Qui sommes-nous',
    body: "L'équipe derrière Team Up!, et ce qui nous a donné envie de faire jouer vos invités ensemble.",
    liens: [{ href: '/qui-sommes-nous', label: 'Nous découvrir' }],
  },
] as const;
---

<Base
  title="Team Up! — On joue. On se rencontre. On crée du lien."
  description="Animation de soirée pour mariages, anniversaires et séminaires : un animateur fait jouer toute votre salle. Des rires, des rencontres, et vous l'esprit libre."
>
  <PageIntro
    size="display"
    eyebrow="Animation de soirée sur mesure"
    title="La soirée où toute la salle rit ensemble."
    lead="Team Up! est une animation de soirée : un animateur fait jouer toute votre salle, en équipes mélangées, jusqu'à 150 invités. Vous n'avez rien à animer ni à surveiller : vous profitez de vos invités."
  >
    <Fragment slot="actions">
      <Button href="/devis" variant="accent" size="cta">
        Demander un devis
      </Button>
      <Button href="/les-jeux" variant="outline" size="cta">
        Voir les jeux
      </Button>
    </Fragment>
    <p slot="footnote" class="intro-note">
      Anniversaires · mariages · fêtes de famille · séminaires · team building
    </p>
    <Stage slot="visual">
      <ScreenQuiz slot="screen" />
      <PhoneWaiting
        slot="phone"
        name="Léa"
        team="Équipe 3"
        teamClass="tu-team--3"
        hint="Retrouve les joueurs en vert."
        score="240 pts"
        next="Prochain jeu : Mime"
      />
    </Stage>
  </PageIntro>

  <Section
    class="apports-section"
    title="Des rires pour vos invités. L'esprit libre pour vous."
    tone="dark"
  >
    <div class="apports">
      {apports.map((apport) => (
        <article class="apport">
          <p class="tu-eyebrow">{apport.axe}</p>
          <h3 class="apport__title">{apport.title}</h3>
          <p class="apport__body">{apport.body}</p>
        </article>
      ))}
    </div>
  </Section>

  <section class="portes-section" aria-label="Découvrir Team Up!">
    <div class="tu-container portes">
      {portes.map((porte) => (
        <article class:list={['tu-panel', 'porte', porte.liens.length === 1 && 'porte--lien']}>
          <span class:list={['porte__icon', `porte__icon--${porte.tone}`]}>
            <Icon name={porte.icon} size="md" />
          </span>
          <h2 class="porte__title">{porte.title}</h2>
          <p class="porte__body">{porte.body}</p>
          <div class="porte__liens">
            {porte.liens.map((lien) => (
              <a class="tu-arrow-link" href={lien.href}>
                {lien.label}
                <Icon name="arrow" size="sm" />
              </a>
            ))}
          </div>
        </article>
      ))}
    </div>
  </section>

  <Section title="Ils ont joué.">
    <div class="quotes">
      <figure class="tu-panel quote">
        <blockquote class="quote__text">« [CITATION CLIENT PARTICULIER] »</blockquote>
        <figcaption class="quote__author">[Prénom], [occasion], [ville]</figcaption>
      </figure>
      <figure class="tu-panel quote">
        <blockquote class="quote__text">« [CITATION CLIENT ENTREPRISE] »</blockquote>
        <figcaption class="quote__author">[Prénom], [fonction], [entreprise]</figcaption>
      </figure>
    </div>
  </Section>

  <CtaBanner title="Parlez-nous de votre événement." />
</Base>

<style>
  .intro-note {
    font-size: var(--tu-size-sm);
    color: var(--tu-text-muted);
  }

  /* Les trois apports : l'émotion, la sérénité, le nombre. Titre en deux lignes égales. */
  .apports-section :global(.tu-title) {
    text-wrap: balance;
  }

  .apports {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--tu-space-10);
  }

  .apport {
    display: flex;
    flex-direction: column;
    gap: var(--tu-space-3);
  }

  .apport__title {
    font-size: var(--tu-type-card);
  }

  .apport__body {
    line-height: var(--tu-leading-normal);
    color: var(--tu-text-muted);
  }

  /* Les quatre portes : l'accueil résume, les pages intérieures détaillent. */
  .portes-section {
    padding-bottom: var(--tu-section-space);
  }

  .portes {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--tu-space-5);
  }

  .porte {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--tu-space-3);
    padding: var(--tu-space-7);
  }

  .porte__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    align-self: flex-start;
    width: var(--tu-space-14);
    height: var(--tu-space-14);
    margin-bottom: var(--tu-space-1);
    border-radius: var(--tu-radius-md);
    color: var(--tu-primary);
  }

  .porte__icon--navy {
    background: var(--tu-navy-50);
  }

  .porte__icon--sage {
    background: var(--tu-sage-50);
    color: var(--tu-success-text);
  }

  .porte__icon--amber {
    background: var(--tu-amber-50);
    color: var(--tu-warning-text);
  }

  .porte__icon--stone {
    background: var(--tu-stone-200);
  }

  .porte__title {
    font-size: var(--tu-type-card);
  }

  .porte__body {
    flex: 1;
    line-height: var(--tu-leading-normal);
    color: var(--tu-text-muted);
  }

  .porte__liens {
    display: flex;
    flex-direction: column;
  }

  /* Une seule destination : toute la carte se clique. */
  .porte--lien .tu-arrow-link::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--tu-radius-lg);
  }

  .quotes {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--tu-space-8);
  }

  .quote {
    display: flex;
    flex-direction: column;
    gap: var(--tu-space-5);
    margin: 0;
    padding: var(--tu-space-10);
  }

  .quote__text {
    margin: 0;
    font-size: 1.375rem;
    line-height: 1.5;
  }

  .quote__author {
    font-size: var(--tu-btn-sm-font);
    color: var(--tu-text-muted);
  }

  @media (max-width: 75rem) {
    .portes {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 60rem) {
    .apports,
    .portes,
    .quotes {
      grid-template-columns: minmax(0, 1fr);
    }

    .apports {
      gap: var(--tu-space-7);
    }

    .portes {
      gap: var(--tu-space-3);
    }

    .quotes {
      gap: var(--tu-space-5);
    }

    /* Mobile : pictogramme à gauche, texte à droite, comme les cartes de jeu. */
    .porte {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      column-gap: var(--tu-space-4);
      row-gap: var(--tu-space-1);
      padding: var(--tu-space-5);
    }

    .porte__icon {
      grid-row: span 3;
      width: var(--tu-space-12);
      height: var(--tu-space-12);
      margin-bottom: 0;
    }

    .quote {
      gap: var(--tu-space-3);
      padding: 1.625rem 1.375rem;
    }

    .quote__text {
      font-size: 1.125rem;
    }

    .quote__author {
      font-size: var(--tu-size-sm);
    }
  }
</style>
