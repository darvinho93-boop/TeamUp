---
import Base from '../layouts/Base.astro';
import Button from '@teamup/ui/astro/Button.astro';
import PageIntro from '../components/layout/PageIntro.astro';
import Section from '../components/layout/Section.astro';
import Recit from '../components/layout/Recit.astro';
import CtaBanner from '../components/layout/CtaBanner.astro';
import Icon from '../components/Icon.astro';
import VideoEcran from '../components/visuels/VideoEcran.astro';
import { MARQUE } from '../data/marque';
import { PREUVES_FOURNIES } from '../data/preuves';

/* Refonte éditoriale du 2026-11-18 (« Des mots pour créer des liens »). */

/** Les deux publics, à parts égales : chacun sa page. */
const evenements = [
  {
    icon: 'users',
    tone: 'sage',
    title: 'Événements privés',
    sousTitre: "Pour que vos invités partagent bien plus qu'une invitation.",
    body: "Mariages, anniversaires ou fêtes de famille : Team Up! fait se rencontrer les générations, les familles et les cercles d'amis à travers une expérience conviviale et originale.",
    lien: { href: '/particuliers', label: 'Découvrir les événements privés' },
  },
  {
    icon: 'checkCircle',
    tone: 'navy',
    title: 'Événements professionnels',
    sousTitre: 'Pour que vos collaborateurs se découvrent autrement.',
    body: "Team buildings, séminaires, journées d'intégration : offrez à vos équipes une occasion de se rencontrer au-delà des fonctions, des services et des habitudes professionnelles.",
    lien: { href: '/entreprises', label: "Découvrir les événements d'entreprise" },
  },
] as const;

const apports = [
  {
    title: 'Des équipes qui créent la rencontre',
    body: 'Les participants sont répartis pour favoriser les échanges entre personnes qui ne se côtoient pas habituellement.',
  },
  {
    title: 'Des jeux qui font participer',
    body: 'Observation, réflexion, créativité, musique ou défis collectifs : chacun peut trouver sa place dans une expérience accessible et adaptable.',
  },
  {
    title: 'Un animateur qui donne le rythme',
    body: 'Questions, chronomètres, révélations et classement final : tout est réuni pour retrouver le suspense et la convivialité des jeux télévisés.',
  },
  {
    title: 'Une prestation préparée avec vous',
    body: "Du choix des jeux à l'animation le jour J, nous construisons une expérience adaptée à votre événement pour que vous puissiez en profiter pleinement.",
  },
];

const etapes = [
  {
    title: 'On prépare ensemble.',
    body: "Nous échangeons sur votre événement, vos invités et l'ambiance que vous souhaitez créer.",
  },
  {
    title: 'Les équipes se forment.',
    body: 'Les participants rejoignent la partie depuis leur téléphone, sans application à installer.',
  },
  {
    title: 'Le jeu prend vie.',
    body: "L'animateur mène les défis, le grand écran rassemble les regards et les équipes entrent dans le jeu.",
  },
  {
    title: 'Les souvenirs restent.',
    body: 'Entre révélations, photos et podium final, chacun repart avec une expérience partagée.',
  },
];
---

<Base
  title="Animation de soirée, mariage, team building — Team Up!"
  description="Le jeu télévisé s'invite à votre événement : mariages, anniversaires, séminaires, partout en France. Vous les réunissez, le jeu les rapproche."
  imagePrioritaire="/videos/boucle-accueil.jpg"
>
  <PageIntro
    size="display"
    eyebrow="Animation événementielle · Particuliers & entreprises"
    title="Le jeu télévisé s'invite à votre événement."
    chapo="Et si vos invités devenaient les candidats d'une expérience à vivre ensemble ?"
    lead="Avec Team Up!, mariages, anniversaires, séminaires et événements d'entreprise prennent une nouvelle dimension. Des équipes qui se découvrent, des défis qui rassemblent, un grand écran et un animateur pour donner vie à l'expérience."
    fort="Vous les réunissez. Le jeu les rapproche."
  >
    <Fragment slot="actions">
      <Button href="/devis" variant="accent" size="cta">
        Demander un devis
      </Button>
      <Button href="/comment-ca-marche" variant="outline" size="cta">
        Découvrir l'expérience
      </Button>
    </Fragment>
    <VideoEcran
      slot="visual"
      src="/videos/boucle-accueil.mp4"
      srcMobile="/videos/boucle-accueil-mobile.mp4"
      affiche="/videos/boucle-accueil.jpg"
      caption="Vidéo : sur un plateau de jeu télé, cinq des jeux de Team Up! sont rejoués tour à tour par de petits personnages, puis trois équipes montent sur le podium sous les confettis."
    />
  </PageIntro>

  <Section title="Réunir des personnes est une chose. Les rapprocher en est une autre.">
    <Recit
      paragraphes={[
        "Lors d'un événement, chacun retrouve naturellement ses proches, ses amis ou ses collègues habituels.",
        "On partage un même lieu, une même occasion, sans toujours avoir l'opportunité de véritablement se rencontrer.",
        "Team Up! est né de cette observation et d'une idée simple : et si l'on empruntait aux jeux télévisés leur formidable capacité à réunir des personnes autour d'une aventure commune ?",
        "Le temps d'une partie, les habitudes s'effacent. Les invités deviennent coéquipiers, les échanges se multiplient et les souvenirs commencent à se construire.",
      ]}
    />
  </Section>

  <Section title="Une expérience qui rassemble, quel que soit l'événement.">
    <div class="portes portes--deux tu-rail">
      {evenements.map((evenement) => (
        <article class="tu-panel porte porte--lien" data-tu-apparait>
          <span class:list={['porte__icon', `porte__icon--${evenement.tone}`]}>
            <Icon name={evenement.icon} size="md" />
          </span>
          <h3 class="porte__title">{evenement.title}</h3>
          <p class="porte__sous-titre">{evenement.sousTitre}</p>
          <p class="porte__body">{evenement.body}</p>
          <div class="porte__liens">
            <a class="tu-arrow-link" href={evenement.lien.href}>
              {evenement.lien.label}
              <Icon name="arrow" size="sm" />
            </a>
          </div>
        </article>
      ))}
    </div>
  </Section>

  <Section
    class="apports-section"
    title="L'énergie d'un plateau télé. Le plaisir d'être ensemble."
    tone="dark"
  >
    <div class="apports">
      {apports.map((apport) => (
        <article class="apport" data-tu-apparait>
          <h3 class="apport__title">{apport.title}</h3>
          <p class="apport__body">{apport.body}</p>
        </article>
      ))}
    </div>
  </Section>

  <section class="portes-section" aria-label="Les jeux et le déroulement">
    <div class="tu-container">
      <div class="portes portes--deux tu-rail">
        <article class="tu-panel porte porte--lien" data-tu-apparait>
          <span class="porte__icon porte__icon--sage">
            <Icon name="mime" size="md" />
          </span>
          <h2 class="porte__title">Sept jeux. Des personnalités différentes. Une même aventure.</h2>
          <p class="porte__body porte__body--court">
            Un point commun inattendu, une réponse qui surprend, une musique que tout le monde
            reconnaît, un défi photo qui fait sourire…
          </p>
          <p class="porte__body">
            Chaque jeu devient un prétexte pour échanger, coopérer et partager un moment dont on se
            souvient.
          </p>
          <div class="porte__liens">
            <a class="tu-arrow-link" href="/les-jeux">
              Explorer les jeux
              <Icon name="arrow" size="sm" />
            </a>
          </div>
        </article>

        <article class="tu-panel porte porte--lien" data-tu-apparait>
          <span class="porte__icon porte__icon--amber">
            <Icon name="screen" size="md" />
          </span>
          <h2 class="porte__title">Une expérience simple à rejoindre, agréable à vivre.</h2>
          <ol class="porte__etapes">
            {etapes.map((etape, index) => (
              <li class="porte__etape">
                <span class="porte__etape-numero" aria-hidden="true">
                  {String(index + 1).padStart(2, '0')}
                </span>
                <span>
                  <strong class="porte__etape-titre">{etape.title}</strong> {etape.body}
                </span>
              </li>
            ))}
          </ol>
          <div class="porte__liens">
            <a class="tu-arrow-link" href="/comment-ca-marche">
              Comprendre le déroulement
              <Icon name="arrow" size="sm" />
            </a>
          </div>
        </article>
      </div>
    </div>
  </section>

  {PREUVES_FOURNIES && (
    <Section title="Ils ont joué.">
      <div class="quotes">
        <figure class="tu-panel quote">
          <blockquote class="quote__text">« [CITATION CLIENT PARTICULIER] »</blockquote>
          <figcaption class="quote__author">[Prénom], [occasion], [ville]</figcaption>
        </figure>
        <figure class="tu-panel quote">
          <blockquote class="quote__text">« [CITATION CLIENT ENTREPRISE] »</blockquote>
          <figcaption class="quote__author">[Prénom], [fonction], [entreprise]</figcaption>
        </figure>
      </div>
    </Section>
  )}

  <CtaBanner
    title="Et si votre prochain événement créait de nouvelles rencontres ?"
    note="Une fête privée ou un événement professionnel en préparation ? Imaginons ensemble une expérience à la hauteur de ce moment."
    signature={MARQUE.slogan}
    label="Demander un devis gratuit"
  />
</Base>

<style>
  /* Les quatre apports du plateau télé, deux par deux. Titre en deux lignes égales. */
  .apports-section :global(.tu-title) {
    text-wrap: balance;
  }

  .apports {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--tu-space-10);
  }

  .apport {
    display: flex;
    flex-direction: column;
    gap: var(--tu-space-3);
  }

  .apport__title {
    font-size: var(--tu-type-card);
  }

  .apport__body {
    line-height: var(--tu-leading-normal);
    color: var(--tu-text-muted);
  }

  /* Les cartes de l'accueil : il résume, les pages intérieures détaillent. Deux par rangée. */
  .portes-section {
    padding-bottom: var(--tu-section-space);
  }

  .portes {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--tu-space-5);
  }

  .portes--deux {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .porte {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--tu-space-3);
    padding: var(--tu-space-7);
  }

  .porte__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    align-self: flex-start;
    width: var(--tu-space-14);
    height: var(--tu-space-14);
    margin-bottom: var(--tu-space-1);
    border-radius: var(--tu-radius-md);
    color: var(--tu-primary);
  }

  .porte__icon--navy {
    background: var(--tu-navy-50);
  }

  .porte__icon--sage {
    background: var(--tu-sage-50);
    color: var(--tu-success-text);
  }

  .porte__icon--amber {
    background: var(--tu-amber-50);
    color: var(--tu-warning-text);
  }

  .porte__icon--stone {
    background: var(--tu-stone-200);
  }

  .porte__title {
    font-size: var(--tu-type-card);
  }

  .porte__sous-titre {
    font-weight: 600;
    line-height: var(--tu-leading-normal);
  }

  .porte__body {
    flex: 1;
    line-height: var(--tu-leading-normal);
    color: var(--tu-text-muted);
  }

  .porte__body--court {
    flex: none;
  }

  .porte__etapes {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--tu-space-3);
    line-height: var(--tu-leading-normal);
    color: var(--tu-text-muted);
  }

  .porte__etape {
    display: flex;
    gap: var(--tu-space-3);
  }

  .porte__etape-numero {
    flex: none;
    font-family: var(--tu-font-display);
    font-weight: 700;
    color: var(--tu-success-text);
  }

  .porte__etape-titre {
    font-weight: 600;
    color: var(--tu-text);
  }

  .porte__liens {
    display: flex;
    flex-direction: column;
  }

  /* Au survol, la carte se soulève. Seule son apparition suit la cascade, pas le survol. */
  @media (prefers-reduced-motion: no-preference) {
    .porte.porte--lien {
      transition:
        opacity var(--tu-dur-reveal) var(--tu-ease),
        translate var(--tu-dur-reveal) var(--tu-ease),
        transform var(--tu-dur-base) var(--tu-ease),
        box-shadow var(--tu-dur-base) var(--tu-ease);
      transition-delay:
        calc(var(--tu-apparait-rang, 0) * var(--tu-dur-cascade)),
        calc(var(--tu-apparait-rang, 0) * var(--tu-dur-cascade)), 0s, 0s;
    }

    .porte.porte--lien:hover {
      transform: translateY(calc(var(--tu-space-1) * -1));
      box-shadow: var(--tu-shadow-lift);
    }
  }

  /* Une seule destination : toute la carte se clique. */
  .porte--lien .tu-arrow-link::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--tu-radius-lg);
  }

  .quotes {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--tu-space-8);
  }

  .quote {
    display: flex;
    flex-direction: column;
    gap: var(--tu-space-5);
    margin: 0;
    padding: var(--tu-space-10);
  }

  .quote__text {
    margin: 0;
    font-size: 1.375rem;
    line-height: 1.5;
  }

  .quote__author {
    font-size: var(--tu-btn-sm-font);
    color: var(--tu-text-muted);
  }

  @media (max-width: 60rem) {
    .apports,
    .quotes {
      grid-template-columns: minmax(0, 1fr);
    }

    .apports {
      gap: var(--tu-space-7);
    }

    .quotes {
      gap: var(--tu-space-5);
    }

    /* Téléphone : les mêmes cartes que sur ordinateur, en rangée à faire glisser (.tu-rail). */
    .porte {
      padding: var(--tu-space-6);
    }

    .quote {
      gap: var(--tu-space-3);
      padding: 1.625rem 1.375rem;
    }

    .quote__text {
      font-size: 1.125rem;
    }

    .quote__author {
      font-size: var(--tu-size-sm);
    }
  }
</style>
