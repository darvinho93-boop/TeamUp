---
import Base from '../layouts/Base.astro';
import Button from '@teamup/ui/astro/Button.astro';
import PageIntro from '../components/layout/PageIntro.astro';
import Section from '../components/layout/Section.astro';
import CtaBanner from '../components/layout/CtaBanner.astro';
import Icon from '../components/Icon.astro';
import VideoEcran from '../components/visuels/VideoEcran.astro';
import { PREUVES_FOURNIES } from '../data/preuves';

const apports = [
  {
    title: 'Une émotion qui se partage',
    body: "Des inconnus qui rient ensemble, plusieurs générations dans la même équipe, des photos que l'on garde. Vos invités repartent avec une soirée en commun, et vous avec la fierté de les avoir réunis.",
  },
  {
    title: 'Tout est prêt avant vos invités',
    body: "Un seul interlocuteur, du premier échange au podium. Tout se prépare avec vous avant la soirée ; le jour venu, l'animateur arrive en avance, installe et teste. Il ne vous reste qu'à accueillir.",
  },
  {
    title: "Toute la salle, jusqu'à 150 invités",
    body: "Personne ne reste à sa table. Les équipes se forment dès l'arrivée, et tout le monde joue en même temps, debout, dans la salle. L'animateur tient le rythme du début à la fin.",
  },
];

const portes = [
  {
    icon: 'mime',
    tone: 'sage',
    title: 'Cinq jeux, toute la salle debout',
    body: 'On se lève, on se mélange, on rit, quelle que soit la langue de chacun.',
    liens: [{ href: '/les-jeux', label: 'Voir les jeux' }],
  },
  {
    icon: 'screen',
    tone: 'amber',
    title: 'Du premier échange au podium',
    body: "Ce que nous préparons avec vous, et tout ce dont vous n'aurez pas à vous occuper.",
    liens: [{ href: '/comment-ca-marche', label: 'Voir le déroulé' }],
  },
  {
    icon: 'checkCircle',
    tone: 'stone',
    title: 'Un devis sur mesure',
    body: 'Une proposition pensée pour votre événement, fête de famille ou séminaire. Gratuit, sans engagement.',
    liens: [{ href: '/devis', label: 'Demander un devis' }],
  },
] as const;
---

<Base
  title="Animation de soirée, mariage, team building — Team Up!"
  description="Animation de soirée pour mariages, anniversaires et séminaires : un animateur fait jouer toute votre salle. Des rires, des rencontres, et vous l'esprit libre."
>
  <PageIntro
    size="display"
    eyebrow="Animation de soirée sur mesure"
    title="La soirée où toute la salle rit ensemble."
    lead="Team Up! est une animation de soirée : un animateur fait jouer toute votre salle, en équipes mélangées, jusqu'à 150 invités. Vous n'avez rien à animer ni à surveiller : vous profitez de vos invités."
  >
    <Fragment slot="actions">
      <Button href="/devis" variant="accent" size="cta">
        Demander un devis
      </Button>
      <Button href="/les-jeux" variant="outline" size="cta">
        Voir les jeux
      </Button>
    </Fragment>
    <nav slot="footnote" class="publics" aria-label="Nos offres">
      <a class="tu-arrow-link" href="/particuliers">
        Pour une fête ou un mariage
        <Icon name="arrow" size="sm" />
      </a>
      <a class="tu-arrow-link" href="/entreprises">
        Pour une entreprise
        <Icon name="arrow" size="sm" />
      </a>
    </nav>
    <VideoEcran
      slot="visual"
      src="/videos/boucle-accueil.mp4"
      affiche="/videos/boucle-accueil.jpg"
      caption="Vidéo : sur un plateau de jeu télé, les cinq jeux de Team Up! sont rejoués tour à tour par de petits personnages, puis trois équipes montent sur le podium sous les confettis."
    />
  </PageIntro>

  <Section
    class="apports-section"
    title="Des rires pour vos invités. L'esprit libre pour vous."
    tone="dark"
  >
    <div class="apports">
      {apports.map((apport) => (
        <article class="apport" data-tu-apparait>
          <h3 class="apport__title">{apport.title}</h3>
          <p class="apport__body">{apport.body}</p>
        </article>
      ))}
    </div>
  </Section>

  <section class="portes-section" aria-label="Découvrir Team Up!">
    <div class="tu-container portes">
      {portes.map((porte) => (
        <article
          class:list={['tu-panel', 'porte', porte.liens.length === 1 && 'porte--lien']}
          data-tu-apparait
        >
          <span class:list={['porte__icon', `porte__icon--${porte.tone}`]}>
            <Icon name={porte.icon} size="md" />
          </span>
          <h2 class="porte__title">{porte.title}</h2>
          <p class="porte__body">{porte.body}</p>
          <div class="porte__liens">
            {porte.liens.map((lien) => (
              <a class="tu-arrow-link" href={lien.href}>
                {lien.label}
                <Icon name="arrow" size="sm" />
              </a>
            ))}
          </div>
        </article>
      ))}
    </div>
  </section>

  {PREUVES_FOURNIES && (
    <Section title="Ils ont joué.">
      <div class="quotes">
        <figure class="tu-panel quote">
          <blockquote class="quote__text">« [CITATION CLIENT PARTICULIER] »</blockquote>
          <figcaption class="quote__author">[Prénom], [occasion], [ville]</figcaption>
        </figure>
        <figure class="tu-panel quote">
          <blockquote class="quote__text">« [CITATION CLIENT ENTREPRISE] »</blockquote>
          <figcaption class="quote__author">[Prénom], [fonction], [entreprise]</figcaption>
        </figure>
      </div>
    </Section>
  )}

  <CtaBanner title="Parlez-nous de votre événement." />
</Base>

<style>
  /* Les deux publics, sous les boutons : chacun sa page d'offre. */
  .publics {
    display: flex;
    flex-wrap: wrap;
    column-gap: var(--tu-space-8);
  }

  .publics .tu-arrow-link {
    font-size: var(--tu-size-base);
  }

  /* Les trois apports : l'émotion, la sérénité, le nombre. Titre en deux lignes égales. */
  .apports-section :global(.tu-title) {
    text-wrap: balance;
  }

  .apports {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--tu-space-10);
  }

  .apport {
    display: flex;
    flex-direction: column;
    gap: var(--tu-space-3);
  }

  .apport__title {
    font-size: var(--tu-type-card);
  }

  .apport__body {
    line-height: var(--tu-leading-normal);
    color: var(--tu-text-muted);
  }

  /* Les trois portes : l'accueil résume, les pages intérieures détaillent. */
  .portes-section {
    padding-bottom: var(--tu-section-space);
  }

  .portes {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--tu-space-5);
  }

  .porte {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--tu-space-3);
    padding: var(--tu-space-7);
  }

  .porte__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    align-self: flex-start;
    width: var(--tu-space-14);
    height: var(--tu-space-14);
    margin-bottom: var(--tu-space-1);
    border-radius: var(--tu-radius-md);
    color: var(--tu-primary);
  }

  .porte__icon--navy {
    background: var(--tu-navy-50);
  }

  .porte__icon--sage {
    background: var(--tu-sage-50);
    color: var(--tu-success-text);
  }

  .porte__icon--amber {
    background: var(--tu-amber-50);
    color: var(--tu-warning-text);
  }

  .porte__icon--stone {
    background: var(--tu-stone-200);
  }

  .porte__title {
    font-size: var(--tu-type-card);
  }

  .porte__body {
    flex: 1;
    line-height: var(--tu-leading-normal);
    color: var(--tu-text-muted);
  }

  .porte__liens {
    display: flex;
    flex-direction: column;
  }

  /* Au survol, la carte se soulève. Seule son apparition suit la cascade, pas le survol. */
  @media (prefers-reduced-motion: no-preference) {
    .porte.porte--lien {
      transition:
        opacity var(--tu-dur-reveal) var(--tu-ease),
        translate var(--tu-dur-reveal) var(--tu-ease),
        transform var(--tu-dur-base) var(--tu-ease),
        box-shadow var(--tu-dur-base) var(--tu-ease);
      transition-delay:
        calc(var(--tu-apparait-rang, 0) * var(--tu-dur-cascade)),
        calc(var(--tu-apparait-rang, 0) * var(--tu-dur-cascade)), 0s, 0s;
    }

    .porte.porte--lien:hover {
      transform: translateY(calc(var(--tu-space-1) * -1));
      box-shadow: var(--tu-shadow-lift);
    }
  }

  /* Une seule destination : toute la carte se clique. */
  .porte--lien .tu-arrow-link::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--tu-radius-lg);
  }

  .quotes {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--tu-space-8);
  }

  .quote {
    display: flex;
    flex-direction: column;
    gap: var(--tu-space-5);
    margin: 0;
    padding: var(--tu-space-10);
  }

  .quote__text {
    margin: 0;
    font-size: 1.375rem;
    line-height: 1.5;
  }

  .quote__author {
    font-size: var(--tu-btn-sm-font);
    color: var(--tu-text-muted);
  }

  @media (max-width: 60rem) {
    .apports,
    .portes,
    .quotes {
      grid-template-columns: minmax(0, 1fr);
    }

    .apports {
      gap: var(--tu-space-7);
    }

    .portes {
      gap: var(--tu-space-3);
    }

    .quotes {
      gap: var(--tu-space-5);
    }

    /* Mobile : pictogramme à gauche, texte à droite, comme les cartes de jeu. */
    .porte {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      column-gap: var(--tu-space-4);
      row-gap: var(--tu-space-1);
      padding: var(--tu-space-5);
    }

    .porte__icon {
      grid-row: span 3;
      width: var(--tu-space-12);
      height: var(--tu-space-12);
      margin-bottom: 0;
    }

    .quote {
      gap: var(--tu-space-3);
      padding: 1.625rem 1.375rem;
    }

    .quote__text {
      font-size: 1.125rem;
    }

    .quote__author {
      font-size: var(--tu-size-sm);
    }
  }
</style>
