---
import Base from '../layouts/Base.astro';
import Button from '@teamup/ui/astro/Button.astro';
import PageIntro from '../components/layout/PageIntro.astro';
import Section from '../components/layout/Section.astro';
import StepList from '../components/layout/StepList.astro';
import CtaBanner from '../components/layout/CtaBanner.astro';
import GameCard from '../components/jeux/GameCard.astro';
import Icon from '../components/Icon.astro';
import Stage from '../components/visuels/Stage.astro';
import ScreenQuiz from '../components/visuels/ScreenQuiz.astro';
import ScreenPodium from '../components/visuels/ScreenPodium.astro';
import ScreenJoin from '../components/visuels/ScreenJoin.astro';
import PhoneWaiting from '../components/visuels/PhoneWaiting.astro';
import { games } from '../data/jeux';

const steps = [
  {
    title: 'Vous nous parlez de votre événement',
    body: "L'occasion, vos invités, l'ambiance que vous imaginez. Nous revenons vers vous avec une proposition sur mesure.",
  },
  {
    title: 'Nous préparons tout avec vous',
    body: 'Groupes à mélanger, jeux, contenus et langues : chaque détail est pensé pour vos invités.',
  },
  {
    title: 'Le jour J, vous profitez',
    body: "Notre animateur fait jouer toute la salle. Vos invités rejoignent la partie d'un simple scan, sans rien installer.",
  },
];
---

<Base
  title="Team Up! — On joue. On se rencontre. On crée du lien."
  description="L'animation de soirée qui transforme vos invités en équipes : des rires, des jeux et de vraies rencontres. Mariages, anniversaires, séminaires, team building."
>
  <PageIntro
    size="display"
    eyebrow="Animation de soirée sur mesure"
    title="Vos invités arrivent en groupes. Ils repartent en équipe."
    lead="Un animateur Team Up! prend votre salle en main. Les tablées se mélangent, les rires fusent, et vos invités repartent en ayant vraiment fait connaissance. Vous, vous n'avez qu'à profiter."
  >
    <Fragment slot="actions">
      <Button href="/devis" variant="accent" size="cta">
        Demander un devis
      </Button>
      <Button href="/les-jeux" variant="outline" size="cta">
        Voir les jeux
      </Button>
    </Fragment>
    <p slot="footnote" class="intro-note">
      Anniversaires · mariages · fêtes de famille · séminaires · team building
    </p>
    <Stage slot="visual">
      <ScreenQuiz slot="screen" />
      <PhoneWaiting
        slot="phone"
        name="Léa"
        team="Équipe 3"
        teamClass="tu-team--3"
        hint="Retrouve les joueurs en vert."
        score="240 pts"
        next="Prochain jeu : Mime"
      />
    </Stage>
  </PageIntro>

  <section class="doors-section">
    <div class="tu-container doors">
      <article class="tu-panel door">
        <ScreenPodium flat class="door__visual" />
        <div class="door__text">
          <p class="tu-eyebrow tu-eyebrow--sage">Particuliers</p>
          <h2 class="tu-subtitle">
            Les deux familles ne se connaissent pas ? Elles vont jouer ensemble.
          </h2>
          <p class="tu-body-lg">
            Mariage, anniversaire, fête de famille : on fait jouer ensemble ceux qui ne se
            connaissaient pas, quelle que soit la langue qu'ils parlent.
          </p>
          <a class="tu-arrow-link" href="/particuliers">
            Découvrir l'offre particuliers
            <Icon name="arrow" size="sm" />
          </a>
        </div>
      </article>

      <article class="tu-panel door">
        <ScreenJoin flat connected="38 joueurs connectés" class="door__visual" />
        <div class="door__text">
          <p class="tu-eyebrow tu-eyebrow--navy">Entreprises</p>
          <h2 class="tu-subtitle">Des services qui ne se croisent jamais, dans la même équipe.</h2>
          <p class="tu-body-lg">
            Team building, séminaire, intégration : un temps fort animé de bout en bout, qui crée
            des liens qu'aucune réunion ne crée. Rien à installer, rien à gérer.
          </p>
          <a class="tu-arrow-link" href="/entreprises">
            Découvrir l'offre entreprises
            <Icon name="arrow" size="sm" />
          </a>
        </div>
      </article>
    </div>
  </section>

  <Section eyebrow="Les jeux" title="Cinq jeux. Toute la salle debout.">
    <a slot="action" class="tu-arrow-link" href="/les-jeux">
      Voir le détail des jeux
      <Icon name="arrow" size="sm" />
    </a>
    <div class="games">
      {games.map((game) => (
        <GameCard icon={game.icon} tone={game.tone} title={game.title} body={game.body} />
      ))}
    </div>
  </Section>

  <Section eyebrow="Comment ça marche" title="Vous recevez. On s'occupe du reste." tone="dark">
    <StepList steps={steps} variant="numerals" />
  </Section>

  <section class="langs-section">
    <div class="tu-container langs">
      <div class="langs__text">
        <p class="tu-eyebrow">Multilingue</p>
        <h2 class="tu-title">Une soirée, toutes les langues de vos invités.</h2>
        <p class="langs__body">
          Chaque invité joue dans sa langue, sur son téléphone : les contenus sont traduits pour
          votre soirée et relus avec vous. Et les jeux passent la barrière de la langue : on mime,
          on se lève, on montre.
        </p>
      </div>
      <ul class="tu-panel langs__list">
        <li class="langs__line" lang="fr">
          On joue. On se rencontre. On crée du lien.
        </li>
        <li class="langs__line" lang="ta">
          விளையாடுவோம். சந்திப்போம். இணைவோம்.
        </li>
        <li class="langs__line" lang="en">
          Play together. Meet people. Make it stick.
        </li>
      </ul>
    </div>
  </section>

  <Section title="Ils ont joué.">
    <div class="quotes">
      <figure class="tu-panel quote">
        <blockquote class="quote__text">« [CITATION CLIENT PARTICULIER] »</blockquote>
        <figcaption class="quote__author">[Prénom], [occasion], [ville]</figcaption>
      </figure>
      <figure class="tu-panel quote">
        <blockquote class="quote__text">« [CITATION CLIENT ENTREPRISE] »</blockquote>
        <figcaption class="quote__author">[Prénom], [fonction], [entreprise]</figcaption>
      </figure>
    </div>
  </Section>

  <CtaBanner title="Parlez-nous de votre événement." />
</Base>

<style>
  .intro-note {
    font-size: var(--tu-size-sm);
    color: var(--tu-text-muted);
  }

  /* Les deux portes d'entrée : particuliers et entreprises, côte à côte. */
  .doors-section {
    padding-bottom: var(--tu-section-space);
  }

  .doors {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--tu-space-8);
  }

  .door {
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .door :global(.door__visual) {
    height: var(--tu-door-visual-height);
  }

  .door :global(.door__visual .screen) {
    padding-inline: var(--tu-space-10);
  }

  .door__text {
    display: flex;
    flex-direction: column;
    gap: var(--tu-space-4);
    padding: var(--tu-space-9);
  }

  .games {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: var(--tu-space-5);
  }

  .langs-section {
    padding-bottom: var(--tu-section-space);
  }

  .langs {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--tu-space-16);
    align-items: center;
  }

  .langs__text {
    display: flex;
    flex-direction: column;
    gap: var(--tu-space-5);
  }

  .langs__body {
    font-size: 1.125rem;
    color: var(--tu-text-muted);
  }

  .langs__list {
    display: flex;
    flex-direction: column;
    gap: var(--tu-space-5);
    padding: var(--tu-space-10);
  }

  .langs__line {
    font-family: var(--tu-font-display);
    font-size: 1.625rem;
    font-weight: 600;
    line-height: 1.35;
  }

  .langs__line:lang(ta) {
    font-family: var(--tu-font-tamil);
    font-size: var(--tu-size-xl);
    line-height: 1.6;
  }

  .quotes {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--tu-space-8);
  }

  .quote {
    display: flex;
    flex-direction: column;
    gap: var(--tu-space-5);
    margin: 0;
    padding: var(--tu-space-10);
  }

  .quote__text {
    margin: 0;
    font-size: 1.375rem;
    line-height: 1.5;
  }

  .quote__author {
    font-size: var(--tu-btn-sm-font);
    color: var(--tu-text-muted);
  }

  @media (max-width: 75rem) {
    .games {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 60rem) {
    .doors,
    .langs,
    .quotes {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--tu-space-5);
    }

    .door :global(.door__visual .screen) {
      padding-inline: var(--tu-space-5);
    }

    .door__text {
      gap: var(--tu-space-3);
      padding: var(--tu-space-6) 1.375rem var(--tu-space-7);
    }

    .games {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--tu-space-3);
    }

    .langs__body {
      font-size: var(--tu-size-base);
    }

    .langs__list {
      gap: var(--tu-space-4);
      padding: 1.625rem 1.375rem;
    }

    .langs__line {
      font-size: 1.1875rem;
    }

    .langs__line:lang(ta) {
      font-size: 1.125rem;
    }

    .quote {
      gap: var(--tu-space-3);
      padding: 1.625rem 1.375rem;
    }

    .quote__text {
      font-size: 1.125rem;
    }

    .quote__author {
      font-size: var(--tu-size-sm);
    }
  }
</style>
