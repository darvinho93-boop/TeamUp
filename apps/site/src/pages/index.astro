---
import Base from '../layouts/Base.astro';
import Button from '@teamup/ui/astro/Button.astro';
import PageIntro from '../components/layout/PageIntro.astro';
import Section from '../components/layout/Section.astro';
import StepList from '../components/layout/StepList.astro';
import CtaBanner from '../components/layout/CtaBanner.astro';
import GameCard from '../components/jeux/GameCard.astro';
import Icon from '../components/Icon.astro';
import ScreenQuiz from '../components/visuels/ScreenQuiz.astro';
import ScreenPodium from '../components/visuels/ScreenPodium.astro';
import ScreenJoin from '../components/visuels/ScreenJoin.astro';
import PhoneWaiting from '../components/visuels/PhoneWaiting.astro';
import { games } from '../data/jeux';

const steps = [
  {
    title: "Vous décrivez l'événement",
    body: "Date, lieu, nombre d'invités, groupes à mélanger, langues parlées. On vous répond avec un devis.",
  },
  {
    title: 'On compose le programme',
    body: 'Un appel de cadrage fixe les équipes, les jeux et leur durée pour tenir dans votre créneau.',
  },
  {
    title: "L'animateur fait jouer la salle",
    body: "Il suffit d'un vidéoprojecteur. Les invités rejoignent la partie en scannant un QR code, sans rien installer.",
  },
];
---

<Base
  title="Team Up! — On joue. On se rencontre. On crée du lien."
  description="Animation de soirée en salle : un animateur Team Up! fait jouer vos invités en équipes mélangées. Anniversaires, mariages, séminaires, team building."
>
  <PageIntro
    eyebrow="Animation de soirée · particuliers et entreprises"
    title="Vos invités arrivent en groupes. Ils repartent en équipe."
    lead="Un animateur Team Up! fait jouer toute la salle : cinq jeux, un grand écran, des équipes qui mélangent familles, amis ou collègues."
  >
    <Fragment slot="actions">
      <Button href="/devis" variant="accent" size="lg">
        Demander un devis
      </Button>
      <Button href="/les-jeux" variant="ghost" size="lg">
        Voir les jeux
      </Button>
    </Fragment>
    <p slot="footnote" class="intro-note">
      Anniversaires · mariages · fêtes de famille · séminaires · team building
    </p>
    <Fragment slot="visual">
      <ScreenQuiz />
      <PhoneWaiting
        name="Léa"
        team="Équipe 3"
        teamClass="tu-team--3"
        hint="Retrouve les joueurs en vert."
        score="240 pts"
        next="Prochain jeu : Mime"
      />
    </Fragment>
  </PageIntro>

  <Section tone="muted">
    <div class="doors">
      <div class="door">
        <ScreenPodium />
        <div class="door__text">
          <p class="door__eyebrow">Particuliers</p>
          <h2 class="door__title">
            Les deux familles ne se connaissent pas ? Elles vont jouer ensemble.
          </h2>
          <p class="door__body">
            Anniversaire, mariage, anniversaire de mariage, fête de famille. On mélange les tablées,
            même quand tout le monde ne parle pas la même langue.
          </p>
          <a class="door__link" href="/particuliers">
            Découvrir l'offre particuliers
            <Icon name="arrow" size="sm" />
          </a>
        </div>
      </div>

      <div class="door door--reversed">
        <ScreenJoin connected="38 joueurs connectés" />
        <div class="door__text">
          <p class="door__eyebrow">Entreprises</p>
          <h2 class="door__title">Des services qui ne se croisent jamais, dans la même équipe.</h2>
          <p class="door__body">
            Team building, séminaire, intégration. Un temps fort de 40 à 60 minutes, animé de bout
            en bout, sans rien à installer pour vos équipes.
          </p>
          <a class="door__link" href="/entreprises">
            Découvrir l'offre entreprises
            <Icon name="arrow" size="sm" />
          </a>
        </div>
      </div>
    </div>
  </Section>

  <Section eyebrow="Les jeux" title="Cinq jeux. Toute la salle debout.">
    <div class="games">
      {games.map((game) => (
        <GameCard
          icon={game.icon}
          tone={game.tone}
          title={game.title}
          body={game.body}
          duration={game.duration}
        />
      ))}
    </div>
    <a class="door__link" href="/les-jeux">
      Voir le détail des jeux
      <Icon name="arrow" size="sm" />
    </a>
  </Section>

  <Section eyebrow="Comment ça marche" title="Vous recevez. On s'occupe du reste." tone="muted">
    <StepList steps={steps} />
  </Section>

  <Section eyebrow="Multilingue" title="Une soirée, plusieurs langues.">
    <div class="langs">
      <p class="langs__body">
        Chaque invité choisit sa langue sur son téléphone. Les jeux sont pensés pour passer la
        barrière de la langue : on mime, on se lève, on montre.
      </p>
      <ul class="langs__list">
        <li class="langs__line" lang="fr">
          On joue. On se rencontre. On crée du lien.
        </li>
        <li class="langs__line" lang="ta">
          விளையாடுவோம். சந்திப்போம். இணைவோம்.
        </li>
        <li class="langs__line" lang="en">
          Play together. Meet people. Make it stick.
        </li>
      </ul>
    </div>
  </Section>

  <Section title="Ils ont joué." tone="muted">
    <div class="quotes">
      <figure class="quote">
        <blockquote class="quote__text">« [CITATION CLIENT PARTICULIER] »</blockquote>
        <figcaption class="quote__author">[Prénom], [occasion], [ville]</figcaption>
      </figure>
      <figure class="quote">
        <blockquote class="quote__text">« [CITATION CLIENT ENTREPRISE] »</blockquote>
        <figcaption class="quote__author">[Prénom], [fonction], [entreprise]</figcaption>
      </figure>
    </div>
  </Section>

  <CtaBanner title="Parlez-nous de votre événement." />
</Base>

<style>
  .intro-note {
    font-size: var(--tu-size-sm);
    color: var(--tu-text-muted);
  }

  .doors {
    display: flex;
    flex-direction: column;
    gap: var(--tu-space-16);
  }

  .door {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: var(--tu-space-12);
  }

  .door--reversed > :global(:first-child) {
    order: 2;
  }

  .door__text {
    display: flex;
    flex-direction: column;
    gap: var(--tu-space-3);
  }

  .door__eyebrow {
    font-family: var(--tu-font-display);
    font-size: var(--tu-size-sm);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--tu-text-muted);
  }

  .door__title {
    font-size: var(--tu-size-2xl);
  }

  .door__body {
    color: var(--tu-text-muted);
  }

  .door__link {
    display: inline-flex;
    align-items: center;
    gap: var(--tu-space-2);
    align-self: flex-start;
    min-height: var(--tu-tap-min);
    font-family: var(--tu-font-display);
    font-weight: 600;
    text-decoration: none;
  }

  .door__link:hover {
    text-decoration: underline;
  }

  .games {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: var(--tu-space-4);
  }

  .langs {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--tu-space-8);
    align-items: center;
  }

  .langs__body {
    font-size: var(--tu-size-lg);
    color: var(--tu-text-muted);
  }

  .langs__list {
    display: flex;
    flex-direction: column;
    gap: var(--tu-space-3);
  }

  .langs__line {
    padding: var(--tu-space-4) var(--tu-space-6);
    border-radius: var(--tu-radius-md);
    background: var(--tu-surface);
    border: var(--tu-border-width) solid var(--tu-border);
    font-family: var(--tu-font-display);
    font-weight: 600;
  }

  .langs__line:lang(ta) {
    font-family: var(--tu-font-tamil);
  }

  .quotes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
    gap: var(--tu-space-6);
  }

  .quote {
    display: flex;
    flex-direction: column;
    gap: var(--tu-space-4);
    margin: 0;
    padding: var(--tu-space-8);
    border-radius: var(--tu-radius-lg);
    background: var(--tu-surface);
    border: var(--tu-border-width) solid var(--tu-border);
  }

  .quote__text {
    margin: 0;
    font-family: var(--tu-font-display);
    font-size: var(--tu-size-lg);
  }

  .quote__author {
    font-size: var(--tu-size-sm);
    color: var(--tu-text-muted);
  }

  @media (max-width: 60rem) {
    .doors {
      gap: var(--tu-space-12);
    }

    .door,
    .langs {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--tu-space-6);
    }

    .door--reversed > :global(:first-child) {
      order: 0;
    }

    .door__title {
      font-size: var(--tu-size-xl);
    }

    .langs__body {
      font-size: var(--tu-size-base);
    }
  }
</style>
