---
import Base from '../layouts/Base.astro';
import Button from '@teamup/ui/astro/Button.astro';
import PageIntro from '../components/layout/PageIntro.astro';
import Section from '../components/layout/Section.astro';
import StepList from '../components/layout/StepList.astro';
import CtaBanner from '../components/layout/CtaBanner.astro';
import Faq from '../components/layout/Faq.astro';
import type { FaqItem } from '../components/layout/Faq.astro';
import IconList from '../components/layout/IconList.astro';
import ScreenRanking from '../components/visuels/ScreenRanking.astro';
import ScreenPointsCommuns from '../components/visuels/ScreenPointsCommuns.astro';
import PhoneJoin from '../components/visuels/PhoneJoin.astro';
import { fourni, surPlace } from '../data/equipement';

const formats = [
  {
    title: 'Team building',
    body: 'Un moment dédié pour souder un pôle, une direction ou une équipe projet.',
  },
  {
    title: 'Séminaire',
    body: 'Une pause active entre deux sessions de travail, ou le temps fort de la soirée.',
  },
  {
    title: 'Intégration',
    body: "Les nouveaux arrivants rencontrent leurs collègues de tous les services, en moins d'une heure.",
  },
];

const creneaux = [
  {
    duration: '40',
    unit: 'minutes',
    body: 'Jusqu’à 5 équipes. Les cinq jeux, avec un programme resserré à partir de la cinquième équipe.',
  },
  {
    duration: '60',
    unit: 'minutes',
    body: 'Jusqu’à 8 équipes. Les cinq jeux au complet, et des duels en un contre un possibles pour relancer la salle.',
  },
];

const benefices = [
  {
    title: 'Des équipes transverses',
    body: 'On compose les équipes avec vous pour que chacune mélange services, sites et niveaux hiérarchiques.',
  },
  {
    title: 'Tout le monde participe',
    body: 'Pas de spectateurs rivés à leur téléphone : on se lève, on mime, on négocie à voix haute.',
  },
  {
    title: 'Des contenus adaptés au cadre pro',
    body: "Questions, mots et thèmes choisis pour un public professionnel. Rien de gênant, rien d'intrusif.",
  },
];

/* Seule la première réponse est rédigée dans la maquette. Les autres sont à fournir. */
const faq: FaqItem[] = [
  {
    question: "Et si le réseau tombe pendant l'animation ?",
    answer:
      "La plupart des jeux se jouent dans la salle, sans les téléphones : l'animation continue. Les envois de photos reprennent dès le retour du réseau.",
  },
  { question: 'Pour combien de participants ?' },
  { question: 'Peut-on adapter les contenus à notre entreprise ?' },
  { question: 'Quelles données collectez-vous sur les participants ?' },
  { question: 'Comment se passent le devis et la facturation ?' },
];
---

<Base
  title="Team building, séminaire, intégration — Team Up!"
  description="Un temps fort de 40 à 60 minutes qui fait se parler des équipes qui ne se croisent jamais. Animé de bout en bout, rien à installer."
>
  <PageIntro
    eyebrow="Entreprises"
    title="Faites se parler des équipes qui ne se croisent jamais."
    lead="Team building, séminaire, intégration : un temps fort de 40 à 60 minutes, animé par Team Up!, où les services jouent ensemble au lieu de rester entre eux."
  >
    <Fragment slot="actions">
      <Button href="/devis" variant="accent" size="lg">
        Demander un devis
      </Button>
      <Button href="#formats" variant="ghost" size="lg">
        Voir les formats
      </Button>
    </Fragment>
    <Fragment slot="visual">
      <ScreenRanking />
      <PhoneJoin />
    </Fragment>
  </PageIntro>

  <Section
    id="formats"
    eyebrow="Les formats"
    title="Un temps fort qui s'insère dans votre agenda."
    tone="muted"
  >
    <div class="formats">
      {formats.map((format) => (
        <article class="format">
          <h3 class="format__title">{format.title}</h3>
          <p class="format__body">{format.body}</p>
        </article>
      ))}
    </div>

    <div class="creneaux">
      {creneaux.map((creneau) => (
        <article class="creneau">
          <p class="creneau__duration">
            <span class="creneau__number">{creneau.duration}</span>
            <span class="creneau__unit">{creneau.unit}</span>
          </p>
          <p class="creneau__body">{creneau.body}</p>
        </article>
      ))}
    </div>
  </Section>

  <Section eyebrow="Ce que vos équipes y gagnent" title="Des silos qui se mélangent, pour de vrai.">
    <div class="benefices">
      <ScreenPointsCommuns />
      <StepList steps={benefices} layout="stack" />
    </div>
  </Section>

  <Section tone="muted">
    <div class="equipement">
      <IconList title="Ce que nous apportons" items={fourni} />
      <IconList title="Ce qu'il faut sur place" items={surPlace} />
    </div>
  </Section>

  <Section title="Ils nous ont fait confiance.">
    <ul class="logos">
      {Array.from({ length: 5 }).map(() => (
        <li class="logos__item">[LOGO CLIENT]</li>
      ))}
    </ul>
    <figure class="quote">
      <blockquote class="quote__text">« [CITATION CLIENT ENTREPRISE] »</blockquote>
      <figcaption class="quote__author">[Prénom], [fonction], [entreprise]</figcaption>
    </figure>
  </Section>

  <Section eyebrow="Questions fréquentes" title="Côté organisation." tone="muted">
    <Faq items={faq} />
  </Section>

  <CtaBanner title="Parlons de votre prochain séminaire." />
</Base>

<style>
  .formats,
  .creneaux,
  .equipement {
    display: grid;
    gap: var(--tu-space-4);
  }

  .formats {
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
  }

  .creneaux,
  .equipement {
    grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr));
  }

  .format,
  .creneau {
    display: flex;
    flex-direction: column;
    gap: var(--tu-space-2);
    padding: var(--tu-space-6);
    border-radius: var(--tu-radius-lg);
    background: var(--tu-surface);
    border: var(--tu-border-width) solid var(--tu-border);
  }

  .format__title {
    font-size: var(--tu-size-lg);
  }

  .format__body,
  .creneau__body {
    color: var(--tu-text-muted);
  }

  .creneau__duration {
    display: flex;
    align-items: baseline;
    gap: var(--tu-space-2);
  }

  .creneau__number {
    font-family: var(--tu-font-numeric);
    font-size: var(--tu-size-3xl);
    font-weight: 700;
    color: var(--tu-primary);
  }

  .creneau__unit {
    font-family: var(--tu-font-display);
    color: var(--tu-text-muted);
  }

  .benefices {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--tu-space-12);
    align-items: center;
  }

  /* Contenu à fournir : cinq emplacements de logo, pas de faux logos. */
  .logos {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: var(--tu-space-3);
  }

  .logos__item {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: var(--tu-space-16);
    border-radius: var(--tu-radius-md);
    border: var(--tu-border-width) dashed var(--tu-border);
    color: var(--tu-text-muted);
    font-size: var(--tu-size-sm);
  }

  .quote {
    display: flex;
    flex-direction: column;
    gap: var(--tu-space-4);
    margin: 0;
    padding: var(--tu-space-8);
    border-radius: var(--tu-radius-lg);
    background: var(--tu-surface);
    border: var(--tu-border-width) solid var(--tu-border);
    max-width: 48rem;
  }

  .quote__text {
    margin: 0;
    font-family: var(--tu-font-display);
    font-size: var(--tu-size-lg);
  }

  .quote__author {
    font-size: var(--tu-size-sm);
    color: var(--tu-text-muted);
  }

  @media (max-width: 60rem) {
    .benefices {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--tu-space-8);
    }
  }
</style>
