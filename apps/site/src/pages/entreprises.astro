---
import Base from '../layouts/Base.astro';
import Button from '@teamup/ui/astro/Button.astro';
import PageIntro from '../components/layout/PageIntro.astro';
import Section from '../components/layout/Section.astro';
import StepList from '../components/layout/StepList.astro';
import CtaBanner from '../components/layout/CtaBanner.astro';
import Faq from '../components/layout/Faq.astro';
import type { FaqItem } from '../components/layout/Faq.astro';
import Equipment from '../components/layout/Equipment.astro';
import Stage from '../components/visuels/Stage.astro';
import ScreenRanking from '../components/visuels/ScreenRanking.astro';
import ScreenPointsCommuns from '../components/visuels/ScreenPointsCommuns.astro';
import PhoneJoin from '../components/visuels/PhoneJoin.astro';
import { PREUVES_FOURNIES } from '../data/preuves';

const formats = [
  {
    title: 'Team building',
    body: 'Un moment dédié pour souder un pôle, une direction ou une équipe projet.',
  },
  {
    title: 'Séminaire',
    body: 'Une respiration entre deux sessions de travail, ou le temps fort de la soirée.',
  },
  {
    title: 'Intégration',
    body: 'Les nouveaux arrivants rencontrent leurs collègues de tous les services, dans la bonne humeur.',
  },
];

const benefices = [
  {
    title: 'Des équipes transverses',
    body: "En arrivant, chaque participant indique son service ou son site : il rejoint l'équipe où ses collègues directs sont les moins nombreux.",
  },
  {
    title: 'Tout le monde participe',
    body: "Jusqu'à 150 participants, et pas un spectateur : on se lève, on mime, on négocie à voix haute. Du stagiaire au comité de direction.",
  },
  {
    title: 'Des contenus pensés pour le cadre pro',
    body: "Questions, mots et thèmes choisis pour un public professionnel, et adaptables à votre entreprise. Rien de gênant, rien d'intrusif.",
  },
];

/* Ce que gagne celui qui organise : un interlocuteur, rien à installer, tout prêt avant le début. */
const organisation = [
  {
    title: 'Un seul interlocuteur',
    body: "Du devis au podium, vous parlez à la même personne. Le programme, les équipes et les contenus se décident avec vous, avant l'événement.",
  },
  {
    title: 'Rien à installer, rien à faire valider',
    body: 'Ni application, ni compte : les participants scannent un QR code et jouent sous leur seul prénom. Aucune adresse e-mail, aucun numéro de téléphone collecté.',
  },
  {
    title: 'Tout est prêt avant le début',
    body: "L'animateur arrive en avance, branche l'écran, teste le son et le réseau. Quand vos équipes entrent dans la salle, tout fonctionne déjà.",
  },
];

/* Réponses tirées de la spec v3 et du cahier des charges ; le commercial reste entre crochets. */
const faq: FaqItem[] = [
  {
    question: "Et si le réseau tombe pendant l'animation ?",
    answer:
      "L'animation continue : la plupart des jeux se jouent dans la salle, sans les téléphones. Les photos en attente partent d'elles-mêmes dès le retour du réseau.",
  },
  {
    question: 'Pour combien de participants ?',
    answer:
      "Jusqu'à 150 participants. Le nombre d'équipes et le programme s'adaptent à votre effectif.",
  },
  {
    question: 'Peut-on adapter les contenus à notre entreprise ?',
    answer:
      "Oui. Nous partons de nos questions, mots et thèmes pensés pour le cadre professionnel, et pouvons y ajouter des contenus à votre image : votre secteur, vos valeurs, vos clins d'œil internes. Nous les validons avec vous avant l'événement.",
  },
  {
    question: 'Quelles données collectez-vous sur les participants ?',
    answer:
      "Le strict minimum. Les participants jouent sous leur seul prénom, sans compte, sans e-mail ni numéro de téléphone. Les photos de l'événement sont supprimées 30 jours après.",
  },
  {
    question: 'Comment se passent le devis et la facturation ?',
    answer:
      'Vous décrivez votre événement, nous vous rappelons sous 48 heures et vous adressons un devis détaillé, gratuit et sans engagement.',
  },
];
---

<Base
  title="Team building, séminaire, intégration — Team Up!"
  description="Team building, séminaire, intégration : un temps fort animé de bout en bout, jusqu'à 150 participants. Rien à installer, un seul interlocuteur."
  accent="entreprises"
>
  <PageIntro
    eyebrow="Entreprises"
    title="Faites se parler des équipes qui ne se croisent jamais."
    lead="Team building, séminaire, intégration : un temps fort animé de bout en bout, où les services jouent ensemble au lieu de rester entre eux. Vous n'avez rien à animer, et personne ne reste spectateur."
  >
    <p slot="footnote" class="intro-note">
      Sur devis, gratuit et sans engagement
    </p>
    <Fragment slot="actions">
      <Button href="/devis?type=entreprise" variant="accent" size="cta">
        Demander un devis
      </Button>
      <Button href="#formats" variant="outline" size="cta">
        Voir les formats
      </Button>
    </Fragment>
    <Stage slot="visual" class="hero-stage">
      <ScreenRanking slot="screen" />
      <PhoneJoin slot="phone" class="desktop-only" />
    </Stage>
  </PageIntro>

  <Section id="formats" eyebrow="Les formats" title="Un temps fort qui s'insère dans votre agenda.">
    <div class="offer">
      <div class="formats">
        {formats.map((format) => (
          <article class="tu-panel format" data-tu-apparait>
            <h3 class="format__title">{format.title}</h3>
            <p class="format__body">{format.body}</p>
          </article>
        ))}
      </div>
      <div class="creneaux">
        <article class="creneau creneau--light" data-tu-apparait>
          <h3 class="creneau__name">L'Essentiel</h3>
          <p class="creneau__body">
            Les cinq jeux et le final en photos, pour des groupes jusqu'à cinq équipes.
          </p>
          <p class="creneau__price">Sur devis</p>
        </article>
        <article class="tu-panel tu-panel--dark creneau" data-theme="stage" data-tu-apparait>
          <h3 class="creneau__name">Le Grand format</h3>
          <p class="creneau__body">
            Les cinq jeux au complet pour les grands groupes, jusqu'à huit équipes et 150
            participants.
          </p>
          <p class="creneau__price">Sur devis</p>
        </article>
      </div>
    </div>
  </Section>

  <section class="benefits-section">
    <div class="tu-container benefits">
      <ScreenPointsCommuns class="benefits__visual desktop-only" />
      <div class="benefits__text">
        <div class="benefits__header">
          <p class="tu-eyebrow">Ce que vos équipes y gagnent</p>
          <h2 class="tu-title">Des silos qui se mélangent, pour de vrai.</h2>
        </div>
        <StepList steps={benefices} variant="plain" />
      </div>
    </div>
  </section>

  <Section title="Pour vous qui organisez.">
    <div class="formats">
      {organisation.map((point) => (
        <article class="tu-panel format" data-tu-apparait>
          <h3 class="format__title">{point.title}</h3>
          <p class="format__body">{point.body}</p>
        </article>
      ))}
    </div>
  </Section>

  <section class="equipment-section">
    <div class="tu-container">
      <Equipment />
    </div>
  </section>

  {PREUVES_FOURNIES && (
    <Section title="Ils nous ont fait confiance.">
      <!-- Contenu à fournir : cinq emplacements de logo, pas de faux logos. -->
      <ul class="logos">
        {Array.from({ length: 5 }).map(() => (
          <li class="logos__item">[LOGO CLIENT]</li>
        ))}
      </ul>
      <figure class="tu-panel quote">
        <blockquote class="quote__text">« [CITATION CLIENT ENTREPRISE] »</blockquote>
        <figcaption class="quote__author">[Prénom], [fonction], [entreprise]</figcaption>
      </figure>
    </Section>
  )}

  <Section eyebrow="Questions fréquentes" title="Côté organisation." layout="aside">
    <Faq items={faq} />
  </Section>

  <CtaBanner title="Parlons de votre prochain événement d'équipe." href="/devis?type=entreprise" />
</Base>

<style>
  .intro-note {
    font-size: var(--tu-size-sm);
    color: var(--tu-text-muted);
  }

  .offer {
    display: flex;
    flex-direction: column;
    gap: var(--tu-space-5);
  }

  .formats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--tu-space-5);
  }

  .format {
    display: flex;
    flex-direction: column;
    gap: var(--tu-space-3);
    padding: var(--tu-space-8);
  }

  .format__title {
    font-size: 1.375rem;
  }

  .format__body {
    color: var(--tu-text-muted);
  }

  .creneaux {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--tu-space-5);
  }

  .creneau {
    display: flex;
    flex-direction: column;
    gap: var(--tu-space-4);
    padding: var(--tu-space-10);
    border-radius: var(--tu-radius-lg);
  }

  .creneau--light {
    background: var(--tu-navy-50);
  }

  .creneau__name {
    font-size: var(--tu-size-3xl);
    line-height: 1.1;
  }

  .tu-panel--dark .creneau__name {
    color: var(--tu-primary);
  }

  .creneau__price {
    margin-top: auto;
    font-family: var(--tu-font-display);
    font-size: var(--tu-size-lg);
    font-weight: 600;
  }

  .creneau__body {
    font-size: var(--tu-type-body-lg);
  }

  .tu-panel--dark .creneau__body {
    color: var(--tu-navy-200);
  }

  .benefits-section,
  .equipment-section {
    padding-bottom: var(--tu-section-space);
  }

  .benefits {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--tu-space-20);
    align-items: center;
  }

  .benefits :global(.benefits__visual) {
    height: 25rem;
  }

  .benefits__text {
    display: flex;
    flex-direction: column;
    gap: var(--tu-space-9);
  }

  .benefits__header {
    display: flex;
    flex-direction: column;
    gap: var(--tu-space-3);
  }

  .logos {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: var(--tu-space-5);
  }

  .logos__item {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 6rem;
    border: var(--tu-btn-border-width) dashed var(--tu-border-strong);
    border-radius: var(--tu-radius-md);
    color: var(--tu-text-muted);
    font-size: var(--tu-size-sm);
  }

  .quote {
    display: flex;
    flex-direction: column;
    gap: var(--tu-space-5);
    margin: 0;
    padding: var(--tu-space-10);
  }

  .quote__text {
    margin: 0;
    font-size: 1.375rem;
    line-height: 1.5;
  }

  .quote__author {
    font-size: var(--tu-btn-sm-font);
    color: var(--tu-text-muted);
  }

  @media (max-width: 60rem) {
    :global(.benefits .screen-figure.desktop-only),
    :global(.stage.hero-stage .desktop-only) {
      display: none;
    }

    :global(.stage.hero-stage) {
      min-height: 0;
    }

    :global(.stage.hero-stage .stage__screen) {
      position: static;
      width: 100%;
    }

    .offer {
      gap: var(--tu-space-3);
    }

    .formats,
    .creneaux {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--tu-space-3);
    }

    .format {
      gap: var(--tu-space-2);
      padding: var(--tu-space-6) 1.375rem;
    }

    .format__title {
      font-size: var(--tu-size-lg);
    }

    .creneau {
      gap: var(--tu-space-2);
      padding: var(--tu-space-6);
    }

    .creneau__name {
      font-size: var(--tu-size-xl);
    }

    .creneau__price {
      font-size: var(--tu-size-base);
    }

    .benefits {
      grid-template-columns: minmax(0, 1fr);
    }

    .benefits__text {
      gap: var(--tu-space-5);
    }

    .logos {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--tu-space-3);
    }

    /* Mobile : quatre emplacements, deux par ligne, comme la maquette. */
    .logos__item:nth-child(5) {
      display: none;
    }

    .logos__item {
      min-height: var(--tu-space-18);
    }

    .quote {
      gap: var(--tu-space-3);
      padding: var(--tu-space-6) 1.375rem;
    }

    .quote__text {
      font-size: 1.125rem;
    }
  }
</style>
