---
import Base from '../layouts/Base.astro';
import Button from '@teamup/ui/astro/Button.astro';
import PageIntro from '../components/layout/PageIntro.astro';
import Section from '../components/layout/Section.astro';
import StepList from '../components/layout/StepList.astro';
import Recit from '../components/layout/Recit.astro';
import CtaBanner from '../components/layout/CtaBanner.astro';
import Faq from '../components/layout/Faq.astro';
import type { FaqItem } from '../components/layout/Faq.astro';
import Equipment from '../components/layout/Equipment.astro';
import Stage from '../components/visuels/Stage.astro';
import ScreenRanking from '../components/visuels/ScreenRanking.astro';
import ScreenPointsCommuns from '../components/visuels/ScreenPointsCommuns.astro';
import PhoneJoin from '../components/visuels/PhoneJoin.astro';
import { PREUVES_FOURNIES } from '../data/preuves';

const formats = [
  {
    title: 'Team building',
    sousTitre: 'Partager un défi. Découvrir ses collègues autrement.',
    body: "Une expérience collective qui fait appel à l'écoute, à la créativité et à l'esprit d'équipe, dans une atmosphère conviviale et stimulante.",
  },
  {
    title: 'Séminaires',
    sousTitre: 'Un temps fort qui change le rythme.',
    body: "Entre deux sessions de travail ou lors d'une soirée d'entreprise, Team Up! réunit les participants autour d'une expérience commune, loin des présentations et des réunions.",
  },
  {
    title: "Journées d'intégration",
    sousTitre: 'Faire connaissance autrement que par les présentations.',
    body: 'Offrez aux nouveaux arrivants une occasion de rencontrer leurs collègues de différents services et de trouver naturellement leur place dans le collectif.',
  },
];

const benefices = [
  {
    title: 'Favoriser les rencontres transversales',
    body: 'La répartition des participants encourage les échanges entre services, métiers ou sites qui se côtoient peu.',
  },
  {
    title: 'Valoriser la diversité des talents',
    body: 'Réflexion, intuition, mémoire, créativité ou aisance à communiquer : les défis permettent à différentes personnalités de contribuer au jeu.',
  },
  {
    title: 'Encourager la participation',
    body: "Chaque activité est présentée et accompagnée par l'animateur. Le format peut être ajusté aux profils et aux possibilités de participation de vos collaborateurs.",
  },
  {
    title: 'Intégrer votre univers',
    body: 'Questions, thématiques et références internes peuvent être personnalisées pour créer une expérience en accord avec la culture et le contexte de votre entreprise.',
  },
];

/* Ce que gagne celui qui organise : un programme préparé, rien à installer, une partie rythmée. */
const organisation = [
  {
    title: 'Un programme construit avec vous',
    body: "Nous construisons le programme avec vous, préparons les contenus et assurons l'animation sur place.",
  },
  {
    title: 'Rien à installer',
    body: "Les participants rejoignent la partie depuis leur téléphone, sans installation d'application ni création de compte.",
  },
  {
    title: "Jusqu'au classement final",
    body: "L'animateur coordonne les manches, le grand écran rythme la progression et les équipes vivent ensemble les moments forts, jusqu'au classement final.",
  },
];

/* Réponses tirées de la spec v3 et du cahier des charges ; le commercial reste entre crochets. */
const faq: FaqItem[] = [
  {
    question: "Et si le réseau tombe pendant l'animation ?",
    answer:
      "L'animation continue : la plupart des jeux se jouent dans la salle, sans les téléphones. Les photos en attente partent d'elles-mêmes dès le retour du réseau.",
  },
  {
    question: 'Pour combien de participants ?',
    answer:
      "Jusqu'à 150 participants. Le nombre d'équipes et le programme s'adaptent à votre effectif.",
  },
  {
    question: 'Où intervenez-vous ?',
    answer:
      'Partout en France. Le déplacement est chiffré dans le devis, selon le lieu de votre événement.',
  },
  {
    question: 'Peut-on adapter les contenus à notre entreprise ?',
    answer:
      "Oui. Nous partons de nos questions, mots et thèmes pensés pour le cadre professionnel, et pouvons y ajouter des contenus à votre image : votre secteur, vos valeurs, vos clins d'œil internes. Nous les validons avec vous avant l'événement.",
  },
  {
    question: 'Quelles données collectez-vous sur les participants ?',
    answer:
      "Le strict minimum. Les participants jouent sous leur seul prénom, sans compte, sans e-mail ni numéro de téléphone. Les photos de l'événement sont supprimées 30 jours après.",
  },
  {
    question: 'Comment se passent le devis et la facturation ?',
    answer:
      'Vous décrivez votre événement, nous vous rappelons sous 48 heures et vous adressons un devis détaillé, gratuit et sans engagement.',
  },
];
---

<Base
  title="Team building, séminaire, intégration — Team Up!"
  description="Team building, séminaires, intégration : une expérience collective inspirée des jeux télévisés, jusqu'à 150 participants, partout en France."
  accent="entreprises"
>
  <PageIntro
    eyebrow="Team building · Séminaires · Intégration"
    title="L'esprit d'équipe se cultive aussi en dehors du bureau."
    lead={[
      "Vos collaborateurs partagent une entreprise, des projets, parfois les mêmes locaux. Mais ont-ils vraiment l'occasion de se découvrir ?",
      'Avec Team Up!, donnez une autre dimension à vos événements professionnels grâce à une expérience collective inspirée des jeux télévisés.',
      'Des équipes transversales, des défis accessibles et le plaisir de partager un moment différent du quotidien.',
    ]}
  >
    <p slot="footnote" class="intro-note">
      Sur devis, gratuit et sans engagement
    </p>
    <Fragment slot="actions">
      <Button href="/devis?type=entreprise" variant="accent" size="cta">
        Organiser mon événement
      </Button>
      <Button href="#formats" variant="outline" size="cta">
        Découvrir les formats
      </Button>
    </Fragment>
    <Stage slot="visual" class="hero-stage">
      <ScreenRanking slot="screen" />
      <PhoneJoin slot="phone" />
    </Stage>
  </PageIntro>

  <Section title="Au-delà des fonctions, le plaisir de jouer ensemble.">
    <Recit
      paragraphes={[
        'Dans une entreprise, les échanges suivent naturellement les habitudes de travail. On retrouve son service, son équipe, ses interlocuteurs réguliers.',
        'Team Up! propose de changer de perspective.',
        "Pendant une partie, les collaborateurs de différents métiers ou services deviennent coéquipiers. Ils réfléchissent ensemble, confrontent leurs idées, s'encouragent et découvrent d'autres facettes de leurs collègues.",
        {
          texte: 'Un cadre ludique pour favoriser des échanges plus spontanés, sans les imposer.',
          fort: true,
        },
      ]}
    />
  </Section>

  <Section id="formats" eyebrow="Les formats" title="Une expérience adaptée à vos temps forts.">
    <div class="formats tu-rail">
      {formats.map((format) => (
        <article class="tu-panel format" data-tu-apparait>
          <h3 class="format__title">{format.title}</h3>
          <p class="format__sous-titre">{format.sousTitre}</p>
          <p class="format__body">{format.body}</p>
        </article>
      ))}
    </div>
  </Section>

  <section class="benefits-section">
    <div class="tu-container benefits">
      <ScreenPointsCommuns class="benefits__visual" />
      <div class="benefits__text">
        <div class="benefits__header">
          <p class="tu-eyebrow">Ce que vos équipes y gagnent</p>
          <h2 class="tu-title">Des équipes différentes. Une expérience commune.</h2>
        </div>
        <StepList steps={benefices} variant="plain" />
      </div>
    </div>
  </section>

  <Section
    eyebrow="Pour vous qui organisez"
    title="Le dynamisme d'un jeu télévisé. La simplicité d'une prestation accompagnée."
  >
    <div class="formats tu-rail">
      {organisation.map((point) => (
        <article class="tu-panel format" data-tu-apparait>
          <h3 class="format__title">{point.title}</h3>
          <p class="format__body">{point.body}</p>
        </article>
      ))}
    </div>
    <p class="organisation__fort">
      Jusqu'à 150 participants, dans un format ajusté à votre événement.
    </p>
  </Section>

  <Section title="Un moment partagé qui ouvre de nouvelles conversations.">
    <Recit
      paragraphes={[
        'Au-delà des points et du podium, ce sont souvent les échanges, les initiatives inattendues et les souvenirs collectifs qui restent.',
        "Parce qu'il est parfois plus facile de faire connaissance en cherchant une réponse ensemble qu'en se retrouvant autour d'une table de réunion.",
      ]}
    />
  </Section>

  <section class="equipment-section">
    <div class="tu-container">
      <Equipment />
    </div>
  </section>

  {PREUVES_FOURNIES && (
    <Section title="Ils nous ont fait confiance.">
      <!-- Contenu à fournir : cinq emplacements de logo, pas de faux logos. -->
      <ul class="logos">
        {Array.from({ length: 5 }).map(() => (
          <li class="logos__item">[LOGO CLIENT]</li>
        ))}
      </ul>
      <figure class="tu-panel quote">
        <blockquote class="quote__text">« [CITATION CLIENT ENTREPRISE] »</blockquote>
        <figcaption class="quote__author">[Prénom], [fonction], [entreprise]</figcaption>
      </figure>
    </Section>
  )}

  <Section eyebrow="Questions fréquentes" title="Côté organisation." layout="aside">
    <Faq items={faq} />
  </Section>

  <CtaBanner
    title="Imaginons votre prochain temps fort."
    note="Parlons de votre événement, de vos équipes et de l'expérience que vous souhaitez leur proposer. Nous concevons avec vous un programme adapté à vos objectifs, à vos participants et à votre organisation."
    href="/devis?type=entreprise"
  />
</Base>

<style>
  .intro-note {
    font-size: var(--tu-size-sm);
    color: var(--tu-text-muted);
  }

  .formats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--tu-space-5);
  }

  .format {
    display: flex;
    flex-direction: column;
    gap: var(--tu-space-3);
    padding: var(--tu-space-8);
  }

  .format__title {
    font-size: 1.375rem;
  }

  .format__sous-titre {
    font-weight: 600;
  }

  .format__body {
    color: var(--tu-text-muted);
  }

  .organisation__fort {
    margin-top: var(--tu-space-6);
    font-weight: 600;
  }

  .benefits-section,
  .equipment-section {
    padding-bottom: var(--tu-section-space);
  }

  .benefits {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--tu-space-20);
    align-items: center;
  }

  .benefits :global(.benefits__visual) {
    height: 25rem;
  }

  .benefits__text {
    display: flex;
    flex-direction: column;
    gap: var(--tu-space-9);
  }

  .benefits__header {
    display: flex;
    flex-direction: column;
    gap: var(--tu-space-3);
  }

  .logos {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: var(--tu-space-5);
  }

  .logos__item {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 6rem;
    border: var(--tu-btn-border-width) dashed var(--tu-border-strong);
    border-radius: var(--tu-radius-md);
    color: var(--tu-text-muted);
    font-size: var(--tu-size-sm);
  }

  .quote {
    display: flex;
    flex-direction: column;
    gap: var(--tu-space-5);
    margin: 0;
    padding: var(--tu-space-10);
  }

  .quote__text {
    margin: 0;
    font-size: 1.375rem;
    line-height: 1.5;
  }

  .quote__author {
    font-size: var(--tu-btn-sm-font);
    color: var(--tu-text-muted);
  }

  @media (max-width: 60rem) {
    /* Téléphone : mêmes visuels que sur ordinateur ; les formats glissent en rangée (.tu-rail). */
    .format {
      gap: var(--tu-space-2);
      padding: var(--tu-space-6) 1.375rem;
    }

    .format__title {
      font-size: var(--tu-size-lg);
    }

    .benefits {
      grid-template-columns: minmax(0, 1fr);
    }

    .benefits :global(.benefits__visual) {
      order: 1;
      height: auto;
      min-height: var(--tu-game-visual-height);
    }

    /* Le titre, puis l'écran, puis les bénéfices : le bloc de texte s'efface pour les ranger. */
    .benefits__text {
      display: contents;
    }

    .benefits :global(.steps) {
      order: 2;
    }

    .logos {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--tu-space-3);
    }

    /* Mobile : quatre emplacements, deux par ligne, comme la maquette. */
    .logos__item:nth-child(5) {
      display: none;
    }

    .logos__item {
      min-height: var(--tu-space-18);
    }

    .quote {
      gap: var(--tu-space-3);
      padding: var(--tu-space-6) 1.375rem;
    }

    .quote__text {
      font-size: 1.125rem;
    }
  }
</style>
