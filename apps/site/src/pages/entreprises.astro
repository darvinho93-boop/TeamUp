---
import Base from '../layouts/Base.astro';
import Button from '@teamup/ui/astro/Button.astro';
import PageIntro from '../components/layout/PageIntro.astro';
import Section from '../components/layout/Section.astro';
import StepList from '../components/layout/StepList.astro';
import CtaBanner from '../components/layout/CtaBanner.astro';
import Faq from '../components/layout/Faq.astro';
import type { FaqItem } from '../components/layout/Faq.astro';
import Equipment from '../components/layout/Equipment.astro';
import Stage from '../components/visuels/Stage.astro';
import ScreenRanking from '../components/visuels/ScreenRanking.astro';
import ScreenPointsCommuns from '../components/visuels/ScreenPointsCommuns.astro';
import PhoneJoin from '../components/visuels/PhoneJoin.astro';

const formats = [
  {
    title: 'Team building',
    body: 'Un moment dédié pour souder un pôle, une direction ou une équipe projet.',
  },
  {
    title: 'Séminaire',
    body: 'Une pause active entre deux sessions de travail, ou le temps fort de la soirée.',
  },
  {
    title: 'Intégration',
    body: "Les nouveaux arrivants rencontrent leurs collègues de tous les services, en moins d'une heure.",
  },
];

const benefices = [
  {
    title: 'Des équipes transverses',
    body: 'On compose les équipes avec vous pour que chacune mélange services, sites et niveaux hiérarchiques.',
  },
  {
    title: 'Tout le monde participe',
    body: 'Pas de spectateurs rivés à leur téléphone : on se lève, on mime, on négocie à voix haute.',
  },
  {
    title: 'Des contenus adaptés au cadre pro',
    body: "Questions, mots et thèmes choisis pour un public professionnel. Rien de gênant, rien d'intrusif.",
  },
];

/* Seule la première réponse est rédigée dans la maquette. Les autres sont à fournir. */
const faq: FaqItem[] = [
  {
    question: "Et si le réseau tombe pendant l'animation ?",
    answer:
      "La plupart des jeux se jouent dans la salle, sans les téléphones : l'animation continue. Les envois de photos reprennent dès le retour du réseau.",
  },
  { question: 'Pour combien de participants ?' },
  { question: 'Peut-on adapter les contenus à notre entreprise ?' },
  { question: 'Quelles données collectez-vous sur les participants ?' },
  { question: 'Comment se passent le devis et la facturation ?' },
];
---

<Base
  title="Team building, séminaire, intégration — Team Up!"
  description="Un temps fort de 40 à 60 minutes qui fait se parler des équipes qui ne se croisent jamais. Animé de bout en bout, rien à installer."
  accent="entreprises"
>
  <PageIntro
    eyebrow="Entreprises"
    title="Faites se parler des équipes qui ne se croisent jamais."
    lead="Team building, séminaire, intégration : un temps fort de 40 à 60 minutes, animé par Team Up!, où les services jouent ensemble au lieu de rester entre eux."
  >
    <Fragment slot="actions">
      <Button href="/devis" variant="accent" size="cta">
        Demander un devis
      </Button>
      <Button href="#formats" variant="outline" size="cta">
        Voir les formats
      </Button>
    </Fragment>
    <Stage slot="visual" class="hero-stage">
      <ScreenRanking slot="screen" />
      <PhoneJoin slot="phone" class="desktop-only" />
    </Stage>
  </PageIntro>

  <Section id="formats" eyebrow="Les formats" title="Un temps fort qui s'insère dans votre agenda.">
    <div class="offer">
      <div class="formats">
        {formats.map((format) => (
          <article class="tu-panel format">
            <h3 class="format__title">{format.title}</h3>
            <p class="format__body">{format.body}</p>
          </article>
        ))}
      </div>
      <div class="creneaux">
        <article class="creneau creneau--light">
          <p class="creneau__duration">
            <span class="creneau__number">40</span>
            <span class="creneau__unit">minutes</span>
          </p>
          <p class="creneau__body">
            Jusqu’à 5 équipes. Les cinq jeux, avec un programme resserré à partir de la cinquième
            équipe.
          </p>
        </article>
        <article class="tu-panel tu-panel--dark creneau" data-theme="stage">
          <p class="creneau__duration">
            <span class="creneau__number">60</span>
            <span class="creneau__unit">minutes</span>
          </p>
          <p class="creneau__body">
            Jusqu’à 8 équipes. Les cinq jeux au complet, et des duels en un contre un possibles pour
            relancer la salle.
          </p>
        </article>
      </div>
    </div>
  </Section>

  <section class="benefits-section">
    <div class="tu-container benefits">
      <ScreenPointsCommuns class="benefits__visual desktop-only" />
      <div class="benefits__text">
        <div class="benefits__header">
          <p class="tu-eyebrow">Ce que vos équipes y gagnent</p>
          <h2 class="tu-title">Des silos qui se mélangent, pour de vrai.</h2>
        </div>
        <StepList steps={benefices} variant="plain" />
      </div>
    </div>
  </section>

  <section class="equipment-section">
    <div class="tu-container">
      <Equipment />
    </div>
  </section>

  <Section title="Ils nous ont fait confiance.">
    <!-- Contenu à fournir : cinq emplacements de logo, pas de faux logos. -->
    <ul class="logos">
      {Array.from({ length: 5 }).map(() => (
        <li class="logos__item">[LOGO CLIENT]</li>
      ))}
    </ul>
    <figure class="tu-panel quote">
      <blockquote class="quote__text">« [CITATION CLIENT ENTREPRISE] »</blockquote>
      <figcaption class="quote__author">[Prénom], [fonction], [entreprise]</figcaption>
    </figure>
  </Section>

  <Section eyebrow="Questions fréquentes" title="Côté organisation." layout="aside">
    <Faq items={faq} />
  </Section>

  <CtaBanner title="Parlons de votre prochain séminaire." />
</Base>

<style>
  .offer {
    display: flex;
    flex-direction: column;
    gap: var(--tu-space-5);
  }

  .formats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--tu-space-5);
  }

  .format {
    display: flex;
    flex-direction: column;
    gap: var(--tu-space-3);
    padding: var(--tu-space-8);
  }

  .format__title {
    font-size: 1.375rem;
  }

  .format__body {
    color: var(--tu-text-muted);
  }

  .creneaux {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--tu-space-5);
  }

  .creneau {
    display: flex;
    flex-direction: column;
    gap: var(--tu-space-4);
    padding: var(--tu-space-10);
    border-radius: var(--tu-radius-lg);
  }

  .creneau--light {
    background: var(--tu-navy-50);
  }

  .creneau__duration {
    display: flex;
    align-items: baseline;
    gap: var(--tu-space-3);
  }

  .creneau__number {
    font-family: var(--tu-font-numeric);
    font-size: var(--tu-type-numeral);
    font-weight: 700;
    line-height: 1;
  }

  .tu-panel--dark .creneau__number {
    color: var(--tu-primary);
  }

  .creneau__unit {
    font-family: var(--tu-font-display);
    font-size: var(--tu-size-lg);
    font-weight: 600;
  }

  .creneau__body {
    font-size: var(--tu-type-body-lg);
  }

  .tu-panel--dark .creneau__body {
    color: var(--tu-navy-200);
  }

  .benefits-section,
  .equipment-section {
    padding-bottom: var(--tu-section-space);
  }

  .benefits {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--tu-space-20);
    align-items: center;
  }

  .benefits :global(.benefits__visual) {
    height: 25rem;
  }

  .benefits__text {
    display: flex;
    flex-direction: column;
    gap: var(--tu-space-9);
  }

  .benefits__header {
    display: flex;
    flex-direction: column;
    gap: var(--tu-space-3);
  }

  .logos {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: var(--tu-space-5);
  }

  .logos__item {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 6rem;
    border: var(--tu-btn-border-width) dashed var(--tu-border-strong);
    border-radius: var(--tu-radius-md);
    color: var(--tu-text-muted);
    font-size: var(--tu-size-sm);
  }

  .quote {
    display: flex;
    flex-direction: column;
    gap: var(--tu-space-5);
    margin: 0;
    padding: var(--tu-space-10);
  }

  .quote__text {
    margin: 0;
    font-size: 1.375rem;
    line-height: 1.5;
  }

  .quote__author {
    font-size: var(--tu-btn-sm-font);
    color: var(--tu-text-muted);
  }

  @media (max-width: 60rem) {
    :global(.benefits .screen-figure.desktop-only),
    :global(.stage.hero-stage .desktop-only) {
      display: none;
    }

    :global(.stage.hero-stage) {
      min-height: 0;
    }

    :global(.stage.hero-stage .stage__screen) {
      position: static;
      width: 100%;
    }

    .offer {
      gap: var(--tu-space-3);
    }

    .formats,
    .creneaux {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--tu-space-3);
    }

    .format {
      gap: var(--tu-space-2);
      padding: var(--tu-space-6) 1.375rem;
    }

    .format__title {
      font-size: var(--tu-size-lg);
    }

    .creneau {
      gap: var(--tu-space-2);
      padding: var(--tu-space-6);
    }

    .creneau__unit {
      font-size: var(--tu-size-base);
    }

    .benefits {
      grid-template-columns: minmax(0, 1fr);
    }

    .benefits__text {
      gap: var(--tu-space-5);
    }

    .logos {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--tu-space-3);
    }

    /* Mobile : quatre emplacements, deux par ligne, comme la maquette. */
    .logos__item:nth-child(5) {
      display: none;
    }

    .logos__item {
      min-height: var(--tu-space-18);
    }

    .quote {
      gap: var(--tu-space-3);
      padding: var(--tu-space-6) 1.375rem;
    }

    .quote__text {
      font-size: 1.125rem;
    }
  }
</style>
