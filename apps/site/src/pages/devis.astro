---
/* eslint-disable astro/jsx-a11y/no-autofocus --
   Le seul autofocus de la page est le récapitulatif d'erreurs, qui n'apparaît qu'après un envoi
   refusé : lui donner le focus est ce qu'attend le RGAA, et ça marche sans JavaScript. */
import { actions } from 'astro:actions';
import Base from '../layouts/Base.astro';
import TextField from '@teamup/ui/astro/TextField.astro';
import Button from '@teamup/ui/astro/Button.astro';
import { CHAMP_OUVERTURE, CHAMP_PIEGE } from '../lib/devis/antispam';
import {
  CRENEAUX,
  EQUIPEMENTS,
  LANGUES,
  OCCASIONS,
  TYPES,
  TYPE_LABELS,
  typeDepuis,
} from '../lib/devis/options';
import { saisieVide, type Champ, type Erreurs } from '../lib/devis/schema';

// Rendue à la demande : c'est elle qui reçoit l'envoi du formulaire (POST natif, sans JS).
export const prerender = false;

const resultat = Astro.getActionResult(actions.devis);
if (resultat?.data?.statut === 'envoyee') {
  return Astro.redirect('/confirmation', 303);
}

const donnees = resultat?.data;
const saisie =
  donnees && 'saisie' in donnees ? donnees.saisie : saisieVide(Astro.url.searchParams.get('type'));
const erreurs: Erreurs = donnees?.statut === 'invalide' ? donnees.erreurs : {};
const echec = donnees?.statut === 'echec' || Boolean(resultat?.error);
const type = typeDepuis(saisie.type);

/** Même convention que TextField : l'erreur du champ `nom` porte l'id `tu-field-nom-error`. */
const idErreur = (champ: Champ) => `tu-field-${champ}-error`;
const invalide = (champ: Champ) => (erreurs[champ] ? 'true' : undefined);
const decrit = (champ: Champ) => (erreurs[champ] ? idErreur(champ) : undefined);

/** Récapitulatif dans l'ordre du formulaire, chaque ligne mène au champ fautif. */
const cibles: Record<Champ, string> = {
  type: 'type-particulier',
  occasion: 'occasion',
  date: 'tu-field-date',
  lieu: 'tu-field-lieu',
  invites: 'tu-field-invites',
  nom: 'tu-field-nom',
  tel: 'tu-field-tel',
  email: 'tu-field-email',
  societe: 'tu-field-societe',
  creneau: 'creneau',
  groupes: 'tu-field-groupes',
  langues: 'langue-fr',
  equipement: 'equipement-video',
  message: 'message',
  consentement: 'consentement',
};
const recapitulatif = (Object.keys(cibles) as Champ[])
  .filter((champ) => erreurs[champ])
  .map((champ) => ({ cible: cibles[champ], message: erreurs[champ] }));

const suites = [
  { title: 'On vous rappelle', body: 'Sous [DÉLAI], pour un appel de cadrage.' },
  { title: 'Vous recevez le devis', body: 'Avec un programme adapté à votre créneau.' },
  { title: 'On prépare ensemble', body: 'Équipes, contenus, langues.' },
];
---

<Base
  title={`${recapitulatif.length > 0 || echec ? 'Erreur : ' : ''}Demander un devis — Team Up!`}
  description="Deux minutes pour décrire votre événement. Devis gratuit et sans engagement, réponse sous [DÉLAI]."
  actionBar={false}
>
  <div class="tu-container devis">
    <header class="devis__intro">
      <p class="tu-eyebrow">Demande de devis</p>
      <h1 class="devis__title">Parlez-nous de votre événement.</h1>
      <p class="devis__lead">
        Deux minutes pour remplir, gratuit et sans engagement. Les champs marqués d'une étoile sont
        obligatoires.
      </p>
    </header>

    <div class="devis__grid">
      <form
        class="tu-panel devis__form"
        method="post"
        action={actions.devis}
        novalidate
        data-tu-form="devis"
      >
        {(recapitulatif.length > 0 || echec) && (
          <div class="devis__alert" role="alert" tabindex="-1" autofocus data-tu-devis-alerte>
            {echec ? (
              <p class="devis__alert-title">
                Votre demande n'a pas pu partir. Réessayez dans un instant, ou appelez-nous au
                [TÉLÉPHONE].
              </p>
            ) : (
              <>
                <p class="devis__alert-title">
                  {recapitulatif.length === 1
                    ? 'Un champ est à corriger :'
                    : `${recapitulatif.length} champs sont à corriger :`}
                </p>
                <ul class="devis__alert-list">
                  {recapitulatif.map(({ cible, message }) => (
                    <li>
                      <a href={`#${cible}`}>{message}</a>
                    </li>
                  ))}
                </ul>
              </>
            )}
          </div>
        )}

        <fieldset
          class:list={['tu-field devis__choice', erreurs.type && 'tu-field--invalid']}
          aria-describedby={decrit('type')}
        >
          <legend class="tu-field__label">
            Vous êtes{' '}
            <span class="tu-field__required" aria-hidden="true">
              *
            </span>
          </legend>
          <div class="devis__radios">
            {TYPES.map((option) => (
              <label class="devis__radio">
                <input
                  type="radio"
                  id={`type-${option}`}
                  name="type"
                  value={option}
                  checked={option === type}
                  required
                  data-tu-devis-type
                />
                {TYPE_LABELS[option]}
              </label>
            ))}
          </div>
          {erreurs.type && (
            <p class="tu-field__error" id={idErreur('type')}>
              {erreurs.type}
            </p>
          )}
        </fieldset>

        <h2 class="devis__legend">Votre événement</h2>
        <div class="devis__row">
          <div class:list={['tu-field', erreurs.occasion && 'tu-field--invalid']}>
            <label class="tu-field__label" for="occasion">
              Occasion{' '}
              <span class="tu-field__required" aria-hidden="true">
                *
              </span>
            </label>
            <select
              class="tu-field__control"
              id="occasion"
              name="occasion"
              required
              aria-invalid={invalide('occasion')}
              aria-describedby={decrit('occasion')}
              data-tu-devis-occasion
            >
              {OCCASIONS[type].map((occasion) => (
                <option value={occasion} selected={occasion === saisie.occasion}>
                  {occasion}
                </option>
              ))}
            </select>
            {erreurs.occasion && (
              <p class="tu-field__error" id={idErreur('occasion')}>
                {erreurs.occasion}
              </p>
            )}
          </div>

          <TextField
            label="Date"
            name="date"
            type="date"
            required
            value={saisie.date}
            error={erreurs.date}
          />
          <TextField
            label="Ville ou lieu"
            name="lieu"
            placeholder="Strasbourg, salle des fêtes…"
            required
            maxlength={120}
            value={saisie.lieu}
            error={erreurs.lieu}
          />
          <TextField
            label="Nombre d'invités"
            name="invites"
            type="number"
            inputmode="numeric"
            min="2"
            placeholder="Ex. 80"
            required
            value={saisie.invites}
            error={erreurs.invites}
          />
        </div>

        <h2 class="devis__legend">Vos coordonnées</h2>
        <div class="devis__row">
          <TextField
            label="Nom et prénom"
            name="nom"
            autocomplete="name"
            required
            maxlength={100}
            value={saisie.nom}
            error={erreurs.nom}
          />
          <TextField
            label="Téléphone"
            name="tel"
            type="tel"
            autocomplete="tel"
            required
            value={saisie.tel}
            error={erreurs.tel}
          />
        </div>
        <TextField
          label="E-mail"
          name="email"
          type="email"
          autocomplete="email"
          placeholder="vous@exemple.fr"
          required
          value={saisie.email}
          error={erreurs.email}
        />
        <div hidden={type !== 'entreprise'} data-tu-devis-societe>
          <TextField
            label="Société"
            name="societe"
            autocomplete="organization"
            maxlength={120}
            value={saisie.societe}
            error={erreurs.societe}
          />
        </div>

        <div class="devis__optional">
          <div class="devis__optional-head">
            <h2 class="devis__legend">Pour préparer au mieux (facultatif)</h2>
            <p class="devis__hint">
              Ces informations nous aident à proposer le bon programme dès le devis.
            </p>
          </div>

          <div class="devis__row">
            <div class:list={['tu-field', erreurs.creneau && 'tu-field--invalid']}>
              <label class="tu-field__label" for="creneau">
                Durée du créneau disponible
              </label>
              <select
                class="tu-field__control"
                id="creneau"
                name="creneau"
                aria-invalid={invalide('creneau')}
                aria-describedby={decrit('creneau')}
              >
                {CRENEAUX.map((creneau) => (
                  <option value={creneau} selected={creneau === saisie.creneau}>
                    {creneau}
                  </option>
                ))}
              </select>
              {erreurs.creneau && (
                <p class="tu-field__error" id={idErreur('creneau')}>
                  {erreurs.creneau}
                </p>
              )}
            </div>
            <TextField
              label="Nombre de groupes à mélanger"
              name="groupes"
              placeholder="Ex. 2 familles et des amis"
              maxlength={200}
              value={saisie.groupes}
              error={erreurs.groupes}
            />
          </div>

          <fieldset
            class:list={['tu-field devis__choice', erreurs.langues && 'tu-field--invalid']}
            aria-describedby={decrit('langues')}
          >
            <legend class="tu-field__label">Langues parlées par les invités</legend>
            <div class="devis__checks">
              {LANGUES.map((langue) => (
                <label class="devis__check" lang={langue.lang}>
                  <input
                    type="checkbox"
                    id={`langue-${langue.id}`}
                    name="langues"
                    value={langue.id}
                    checked={saisie.langues.includes(langue.id)}
                  />
                  {langue.label}
                </label>
              ))}
            </div>
            {erreurs.langues && (
              <p class="tu-field__error" id={idErreur('langues')}>
                {erreurs.langues}
              </p>
            )}
          </fieldset>

          <fieldset
            class:list={['tu-field devis__choice', erreurs.equipement && 'tu-field--invalid']}
            aria-describedby={decrit('equipement')}
          >
            <legend class="tu-field__label">Équipement déjà présent dans la salle</legend>
            <div class="devis__checks">
              {EQUIPEMENTS.map((equipement) => (
                <label class="devis__check">
                  <input
                    type="checkbox"
                    id={`equipement-${equipement.id}`}
                    name="equipement"
                    value={equipement.id}
                    checked={saisie.equipement.includes(equipement.id)}
                  />
                  {equipement.label}
                </label>
              ))}
            </div>
            {erreurs.equipement && (
              <p class="tu-field__error" id={idErreur('equipement')}>
                {erreurs.equipement}
              </p>
            )}
          </fieldset>

          <div class:list={['tu-field', erreurs.message && 'tu-field--invalid']}>
            <label class="tu-field__label" for="message">
              Votre message
            </label>
            <textarea
              class="tu-field__control"
              id="message"
              name="message"
              rows="4"
              maxlength="2000"
              placeholder="Ce qui compte pour vous, les héros de la fête, le déroulé prévu…"
              aria-invalid={invalide('message')}
              aria-describedby={decrit('message')}
              set:text={saisie.message}
            ></textarea>
            {erreurs.message && (
              <p class="tu-field__error" id={idErreur('message')}>
                {erreurs.message}
              </p>
            )}
          </div>
        </div>

        <div class:list={['devis__consent-field', erreurs.consentement && 'tu-field--invalid']}>
          <label class="devis__consent">
            <input
              type="checkbox"
              id="consentement"
              name="consentement"
              required
              checked={saisie.consentement}
              aria-invalid={invalide('consentement')}
              aria-describedby={decrit('consentement')}
            />
            <span>
              J'accepte que Team Up! utilise ces informations pour me recontacter au sujet de ma
              demande. <a href="/confidentialite">Politique de confidentialité</a>
            </span>
          </label>
          {erreurs.consentement && (
            <p class="tu-field__error" id={idErreur('consentement')}>
              {erreurs.consentement}
            </p>
          )}
        </div>

        <!-- Piège à robots : invisible et hors du parcours clavier et des lecteurs d'écran. -->
        <div class="tu-visually-hidden" aria-hidden="true">
          <label for={CHAMP_PIEGE}>Ne remplissez pas ce champ</label>
          <input type="text" id={CHAMP_PIEGE} name={CHAMP_PIEGE} tabindex="-1" autocomplete="off" />
        </div>
        <input type="hidden" name={CHAMP_OUVERTURE} value={Date.now()} />

        <Button type="submit" variant="accent" size="cta" block>
          Envoyer ma demande
        </Button>
      </form>

      <aside class="devis__aside">
        <div class="tu-panel tu-panel--dark devis__card devis__card--next" data-theme="stage">
          <h2 class="devis__card-title">Et ensuite ?</h2>
          <ol class="devis__next">
            {suites.map((suite, index) => (
              <li class="devis__next-item">
                <span class="devis__next-number" aria-hidden="true">
                  {index + 1}
                </span>
                <span class="devis__next-text">
                  <span class="devis__next-title">{suite.title}</span>
                  <span class="devis__next-body">{suite.body}</span>
                </span>
              </li>
            ))}
          </ol>
          <p class="devis__contact devis__contact--inline">Vous préférez en parler ? [TÉLÉPHONE]</p>
        </div>

        <div class="tu-panel devis__card devis__card--contact">
          <span class="devis__card-title">Vous préférez en parler ?</span>
          <p class="devis__contact">[TÉLÉPHONE] · [EMAIL]</p>
        </div>
      </aside>
    </div>
  </div>
</Base>

<script>
  import { OCCASIONS, typeDepuis } from '../lib/devis/options';

  // Après un envoi refusé, le récapitulatif des erreurs prend le focus (RGAA 11.10).
  document.querySelector<HTMLElement>('[data-tu-devis-alerte]')?.focus();

  // Changer de type met à jour les occasions et affiche la société pour les entreprises.
  const occasion = document.querySelector<HTMLSelectElement>('[data-tu-devis-occasion]');
  const societe = document.querySelector<HTMLElement>('[data-tu-devis-societe]');

  document.querySelectorAll<HTMLInputElement>('[data-tu-devis-type]').forEach((radio) => {
    radio.addEventListener('change', () => {
      if (!radio.checked) return;
      const type = typeDepuis(radio.value);
      occasion?.replaceChildren(...OCCASIONS[type].map((libelle) => new Option(libelle, libelle)));
      if (societe) societe.hidden = type !== 'entreprise';
    });
  });
</script>

<style>
  .devis {
    display: flex;
    flex-direction: column;
    gap: var(--tu-space-12);
    padding-block: var(--tu-space-20) var(--tu-section-space);
  }

  .devis__intro {
    display: flex;
    flex-direction: column;
    gap: var(--tu-space-4);
    max-width: 51.25rem;
  }

  .devis__title {
    font-size: var(--tu-type-page-sm);
    line-height: 1.1;
  }

  .devis__lead {
    font-size: 1.1875rem;
    color: var(--tu-text-muted);
  }

  .devis__grid {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    gap: var(--tu-space-10);
    align-items: start;
  }

  .devis__form {
    display: flex;
    flex-direction: column;
    gap: var(--tu-space-8);
    padding: var(--tu-space-12);
  }

  .devis__legend {
    font-size: 1.375rem;
  }

  .devis__hint {
    color: var(--tu-text-muted);
    font-size: var(--tu-btn-sm-font);
  }

  .devis__row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--tu-space-5);
  }

  .devis__choice {
    border: none;
    margin: 0;
    padding: 0;
  }

  .devis__choice > :global(legend) {
    margin-bottom: var(--tu-space-3);
    padding: 0;
  }

  .devis__radios {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--tu-space-3);
  }

  .devis__checks {
    display: flex;
    flex-wrap: wrap;
    gap: var(--tu-space-2);
  }

  .devis__radio,
  .devis__check {
    display: inline-flex;
    align-items: center;
    gap: var(--tu-space-3);
    border: var(--tu-btn-border-width) solid var(--tu-border);
    background: var(--tu-surface);
    cursor: pointer;
  }

  .devis__radio {
    min-height: var(--tu-space-16);
    padding-inline: var(--tu-space-5);
    border-radius: var(--tu-radius-md);
    font-family: var(--tu-font-display);
    font-size: var(--tu-type-body-lg);
    font-weight: 600;
  }

  .devis__check {
    gap: var(--tu-space-2);
    min-height: var(--tu-space-12);
    padding-inline: var(--tu-space-4);
    border-radius: var(--tu-radius-pill);
    font-size: var(--tu-btn-sm-font);
    font-weight: 500;
  }

  .devis__radio input,
  .devis__check input {
    width: var(--tu-space-5);
    height: var(--tu-space-5);
    margin: 0;
    accent-color: var(--tu-primary);
  }

  .devis__radio:has(input:checked) {
    border-color: var(--tu-primary);
    background: var(--tu-navy-50);
  }

  .devis__check:has(input:checked) {
    border-color: var(--tu-primary);
  }

  .devis__check:lang(ta) {
    font-family: var(--tu-font-tamil);
  }

  .devis__optional {
    display: flex;
    flex-direction: column;
    gap: var(--tu-space-6);
    padding-top: var(--tu-space-8);
    border-top: var(--tu-border-width) solid var(--tu-border);
  }

  .devis__optional-head {
    display: flex;
    flex-direction: column;
    gap: var(--tu-space-2);
  }

  .devis__consent-field {
    display: flex;
    flex-direction: column;
    gap: var(--tu-space-2);
  }

  .devis__choice.tu-field--invalid .devis__radio,
  .devis__choice.tu-field--invalid .devis__check {
    border-color: var(--tu-danger);
  }

  .devis__alert {
    display: flex;
    flex-direction: column;
    gap: var(--tu-space-3);
    padding: var(--tu-space-5) var(--tu-space-6);
    border: var(--tu-btn-border-width) solid var(--tu-danger);
    border-radius: var(--tu-radius-md);
    background: var(--tu-surface);
  }

  .devis__alert-title {
    font-weight: 600;
    color: var(--tu-danger-text);
  }

  .devis__alert-list {
    display: flex;
    flex-direction: column;
    gap: var(--tu-space-1);
    padding-left: var(--tu-space-5);
    list-style: disc;
  }

  .devis__alert-list a {
    color: var(--tu-text);
  }

  .devis__consent {
    display: flex;
    align-items: flex-start;
    gap: var(--tu-space-3);
    font-size: var(--tu-size-sm);
    line-height: 1.5;
    color: var(--tu-text-muted);
    cursor: pointer;
  }

  .devis__consent input {
    flex: none;
    width: var(--tu-space-5);
    height: var(--tu-space-5);
    margin: var(--tu-border-width) 0 0;
    accent-color: var(--tu-primary);
  }

  .devis__consent a {
    color: var(--tu-text);
  }

  .devis__aside {
    display: flex;
    flex-direction: column;
    gap: var(--tu-space-6);
    position: sticky;
    top: calc(var(--tu-header-height) + var(--tu-space-4));
  }

  .devis__card {
    display: flex;
    flex-direction: column;
    gap: var(--tu-space-3);
    padding: var(--tu-space-8);
  }

  .devis__card--next {
    gap: var(--tu-space-6);
    padding: var(--tu-space-9);
  }

  .devis__card-title {
    font-family: var(--tu-font-display);
    font-size: var(--tu-size-xl);
    font-weight: 700;
  }

  .devis__card--contact .devis__card-title {
    font-size: var(--tu-type-body-lg);
    font-weight: 600;
  }

  .devis__next {
    display: flex;
    flex-direction: column;
    gap: var(--tu-space-6);
  }

  .devis__next-item {
    display: flex;
    gap: var(--tu-space-4);
    align-items: flex-start;
  }

  .devis__next-number {
    flex: none;
    width: var(--tu-space-5);
    font-family: var(--tu-font-display);
    font-size: 1.75rem;
    font-weight: 700;
    line-height: 1;
    color: var(--tu-primary);
  }

  .devis__next-text {
    display: flex;
    flex-direction: column;
    gap: var(--tu-space-1);
  }

  .devis__next-title {
    font-family: var(--tu-font-display);
    font-size: var(--tu-type-body-lg);
    font-weight: 600;
  }

  .devis__next-body,
  .devis__contact {
    font-size: var(--tu-btn-sm-font);
    line-height: 1.5;
    color: var(--tu-text-muted);
  }

  .devis__contact--inline {
    display: none;
  }

  @media (max-width: 60rem) {
    .devis {
      gap: var(--tu-space-5);
      padding-top: var(--tu-intro-space-top);
    }

    .devis__intro {
      gap: var(--tu-space-3);
    }

    .devis__lead {
      font-size: var(--tu-size-base);
    }

    .devis__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--tu-space-10);
    }

    /* Mobile : le formulaire se pose à même la page, sans carte. */
    .devis__form {
      gap: var(--tu-space-6);
      padding: 0;
      border: none;
      background: none;
    }

    .devis__legend {
      font-size: var(--tu-size-lg);
    }

    .devis__row {
      grid-template-columns: minmax(0, 1fr);
    }

    .devis__radio {
      min-height: var(--tu-tap-min);
      padding-inline: var(--tu-space-4);
      font-size: var(--tu-size-base);
    }

    .devis__aside {
      position: static;
    }

    .devis__card--next {
      gap: var(--tu-space-5);
      padding: var(--tu-space-6) 1.375rem;
    }

    .devis__card-title {
