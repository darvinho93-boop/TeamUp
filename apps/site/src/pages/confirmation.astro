---
import Base from '../layouts/Base.astro';
import Button from '@teamup/ui/astro/Button.astro';
import Icon from '../components/Icon.astro';
---

<Base
  title="Demande envoyée — Team Up!"
  description="Votre demande de devis est bien partie. Nous vous rappelons sous [DÉLAI]."
  noindex
  actionBar={false}
>
  <div class="tu-container merci">
    <span class="merci__mark">
      <Icon name="checkCircle" size="lg" />
    </span>
    <h1 class="merci__title">Merci, votre demande est bien partie.</h1>
    <p class="merci__body">
      Nous vous rappelons sous [DÉLAI] pour faire connaissance et parler de votre événement. D'ici
      là, vous n'avez rien à préparer. Un e-mail de confirmation vient de partir à l'adresse
      indiquée.
    </p>
    <div class="merci__actions">
      <Button href="/" variant="outline" size="cta">
        Retour à l'accueil
      </Button>
      <Button href="/les-jeux" variant="primary" size="cta">
        Découvrir les jeux
      </Button>
    </div>
  </div>
</Base>

<style>
  .merci {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--tu-space-7);
    padding-block: 7.5rem 8.75rem;
    text-align: center;
  }

  .merci__mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 6rem;
    height: 6rem;
    border-radius: var(--tu-radius-pill);
    background: var(--tu-sage-50);
    color: var(--tu-success-text);
  }

  .merci__mark :global(.icon) {
    width: var(--tu-space-12);
    height: var(--tu-space-12);
  }

  .merci__title {
    max-width: 47.5rem;
    font-size: var(--tu-type-page-sm);
    line-height: 1.1;
  }

  .merci__body {
    max-width: 38.75rem;
    font-size: 1.1875rem;
    color: var(--tu-text-muted);
  }

  .merci__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--tu-space-4);
    margin-top: var(--tu-space-3);
  }

  /* Mobile : aligné à gauche, boutons pleine largeur, comme la maquette. */
  @media (max-width: 60rem) {
    .merci {
      align-items: stretch;
      gap: var(--tu-space-5);
      padding-block: var(--tu-space-16) var(--tu-space-18);
      text-align: start;
    }

    .merci__mark {
      width: var(--tu-space-20);
      height: var(--tu-space-20);
    }

    .merci__mark :global(.icon) {
      width: var(--tu-space-10);
      height: var(--tu-space-10);
    }

    .merci__body {
      font-size: var(--tu-type-body-lg);
    }

    .merci__actions {
      flex-direction: column;
      gap: var(--tu-space-3);
      margin-top: 0;
    }
  }
</style>
