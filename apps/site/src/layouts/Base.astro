---
import '@teamup/ui/styles.css';
import '@teamup/ui/site-motion.css';
import SiteHeader from '@teamup/ui/astro/SiteHeader.astro';
import SiteFooter from '@teamup/ui/astro/SiteFooter.astro';
import { APP_URL } from '../lib/app';
import { CONTACT } from '../data/contact';
import Consentement from '../components/layout/Consentement.astro';
import SiteActionBar from '@teamup/ui/astro/SiteActionBar.astro';
import favicon32 from '@teamup/brand/icons/favicon32.png';
import favicon16 from '@teamup/brand/icons/favicon16.png';
import appleTouchIcon from '@teamup/brand/icons/appletouchicon.png';
import ogImage from '@teamup/brand/icons/iconmaskable512.png';
import tokens from '@teamup/brand/tokens.json';

type Props = {
  title: string;
  description: string;
  noindex?: boolean;
  /** Barre d'action mobile : retirée là où l'appel à l'action est déjà à l'écran. */
  actionBar?: boolean;
  /** Teinte d'accent de la page : les maquettes Entreprises passent surtitres et bandeau en bleu. */
  accent?: 'particuliers' | 'entreprises';
};

const { title, description, noindex = false, actionBar = true, accent } = Astro.props;

const currentPath = Astro.url.pathname;
const canonical = new URL(currentPath, Astro.site);
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content={tokens.color.semantic.bg} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Team Up!" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage.src, Astro.site)} />
    <meta name="twitter:card" content="summary" />

    <link rel="icon" type="image/png" sizes="32x32" href={favicon32.src} />
    <link rel="icon" type="image/png" sizes="16x16" href={favicon16.src} />
    <link rel="apple-touch-icon" href={appleTouchIcon.src} />

    <!-- Apparitions au défilement. En ligne et dans l'en-tête : la classe est posée avant le
         premier affichage (rien ne clignote), et sans script aucun bloc n'est caché. -->
    <script is:inline>
      (() => {
        if (
          !('IntersectionObserver' in window) ||
          !matchMedia('(prefers-reduced-motion: no-preference)').matches
        ) {
          return;
        }
        document.documentElement.classList.add('tu-anime');
        document.addEventListener('DOMContentLoaded', () => {
          const observateur = new IntersectionObserver(
            (entrees) => {
              // Les blocs qui entrent ensemble arrivent en cascade.
              let rang = 0;
              for (const entree of entrees) {
                if (!entree.isIntersecting) continue;
                entree.target.style.setProperty('--tu-apparait-rang', String(rang++));
                entree.target.classList.add('tu-apparu');
                observateur.unobserve(entree.target);
              }
            },
            { rootMargin: '0px 0px -8% 0px', threshold: 0.1 },
          );
          for (const bloc of document.querySelectorAll('[data-tu-apparait]')) {
            observateur.observe(bloc);
          }
        });
      })();
    </script>
  </head>
  <body>
    <a class="tu-visually-hidden" href="#contenu">
      Aller au contenu
    </a>
    <SiteHeader currentPath={currentPath} />
    <main id="contenu" data-accent={accent}>
      <slot />
    </main>
    <SiteFooter
      regieUrl={`${APP_URL}/regie`}
      email={CONTACT.email}
      telephone={CONTACT.telephone}
      telephoneLien={CONTACT.telephoneLien}
    />
    {actionBar && <SiteActionBar />}
    <Consentement />
  </body>
</html>
