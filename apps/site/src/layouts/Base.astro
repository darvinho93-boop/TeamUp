---
import '@teamup/ui/styles.css';
import '@teamup/ui/site-motion.css';
import '@teamup/ui/site-rail.css';
import SiteHeader from '@teamup/ui/astro/SiteHeader.astro';
import SiteFooter from '@teamup/ui/astro/SiteFooter.astro';
import { APP_URL } from '../lib/app';
import { CONTACT } from '../data/contact';
import { MARQUE, enJsonLd } from '../data/marque';
import Consentement from '../components/layout/Consentement.astro';
import Partage from '../components/layout/Partage.astro';
import PoliceTitres from '@teamup/ui/astro/PoliceTitres.astro';
import favicon32 from '@teamup/brand/icons/favicon32.png';
import favicon16 from '@teamup/brand/icons/favicon16.png';
import appleTouchIcon from '@teamup/brand/icons/appletouchicon.png';
import icone512 from '@teamup/brand/icons/icon512.png';
import tokens from '@teamup/brand/tokens.json';

type Props = {
  title: string;
  description: string;
  noindex?: boolean;
  /** Le bloc de partage du bas de page : retiré des formulaires, des pages légales et de la 404. */
  partage?: boolean;
  /** Teinte d'accent de la page : les maquettes Entreprises passent surtitres et bandeau en bleu. */
  accent?: 'particuliers' | 'entreprises';
  /** Une image du haut de page à charger en priorité (l'affiche de la vidéo de l'accueil). */
  imagePrioritaire?: string;
};

const {
  title,
  description,
  noindex = false,
  partage = true,
  accent,
  imagePrioritaire,
} = Astro.props;

const currentPath = Astro.url.pathname;
const canonical = new URL(currentPath, Astro.site);
// L'aperçu des liens partagés (WhatsApp, iMessage, réseaux) : `pnpm --filter @teamup/site apercu`.
const apercu = new URL('/apercu-partage.jpg', Astro.site);

// Ce que les moteurs de recherche peuvent lire sans deviner : qui, quoi, où, comment joindre.
// Pas de prix ici tant que l'offre de lancement court : une donnée périmée serait pire que rien.
const racine = new URL('/', Astro.site).href;
const france = { '@type': 'Country', name: 'France' };
const donneesStructurees = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${racine}#organisation`,
      name: MARQUE.nom,
      slogan: MARQUE.slogan,
      url: racine,
      logo: new URL(icone512.src, Astro.site).href,
      email: CONTACT.email,
      telephone: CONTACT.telephoneLien,
      areaServed: france,
      sameAs: [CONTACT.instagram],
    },
    {
      '@type': 'WebSite',
      '@id': `${racine}#site`,
      name: MARQUE.nom,
      url: racine,
      inLanguage: 'fr-FR',
      publisher: { '@id': `${racine}#organisation` },
    },
    {
      '@type': 'Service',
      '@id': `${racine}#service`,
      name: `${MARQUE.service} ${MARQUE.nom}`,
      serviceType: MARQUE.service,
      description:
        "Un animateur fait jouer toute la salle en équipes mélangées, jusqu'à 150 invités : mariages, anniversaires, fêtes de famille, séminaires et team building.",
      provider: { '@id': `${racine}#organisation` },
      areaServed: france,
    },
  ],
};
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <PoliceTitres />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content={tokens.color.semantic.bg} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Team Up!" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={apercu} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Team Up! — On joue. On se rencontre. On crée du lien." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={apercu} />
    <script is:inline type="application/ld+json" set:html={enJsonLd(donneesStructurees)}></script>
    {imagePrioritaire && (
      <link rel="preload" as="image" href={imagePrioritaire} fetchpriority="high" />
    )}

    <link rel="icon" type="image/png" sizes="32x32" href={favicon32.src} />
    <link rel="icon" type="image/png" sizes="16x16" href={favicon16.src} />
    <link rel="apple-touch-icon" href={appleTouchIcon.src} />

    <!-- Apparitions au défilement. En ligne et dans l'en-tête : la classe est posée avant le
         premier affichage (rien ne clignote), et sans script aucun bloc n'est caché. -->
    <script is:inline>
      (() => {
        if (
          !('IntersectionObserver' in window) ||
          !matchMedia('(prefers-reduced-motion: no-preference)').matches
        ) {
          return;
        }
        document.documentElement.classList.add('tu-anime');
        document.addEventListener('DOMContentLoaded', () => {
          const observateur = new IntersectionObserver(
            (entrees) => {
              // Les blocs qui entrent ensemble arrivent en cascade.
              let rang = 0;
              for (const entree of entrees) {
                if (!entree.isIntersecting) continue;
                entree.target.style.setProperty('--tu-apparait-rang', String(rang++));
                entree.target.classList.add('tu-apparu');
                observateur.unobserve(entree.target);
              }
            },
            { rootMargin: '0px 0px -8% 0px', threshold: 0.1 },
          );
          for (const bloc of document.querySelectorAll('[data-tu-apparait]')) {
            observateur.observe(bloc);
          }
        });
      })();
    </script>
  </head>
  <body>
    <a class="tu-visually-hidden" href="#contenu">
      Aller au contenu
    </a>
    <SiteHeader currentPath={currentPath} />
    <main id="contenu" data-accent={accent}>
      <slot />
      {partage && <Partage />}
    </main>
    <SiteFooter
      regieUrl={`${APP_URL}/regie`}
      email={CONTACT.email}
      telephone={CONTACT.telephone}
      telephoneLien={CONTACT.telephoneLien}
      instagram={CONTACT.instagram}
      instagramNom={CONTACT.instagramNom}
      signature={`Animation de soirée, ${CONTACT.zone}.`}
    />
    <Consentement />

    <script>
      // Une rangée à faire glisser qui ne contient ni lien ni bouton doit rester atteignable au
      // clavier : elle devient focalisable tant qu'elle défile, et seulement à ce moment-là.
      const rangees = document.querySelectorAll<HTMLElement>('.tu-rail');
      const etroit = matchMedia('(max-width: 60rem)');
      const regler = () => {
        for (const rangee of rangees) {
          const defile = etroit.matches && rangee.scrollWidth > rangee.clientWidth;
          if (defile && !rangee.querySelector('a[href], button')) rangee.tabIndex = 0;
          else rangee.removeAttribute('tabindex');
        }
      };
      regler();
      etroit.addEventListener('change', regler);

      // Provenance des devis, sans cookie ni stockage : le mot `via` d'un lien partagé suit le
      // visiteur de page en page dans l'adresse, et un lien vers le devis dit de quelle page il part.
      const FORME = /^[a-z0-9-]{1,24}$/;
      const via = new URLSearchParams(location.search).get('via') ?? '';
      const page = location.pathname.replace(/^\/|\/$/g, '') || 'accueil';
      for (const lien of document.querySelectorAll<HTMLAnchorElement>('a[href^="/"]')) {
        const cible = new URL(lien.href);
        if (cible.origin !== location.origin) continue;
        const versDevis = cible.pathname.replace(/\/$/, '') === '/devis';
        const suitLeLien = FORME.test(via);
        const ditLaPage = versDevis && FORME.test(page);
        if (!suitLeLien && !ditLaPage) continue;
        if (suitLeLien) cible.searchParams.set('via', via);
        if (ditLaPage) cible.searchParams.set('depuis', page);
        lien.href = cible.pathname + cible.search + cible.hash;
      }
    </script>
  </body>
</html>
