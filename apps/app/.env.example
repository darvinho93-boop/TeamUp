# Base Supabase. En local : valeurs affichées par `pnpm db:start` (API_URL, SERVICE_ROLE_KEY).
SUPABASE_URL=http://127.0.0.1:54321
# Clé du rôle de service : serveur uniquement, jamais préfixée NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Régie et écran commun : connexion des animateurs et temps réel, depuis le navigateur.
# La clé anon est publique par nature et n'ouvre aucun droit (lot 3). En local : ANON_KEY.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
