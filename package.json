{
  "name": "teamup",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.17.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:site": "turbo run dev --filter=@teamup/site",
    "dev:app": "turbo run dev --filter=@teamup/app",
    "dev:host": "turbo run dev:host",
    "build": "turbo run build",
    "lint": "node scripts/check-tokens.mjs && eslint .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:start": "supabase start -x studio,imgproxy,mailpit,logflare,vector,edge-runtime,supavisor,postgres-meta",
    "db:start:complet": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local --schema public > apps/app/src/types/base.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "test:e2e": "pnpm --filter @teamup/app test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.8",
    "prettier-plugin-astro": "^1.0.1",
    "supabase": "^2.117.0",
    "turbo": "^2.11.2",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.70.0"
  }
}
